// Every std module compiles together, and the parameterised consts fold.
// std/io and std/str arrive through std/screen, which genuinely uses both.
// std/math has to be named: screen and key deliberately do not include it for
// their callers, even though their own comments point at lo() and hi().
include "lib/std/math.momo"
include "lib/std/screen.momo"
include "lib/std/key.momo"
include "lib/std/rand.momo"

const u8[] palette = [ color(white, black), color(red, yellow), color(cyan, blue) ]
const u16[] limits = [ min(3, 9), max(3, 9), clamp(50, 0, 10) ]

u16 k
u16 roll
u8[16] copy

sub t {
  setTextMode()
  hideCursor()
  clearScreen(color(lightGray, black))
  writeAt(1, 1, '@', palette[0])
  fillRow(0, 0, '-', palette[1], screenCols)
  putStrAt(0, 23, addr(status))
  writeStrAt(0, 24, addr(status), palette[2])
  writeNumberAt(70, 24, limits[1])

  // std/str: everything that takes an address rather than an array.
  roll = strLen(addr(status))
  strCopy(addr(copy), addr(status))
  roll = u16(strCmp(addr(copy), addr(status)))
  roll = strFind(addr(status), '/')
  memCopy(addr(copy), addr(status), 4)
  memFill(addr(copy), len(copy), 0)

  seedRandom(1234)
  roll = randomBetween(1, 6)

  k = readKey()
  if (lo(k) == 0 && hi(k) == keyUp) roll = 0
  if (lo(k) == keyEsc) roll = 1
  if (keyWaiting()) roll = 2
}

const u8[] status = "hp 10/10$"
t()
