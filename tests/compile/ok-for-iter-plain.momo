// The twin of ok-for-iter-sugar.momo, written the way it has to be written
// without DESIGN §45.
//
// The two counters with the long names are not a joke. `of` generates a counter
// the program cannot name, and the name it generates carries the file it came
// from - so the only twin that can emit identical instructions is one that
// declares those exact labels. **Renaming ok-for-iter-sugar.momo means changing
// them here**, and the identity assertion is what will say so.
//
// Declaration order matches the order the lifting produces, so the data section
// matches too - one per loop, in the order the loops appear.

u16 i
u16 of__ok_for_iter_sugar__0
u16 g
u16 of__ok_for_iter_sugar__1
u16 f
u16 of__ok_for_iter_sugar__2

const mobCount = 3

group mob[mobCount] {
  u8  x
  u16 hp
}

u8[4] buf
u16   total = 0

for ( i = 0; i < len( buf ); i++ ) {
  buf[ i ] = u8( i )
}

for ( of__ok_for_iter_sugar__0 = 0; of__ok_for_iter_sugar__0 < len( buf ); of__ok_for_iter_sugar__0++ ) {
  buf[ of__ok_for_iter_sugar__0 ] = buf[ of__ok_for_iter_sugar__0 ] + 1
  total = total + buf[ of__ok_for_iter_sugar__0 ]
}

for ( g = 0; g < len( mob ); g++ ) {
  mob[ g ].hp = 100
}

for ( of__ok_for_iter_sugar__1 = 0; of__ok_for_iter_sugar__1 < len( mob ); of__ok_for_iter_sugar__1++ ) {
  mob[ of__ok_for_iter_sugar__1 ].hp = mob[ of__ok_for_iter_sugar__1 ].hp + 1
  mob[ of__ok_for_iter_sugar__1 ].x = 2
}

far u8[8] cells = 0xB800

for ( f = 0; f < len( cells ); f++ ) {
  cells[ f ] = 3
}

for ( of__ok_for_iter_sugar__2 = 0; of__ok_for_iter_sugar__2 < len( cells ); of__ok_for_iter_sugar__2++ ) {
  cells[ of__ok_for_iter_sugar__2 ] = 4
}
