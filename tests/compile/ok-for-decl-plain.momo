// The twin of ok-for-decl-sugar.momo, written the way it has to be written
// without DESIGN §44. The two must emit the same instructions.
//
// Declaration order matches what the lifting produces, so the data section
// matches too. That is deliberate and it is a limit worth knowing: the pair tests
// the instruction claim exactly, and the ordering one not at all, because the twin
// was chosen to agree about storage. Lifting really does reorder a data section -
// `momolo` moved 14 labels adopting this - and the golden tier is what covers it.

u8 t

u8 total = 0

sub twice {
  u8 i

  for ( i = 0; i < 3; i++ ) {
    total = total + i
  }

  for ( i = 0; i < 4; i++ ) {
    total = total + i
  }
}

sub nested {
  u16 a
  u8 b

  for ( a = 0; a < 2; a++ ) {
    for ( b = 0; b < 2; b++ ) {
      total = total + b
    }
  }
}

sub blocks {
  u8 k

  if ( total > 0 ) {
    for ( k = 0; k < 2; k++ ) {
      total = total + k
    }
  }

  for ( k = 0; k < 3; k++ ) {
    total = total + k
  }
}

sub arrowed {
  u8 z

  for ( z = 0; z < 2; z++ ) {
    total = total + z
  }
}

twice()
nested()
blocks()
arrowed()

for ( t = 0; t < 2; t++ ) {
  total = total + t
}
