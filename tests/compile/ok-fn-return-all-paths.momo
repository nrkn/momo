// Every shape that must stay legal under the all-paths return check.

u16 both( u8 a ) {
  if( a > 0 ){
    return 1
  } else {
    return 2
  }
}

// An endless loop never reaches the end of the routine, so no trailing return
// is needed. This is the case that would be a false positive if loops were
// simply assumed able to finish - and `while (true)` is already how rl.momo
// writes its main loop.
u16 spin( u8 a ) {
  while( true ){
    if( a > 0 ){
      return 1
    }
  }
}

u16 forever( u8 a ) {
  for( ;; ){
    return a
  }
}

u16 doSpin( u8 a ) {
  do {
    return a
  } while( true )
}

// A loop that CAN finish proves nothing, so the trailing return is what carries
// this one.
u16 after( u16 n ) {
  u16 i
  for( i = 0; i < n; i++ ){
    if( i == 3 ) return i
  }
  return 0
}

// An else-if chain is a nested IfStatement, so every arm has to be walked.
u16 chain( u8 a ) {
  if( a == 0 ){
    return 10
  } else if( a == 1 ){
    return 20
  } else {
    return 30
  }
}

// A sub may still `return` bare, anywhere, with nothing to check.
sub early( u8 a ) {
  if( a > 0 ) return
  _al = a
}

u16 out
out = both( 1 ) + forever( 2 ) + doSpin( 3 ) + after( 5 ) + chain( 0 )
early( 1 )
