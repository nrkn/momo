// shell.momo - the scenes, and the pass sequence a caller drives.
//
// Seven scenes, every one the same tree as a demo in the clay study's gallery, so
// the numbers they produce can be held against the study's own.
//
// This is not the engine. It sits above the line, as its counterpart did in the
// study, and writes the pass order out longhand rather than hiding it behind an
// end() - the caller drives momolo, and momolo never calls out.
//
// Shared by two projects: `momolo` dumps the resolved boxes as numbers for the
// cross-check, and `mlodemo` draws one of them on a text mode screen. They build
// the same trees, so the picture is made of the tree the numbers verified.
//
// Colours come from std/screen.momo, which names the CGA sixteen exactly as the
// study does. That was not an accident.

// The engine, the layer above it, what a unit is, and the pass order. Shared
// with the other scene files rather than spelled here, since there is more than
// one of them now.
include "scenes/passes.momo"

// ---- the content ----------------------------------------------------------

const u8[] sMomolo   = "momolo$"
const u8[] sGeometry = "geometry$"
const u8[] sNew      = "New$"
const u8[] sOpen     = "Open$"
const u8[] sSave     = "Save$"
const u8[] sQuit     = "Quit$"
const u8[] sBody     = "wrapped text in a narrow column$"
const u8[] sCentred  = "centred on both axes$"
const u8[] sA        = "a$"
const u8[] sB        = "bbbb$"
const u8[] sC        = "cc$"
const u8[] sLeft     = "squeezed left column$"
const u8[] sRight    = "squeezed right column$"
const u8[] sReady    = "ready$"

const u8[] sAbc      = "abc$"
const u8[] sDe       = "de$"
const u8[] sFghi     = "fghi$"
const u8[] sCapFit   = "fit() - as wide as the words$"
const u8[] sCapGrow  = "grow() - converge on a common width$"
const u8[] sCapMixed = "fixed(6), grow(0, 8) capped, grow()$"

const u8[] sAlpha    = "alpha beta$"
const u8[] sGamma    = "gamma delta$"
const u8[] sTrack26  = "track of 26$"
const u8[] sTrack22  = "track of 22$"
const u8[] sTrack14  = "track of 14$"
const u8[] sTrack8   = "track of 8$"

const u8[] sAa       = "aa$"
const u8[] sBb       = "bb$"
const u8[] sCc       = "cc$"
const u8[] sDd       = "dd$"

const u8[] sWider    = "wider$"
const u8[] sThan     = "than$"
const u8[] sThis     = "this$"

// The nine alignment combinations, named for their main and cross alignment.
const u8[] sAlSs     = "ss$"
const u8[] sAlCs     = "cs$"
const u8[] sAlEs     = "es$"
const u8[] sAlSc     = "sc$"
const u8[] sAlCc     = "cc$"
const u8[] sAlEc     = "ec$"
const u8[] sAlSe     = "se$"
const u8[] sAlCe     = "ce$"
const u8[] sAlEe     = "ee$"

const u8[] sFox      = "the quick brown fox jumps over it$"
const u8[] sW8       = "w8$"
const u8[] sW14      = "w14$"
const u8[] sW26      = "w26$"

// A paragraph's minimum width is its longest word, and that one number is the
// whole of what makes it a paragraph rather than a label. In a Momo program it
// is a compile-time constant because the string is.
const bodyMinW     = 7          // "wrapped"
const squeezedMinW = 8          // "squeezed"
const trackMinW    = 5          // "alpha", and "gamma" is the same length
const foxMinW      = 5          // "quick", "brown" and "jumps" all tie

// ---- shared scene pieces --------------------------------------------------
//
// The study writes these as functions taking a closure. Momo has no closures, so
// a wrapper becomes an open/close pair: the openBox/closeBox pair is what ports,
// and the closure was a TypeScript convenience only.
//
// The caller writes the body inside a bracket block (§48), which is as close to
// the study's shape as this gets - the body is in place and the close is the
// compiler's rather than the caller's - and needs no closure to do it.

// A caption above a strip of content.
sub stripOpen( a16 caption ) {
  boxOpen( isCol: true, wGrow: true )

    labelPaint( caption, lightGray, black )

    boxOpen( wGrow: true, gap: u )
}

sub stripClose {
  closeBox()                    // the row of content
  closeBox()                    // the captioned column
}

// The 1:2 wrapper, and the reason a bracket's close takes no arguments: whatever
// `stripClose` owns is its business. The two routines above are the only opens in
// this file that cannot themselves be blocks - their whole job is to leave a box
// open - and that costs nothing at the four places `strip` is used.
bracket strip = stripOpen / stripClose

// A centred label on a coloured panel. How wide it is comes by name, with the
// panel's own defaults: nothing said is a fit, `wGrow: true` a grow, `fixedW` a
// fixed width, and a grow with a `wMax` is capped - so the candidate drops out
// of the convergence loop when it reaches its ceiling.
sub swatch( a16 at, u8 bg, bool wGrow = false, u16 fixedW = 0, u16 wMax = unbounded ) {
  panel( bg, insetX: u, alignMain: alignCenter,
         wGrow: wGrow, fixedW: fixedW, wMax: wMax ) {
    labelPaint( at, black, bg )
  }
}

// ---- scene: shell ---------------------------------------------------------
//
// An application frame: fixed sidebar, growing pane, borders, a spacer, wrapping
// and squeezing together. 80x25, because that is a text mode screen.

sub buildShell {
  panel( blue, isCol: true, wGrow: true, hGrow: true ) {
    // ---- title bar. The empty grow box between the two labels is a spacer -
    // it is how you push something to the far end without a dedicated alignment
    // rule for it.
    panel( cyan, wGrow: true, fixedH: lineHeight, insetX: u ) {
      labelPaint( addr( sMomolo ), black, cyan )

      // The gap on a childless box is deliberate and does nothing - there are no
      // gaps between no children. It is here so that `gap * (n - 1)` without a
      // guard reads 65535 and says so; see momolo/fit.momo.
      box( wGrow: true, gap: u ) {
      }

      labelPaint( addr( sGeometry ), black, cyan )
    }

    // ---- body: a fixed sidebar and a growing pane
    box( wGrow: true, hGrow: true, insetX: u, insetY: u, gap: u ) {
      // ---- sidebar. The frame's width is added to the inset by panelFramed,
      // so the engine is told a bigger inset and never hears the word border.
      framed( darkGray, border, white,
              isCol: true, fixedW: 16 * u, hGrow: true, insetX: u, insetY: u ) {
        labelPaint( addr( sNew ), white, darkGray )
        labelPaint( addr( sOpen ), white, darkGray )
        labelPaint( addr( sSave ), white, darkGray )
        labelPaint( addr( sQuit ), white, darkGray )

        box( fixedH: lineHeight ) {
        }

        paraPaint( addr( sBody ), bodyMinW, yellow, darkGray )
      }

      // ---- main pane
      framed( black, border, lightGray,
              isCol: true, wGrow: true, hGrow: true, insetX: u, insetY: u, gap: u,
              alignMain: alignCenter, alignCross: alignCenter ) {
        labelPaint( addr( sCentred ), yellow, black )

        box( wGrow: true, gap: u ) {
          swatch( addr( sA ), darkGray, wGrow: true )
          swatch( addr( sB ), darkGray, wGrow: true )
          swatch( addr( sC ), darkGray, wGrow: true )
        }

        box( fixedW: 24 * u, gap: u ) {
          paraPaint( addr( sLeft ), squeezedMinW, white, darkGray )
          paraPaint( addr( sRight ), squeezedMinW, white, darkGray )
        }
      }
    }

    // ---- status bar
    panel( lightGray, wGrow: true, fixedH: lineHeight, insetX: u ) {
      labelPaint( addr( sReady ), black, lightGray )
    }
  }
}

// ---- scene: sizing --------------------------------------------------------
//
// Two kinds and a clamp. fit hugs its content, grow shares what is left over,
// and fixed is a fit whose minimum and maximum are equal. The third strip is the
// one the port needed: a capped grow that stops at 8 while its neighbour keeps
// taking.

sub buildSizing {
  panel( black, isCol: true, wGrow: true, hGrow: true, insetX: u, insetY: u, gap: u ) {
    strip( addr( sCapFit ) ) {
      swatch( addr( sAbc ), cyan )
      swatch( addr( sDe ), green )
      swatch( addr( sFghi ), yellow )
    }

    strip( addr( sCapGrow ) ) {
      swatch( addr( sAbc ), cyan, wGrow: true )
      swatch( addr( sDe ), green, wGrow: true )
      swatch( addr( sFghi ), yellow, wGrow: true )
    }

    strip( addr( sCapMixed ) ) {
      swatch( addr( sAbc ), cyan, fixedW: 6 * u )
      swatch( addr( sDe ), green, wGrow: true, wMax: 8 * u )
      swatch( addr( sFghi ), yellow, wGrow: true )
    }
  }
}

// ---- scene: capped --------------------------------------------------------
//
// Four growing swatches in a fixed track, the second capped. It reaches its
// ceiling partway through the distribution and drops out, and the two units left
// over are handed to the survivors in order.
//
// This is the scene written for the port rather than ported to it. Every other
// scene removes a candidate from the end of the list, so shift-down and
// swap-with-last agree and candRemove's whole reason for being goes unchecked.
// Removing the second of four is the smallest shape that tells them apart - with
// three, removing the middle of [A,B,C] leaves [A,C] either way. Widths come to
// 7, 5, 7, 6.

sub buildCapped {
  panel( black, isCol: true, wGrow: true, hGrow: true, insetX: u, insetY: u ) {
    box( fixedW: 28 * u, gap: u ) {
      swatch( addr( sAa ), cyan, wGrow: true )
      swatch( addr( sBb ), green, wGrow: true, wMax: 5 * u )
      swatch( addr( sCc ), yellow, wGrow: true )
      swatch( addr( sDd ), magenta, wGrow: true )
    }
  }
}

// ---- scene: squeeze -------------------------------------------------------
//
// The same pair of paragraphs in shrinking tracks. They converge downward, and
// once both reach their longest word the rest overflows rather than crushing
// them.

sub squeezeTrack( a16 caption, u16 width ) {
  strip( caption ) {
    panel( darkGray, fixedW: width, gap: u ) {
      paraPaint( addr( sAlpha ), trackMinW, black, magenta )
      paraPaint( addr( sGamma ), trackMinW, black, red )
    }
  }
}

sub buildSqueeze {
  panel( black, isCol: true, wGrow: true, hGrow: true, insetX: u, insetY: u, gap: u ) {
    squeezeTrack( addr( sTrack26 ), 26 * u )
    squeezeTrack( addr( sTrack22 ), 22 * u )
    squeezeTrack( addr( sTrack14 ), 14 * u )
    squeezeTrack( addr( sTrack8 ), 8 * u )
  }
}

// ---- scene: overflow ------------------------------------------------------
//
// Three labels that will not fit and cannot be squeezed. A label refuses to be
// narrowed, so shrink has nothing to reclaim and the excess spills - the engine
// raises a flag and stops there, because clipping and truncating are decisions
// above the line. The track is centred, which is the point: aligning content
// larger than its container is the one place the arithmetic has to answer "no
// room" rather than a negative number.

sub buildOverflow {
  panel( black, isCol: true, wGrow: true, hGrow: true, insetX: u, insetY: u ) {
    panel( darkGray, fixedW: 10 * u, gap: u, alignMain: alignCenter ) {
      labelPaint( addr( sWider ), black, darkGray )
      labelPaint( addr( sThan ), black, darkGray )
      labelPaint( addr( sThis ), black, darkGray )
    }
  }
}

// ---- scene: alignment -----------------------------------------------------
//
// Nine combinations of alignMain and alignCross, relative to the layout axis
// rather than absolute - one concept instead of two, and the divergence from
// Clay the study argued hardest for. Each cell is a row, so main is x and cross
// is y, and each is labelled with the first letter of each.
//
// Ported because `end` appears nowhere else: without this scene leadFor's third
// branch never runs on either axis.

sub alignCell( a16 at, u8 main, u8 cross ) {
  panel( darkGray, fixedW: 12 * u, fixedH: 3 * lineHeight, alignMain: main, alignCross: cross ) {
    labelPaint( at, yellow, darkGray )
  }
}

sub alignRow( a16 a, a16 b, a16 c, u8 cross ) {
  box( wGrow: true, gap: u ) {
    alignCell( a, alignStart, cross )
    alignCell( b, alignCenter, cross )
    alignCell( c, alignEnd, cross )
  }
}

sub buildAlignment {
  panel( black, isCol: true, wGrow: true, hGrow: true, insetX: u, insetY: u, gap: u ) {
    alignRow( addr( sAlSs ), addr( sAlCs ), addr( sAlEs ), alignStart )
    alignRow( addr( sAlSc ), addr( sAlCc ), addr( sAlEc ), alignCenter )
    alignRow( addr( sAlSe ), addr( sAlCe ), addr( sAlEe ), alignEnd )
  }
}

// ---- scene: wrapping ------------------------------------------------------
//
// One paragraph in three column widths, at 6, 3 and 2 lines. The pair to read
// beside `squeeze`: this one changes the width and lets height follow, where
// squeeze changes the space and lets both follow.
//
// The paragraph declares its longest word as its minimum and nothing else, so
// momolo never learns it is text - the same string three times, and every
// difference on screen comes from the column it was put in.

sub wrapCol( a16 caption, u16 width ) {
  panel( darkGray, isCol: true, fixedW: width ) {
    labelPaint( caption, lightGray, darkGray )
    paraPaint( addr( sFox ), foxMinW, yellow, darkGray )
  }
}

// A row, which is the default direction - the columns are the children, and
// each one is a col in its own right. alignCross is left alone for the same
// reason: start is the default, and the scene wants the three columns
// hanging from the top rather than centred against the tallest.
sub buildWrapping {
  panel( black, wGrow: true, hGrow: true, insetX: u, insetY: u, gap: u ) {
    wrapCol( addr( sW8 ), 8 * u )
    wrapCol( addr( sW14 ), 14 * u )
    wrapCol( addr( sW26 ), 26 * u )
  }
}
