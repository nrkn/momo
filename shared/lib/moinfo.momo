// moinfo.momo - what is in a WAD chain, and what is wrong with it: `wadinfo`,
// as a library (DESIGN §41).
//
// One file or a load chain of them, opened through `mowad` in the order given, so
// a later file overrides an earlier one exactly as a program reading the chain
// would see it. It prints each file's header, then every lump - index, file,
// name, offset, size, and its type with where the type came from: `header` for a
// checked fact, `manifest` for a TYPES row's word, `-` for nothing. A claim and
// a fact never print alike.
//
// Then what it found:
//
// - an entry whose bytes run past the end of its file;
// - a lump that starts `Mo` with a type no header carries, which mowad reads as
//   foreign and says nothing about;
// - entries with the same position and size - an alias set, one payload under
//   several names, which is structure and is one line for the lot;
// - an entry sharing some of another's bytes without being the same span, which
//   is the suspect, a line a pair naming both;
// - bytes no entry, header or directory covers;
// - a name more than one lump carries, and which one wins;
// - a TYPES row naming a lump nobody has, and a TYPES row disagreeing with the
//   header of the lump it names - the header wins, and the row is what is wrong.
//
// **Two switches say less.** `/s` is the summary: no listing, and the bulk -
// gaps, a name repeated inside one file, and alias sets - counted per file
// instead of printed, with a file's largest sets named. Everything else still
// prints in full: an override across files, which is the story a patch tells,
// and every finding that says the file is damaged, because a summary that hid
// one would be a lie. `/l` is the listing and nothing after it, and it skips
// the checks rather than running them quietly - a fast read of the directory is
// the whole of what it is for.
//
// **It has to cope with DOOM.WAD's thousands of lumps.** The listing streams:
// nothing about a lump is kept but the name mowad already indexes. The checks
// need an order - by position within a file, by name across the chain - so
// they sort a table of positions and sizes, and that table is past the program's
// own segment, in the block DOS gave it (§47). A machine with no room there gets
// the listing and is told the checks were skipped.
//
// It is a library rather than part of `wadinfo` because a project has one
// command tail: each mode is a project of its own, and a second project reaches
// code only through `shared/`. `wadinfo`, `wadsum`, `wadlist` and `wadusage` are
// this file under four tails.

include "lib/std/io.momo"
include "lib/std/str.momo"
include "lib/std/block.momo"
include "lib/mowad.momo"

// ---- the modes ----

// A unit, so a count cannot be handed where a mode was wanted.
unit infoMode = u8 < 3

local const infoMode infoFull    = 0   // the listing, then every finding
local const infoMode infoSummary = 1   // `/s`
local const infoMode infoListing = 2   // `/l`

local infoMode mode

// ---- the command tail ----
//
// Words separated by spaces. One starting with `/` is a switch, in either case,
// before the paths or among them; anything else is a path. The tail is at
// PSP:0080h - a length, the text, a carriage return - and nothing here moves the
// DTA over it before this runs.

// A DOS path can be longer than a name, and the tail is at most 127 bytes.
local const pathRoom = 80

local u8[wadMaxFiles * pathRoom] paths
local u16 pathCount

local sub takeTail {
  u16 n
  a16 at
  u16 w
  u16 keep
  a16 to

  n = peek8( 0x80 )
  at = 0x81
  pathCount = 0
  mode = infoFull

  while ( n > 0 ) {
    while ( n > 0 && peek8( at ) == ' ' ) {
      at++
      n--
    }

    if ( n == 0 || peek8( at ) == 13 ) return

    w = 0
    while ( w < n && peek8( at + w ) != ' ' && peek8( at + w ) != 13 ) {
      w++
    }

    // A path past `wadMaxFiles` is dropped, as it always was, and a switch
    // after it is still read.
    if ( peek8( at ) == '/' ) {
      takeSwitch( at, w )
    } else if ( pathCount < wadMaxFiles ) {
      to = pathOf( pathCount )
      keep = w < pathRoom - 1 ? w : pathRoom - 1

      for ( u16 k = 0; k < keep; k++ ) {
        poke8( to + k, peek8( at + k ) )
      }

      poke8( to + keep, 0 )
      pathCount++
    }

    at += w
    n -= w
  }
}

local const u8[] sTool      = "wadinfo: $"
local const u8[] sNotSwitch = " is not a switch - write /s, /l, or neither$"
local const u8[] sBoth      = "/s and /l together - write one of them, or neither$"

local sub takeSwitch( a16 at, u16 w ) {
  infoMode want
  u8 ch

  ch = 0
  if ( w == 2 ) ch = peek8( at + 1 ) | 0x20

  if ( ch == 's' ) {
    want = infoSummary
  } else if ( ch == 'l' ) {
    want = infoListing
  } else {
    putStr( addr( sTool ) )
    for ( u16 k = 0; k < w; k++ ) {
      putChar( peek8( at + k ) )
    }
    putStr( addr( sNotSwitch ) )
    refuse()
  }

  if ( mode != infoFull && mode != want ) {
    putStr( addr( sTool ) )
    putStr( addr( sBoth ) )
    refuse()
  }

  mode = want
}

local const u8[] sUsage     = "usage: wadinfo [/s | /l] FILE.WAD [PATCH.WAD ...]$"
local const u8[] sUsageLoad = "  a later file overrides an earlier one$"
local const u8[] sUsageSum  = "  /s  a summary - overrides and damage in full, the rest counted$"
local const u8[] sUsageList = "  /l  the listing alone, and nothing checked$"

local sub putUsage {
  putStr( addr( sUsage ) )
  newline()
  putStr( addr( sUsageLoad ) )
  newline()
  putStr( addr( sUsageSum ) )
  newline()
  putStr( addr( sUsageList ) )
  newline()
}

// **A tail that cannot be read stops the run** before any file is opened, on
// the line that says what to write and the usage under it. Exit code 1, so a
// batch file can tell.
local sub refuse {
  newline()
  putUsage()
  _ax = 0x4C01
  int 0x21
}

local a16 pathOf( u16 f ) => addr( paths ) + f * pathRoom

local sub putPath( u16 f ) {
  for ( a16 at = pathOf( f ); peek8( at ) != 0; at++ ) {
    putChar( peek8( at ) )
  }
}

// ---- 32-bit numbers, as two words ----
//
// mowad reads a WAD without adding two words together once. A checker cannot:
// "runs past the end" is a position plus a size against a length, and all three
// are four bytes. So these are the handful of carried operations the checks
// make, on pairs held in globals because a routine returns one word.

local u16 sumHi
local u16 sumLo

local sub add32( u16 aHi, u16 aLo, u16 bHi, u16 bLo ) {
  sumLo = aLo + bLo
  sumHi = aHi + bHi + u16( sumLo < aLo )
}

local sub sub32( u16 aHi, u16 aLo, u16 bHi, u16 bLo ) {
  sumLo = aLo - bLo
  sumHi = aHi - bHi - u16( aLo < bLo )
}

local bool below32( u16 aHi, u16 aLo, u16 bHi, u16 bLo ) => aHi < bHi || ( aHi == bHi && aLo < bLo )

// Decimal. The division is by 10 across both words a byte at a time, so no
// intermediate passes 9 * 256 + 255 and every step is a `u16` one.
local u8[10] digits

local u16 text32( a16 at, u16 hi, u16 lo ) {
  u16 n
  u16 r
  u16 t
  u16 upper

  n = 0

  for ( ;; ) {
    r = hi % 10
    hi /= 10

    t = r * 256 + ( lo >> 8 )
    upper = t / 10
    r = t % 10

    t = r * 256 + ( lo & 255 )
    lo = upper * 256 + t / 10
    r = t % 10

    digits[n] = u8( r ) + '0'
    n++

    if ( hi == 0 && lo == 0 ) break
  }

  for ( u16 i = 0; i < n; i++ ) {
    poke8( at + i, digits[ n - 1 - i ] )
  }

  return n
}

local u8[12] numBuf

local sub put32( u16 hi, u16 lo ) {
  u16 n

  n = text32( addr( numBuf ), hi, lo )
  for ( u16 i = 0; i < n; i++ ) {
    putChar( numBuf[i] )
  }
}

local sub spaces( u16 n ) {
  for ( u16 i = 0; i < n; i++ ) {
    space()
  }
}

// Right-aligned in `width`, and over it rather than cut when it does not fit.
local sub right32( u16 hi, u16 lo, u16 width ) {
  u16 n

  n = text32( addr( numBuf ), hi, lo )
  if ( n < width ) spaces( width - n )
  for ( u16 i = 0; i < n; i++ ) {
    putChar( numBuf[i] )
  }
}

local sub right16( u16 v, u16 width ) => right32( 0, v, width )

local u16 nameLen( u16 lump ) {
  u16 n

  n = 0
  while ( n < wadNameBytes && peek8( wadName( lump ) + n ) != 0 ) {
    n++
  }

  return n
}

// ---- the table the checks sort ----
//
// One far region, five columns: the order being sorted, and the position and
// size of each lump as word pairs. One row past the lumps, because the
// directory is a range of bytes too and is swept with them.

local const colRows = wadMaxLumps + 1

local u16 colSeg
local far u16[colRows * 5] cols = colSeg

local view u16[colRows] order  = cols[0]
local view u16[colRows] posHi  = cols[colRows]
local view u16[colRows] posLo  = cols[colRows * 2]
local view u16[colRows] sizeHi = cols[colRows * 3]
local view u16[colRows] sizeLo = cols[colRows * 4]

local bool haveTable

// ---- findings ----
//
// `found` is what printed, and `counted` is what a summary counted instead - so
// "none" is said only when both are nothing.

local u16 found
local u16 counted

local const u8[] sFindings = "findings$"
local const u8[] sNone     = "none$"
local const u8[] sInTally  = "none in full - the tally below counts the rest$"
local const u8[] sColon    = ": $"
local const u8[] sAt       = " at $"
local const u8[] sBytes    = " bytes$"
local const u8[] sPast     = " bytes, runs past the end of the file$"
local const u8[] sOverlaps = " overlaps $"
local const u8[] sHeaderIs = "the header$"
local const u8[] sDirIs    = "the directory$"
local const u8[] sStartsMo = " starts Mo, but $"
local const u8[] sNoCarry  = " is no type a header carries, so it is read as foreign$"
local const u8[] sShare    = " entries share $"
local const u8[] sThen     = " - $"
local const u8[] sAndMore  = ", and $"
local const u8[] sMore     = " more$"
local const u8[] sGapTail  = " that nothing references$"
local const u8[] sLumps    = " lumps, and #$"
local const u8[] sIn       = " in $"
local const u8[] sWins     = " wins$"
local const u8[] sRow      = "TYPES row $"
local const u8[] sSays     = " says $"
local const u8[] sHeadSays = ", and its header says $"
local const u8[] sNoLump   = " names no lump$"
local const u8[] sBadTypes = "TYPES is not a manifest - it has no Mo header of type types, so its rows are not read$"
local const u8[] sTwoTypes = " TYPES lumps, and only the last is read$"
local const u8[] sNoTable  = "no memory past the program for the checks, so only the TYPES rows were checked$"

// A finding opens with the file it is about, when it is about one.
local sub findingIn( u16 f ) {
  found++
  putPath( f )
  putStr( addr( sColon ) )
}

// A lump by its index and its name, because two lumps can share a name and a
// finding about the pair has to say which is which.
local sub putMember( u16 lump ) {
  putChar( '#' )
  putNumber( lump )
  space()
  wadPutName( lump )
}

// A directory entry, or what the extra row stands for.
local sub putEntry( u16 f, u16 e ) {
  if ( e == wadFileLumps( f ) ) {
    putStr( addr( sDirIs ) )
  } else {
    putMember( wadFileBase( f ) + e )
  }
}

// **An alias set, in one line**: how many entries, the span they share, and the
// first three by index. `m1` and `m2` are `wadNone` past the end of the set.
local sub putAlias( u16 count, u16 m0, u16 m1, u16 m2 ) {
  putNumber( count )
  putStr( addr( sShare ) )
  put32( wadSizeHigh( m0 ), wadSizeLow( m0 ) )
  putStr( addr( sBytes ) )
  putStr( addr( sAt ) )
  put32( wadPosHigh( m0 ), wadPosLow( m0 ) )
  putStr( addr( sThen ) )
  putMember( m0 )

  if ( m1 != wadNone ) {
    putStr( addr( sComma ) )
    putMember( m1 )
  }

  if ( m2 != wadNone ) {
    putStr( addr( sComma ) )
    putMember( m2 )
  }

  if ( count > 3 ) {
    putStr( addr( sAndMore ) )
    putNumber( count - 3 )
    putStr( addr( sMore ) )
  }

  newline()
}

// ---- what a summary counts, per file ----
//
// Every lump is one of three: it wins, because it is the last under its name
// and so the one a program is handed; a later file's lump wins over it; or a
// later lump in its own file does, and no file after carries the name. The
// last is the bulk - a file repeating a name is that file's business - and the
// middle one is the override story, which prints in every mode as well.
//
// Beside that, its alias sets: how many, and how many distinct spans serve how
// many entries - so a file that is mostly one payload under many names says so
// in one line - and the largest few, each as the full mode prints it.

local group tally[wadMaxFiles] {
  u16 wins
  u16 shadowed
  u16 repeats
  u16 gaps
  u16 gapHi
  u16 gapLo
  u16 sets
  u16 payloads
  u16 served
}

local const topSets = 3

// A file's largest sets, largest first, at `f * topSets`. A count of 0 is a
// slot nothing filled.
local group top[wadMaxFiles * topSets] {
  u16 count
  u16 m0
  u16 m1
  u16 m2
}

// ---- sorting ----
//
// Shell sort with Knuth's gaps, over `order`. Two keys: a position within one
// file, and a name across the chain, and the index breaks every tie - so equal
// keys come out in load order, which is what makes the last of a run of names
// the one that wins.

local bool byName

local bool before( u16 a, u16 b ) {
  a16 na
  a16 nb

  if ( byName ) {
    na = wadName( a )
    nb = wadName( b )

    for ( u16 k = 0; k < wadNameBytes; k += 2 ) {
      if ( peek16( na + k ) != peek16( nb + k ) ) return peek16( na + k ) < peek16( nb + k )
    }
  } else {
    if ( posHi[a] != posHi[b] ) return posHi[a] < posHi[b]
    if ( posLo[a] != posLo[b] ) return posLo[a] < posLo[b]

    // The larger first, so a span comes before one it contains from its start,
    // and identical spans sit together in index order.
    if ( sizeHi[a] != sizeHi[b] ) return sizeHi[a] > sizeHi[b]
    if ( sizeLo[a] != sizeLo[b] ) return sizeLo[a] > sizeLo[b]
  }

  return a < b
}

local sub sortOrder( u16 n ) {
  u16 gap
  u16 v
  u16 j

  gap = 1
  while ( gap < n / 3 ) {
    gap = gap * 3 + 1
  }

  while ( gap > 0 ) {
    for ( u16 i = gap; i < n; i++ ) {
      v = order[i]
      j = i

      while ( j >= gap && before( v, order[ j - gap ] ) ) {
        order[j] = order[ j - gap ]
        j -= gap
      }

      order[j] = v
    }

    gap /= 3
  }
}

// ---- one file's bytes: past the end, overlapping, unreferenced ----

local const u8[] typesName = "TYPES\0"

local sub checkFile( u16 f ) {
  u16 lumps
  u16 base
  u16 endHi
  u16 endLo
  u16 reachHi
  u16 reachLo
  u16 owner
  u16 e
  u16 run
  u16 manifests
  u16 stray

  lumps = wadFileLumps( f )
  base = wadFileBase( f )
  endHi = wadFileSizeHigh( f )
  endLo = wadFileSizeLow( f )
  manifests = 0

  for ( u16 i = 0; i < lumps; i++ ) {
    order[i] = i
    posHi[i] = wadPosHigh( base + i )
    posLo[i] = wadPosLow( base + i )
    sizeHi[i] = wadSizeHigh( base + i )
    sizeLo[i] = wadSizeLow( base + i )

    if ( isTypes( base + i ) ) manifests++

    if ( sizeHi[i] == 0 && sizeLo[i] == 0 ) continue

    // A carry out of the top word is a range past anything a file can be.
    add32( posHi[i], posLo[i], sizeHi[i], sizeLo[i] )
    if ( sumHi < posHi[i] || below32( endHi, endLo, sumHi, sumLo ) ) {
      findingIn( f )
      wadPutName( base + i )
      putStr( addr( sAt ) )
      put32( posHi[i], posLo[i] )
      putStr( addr( sComma ) )
      put32( sizeHi[i], sizeLo[i] )
      putStr( addr( sPast ) )
      newline()
    }

    // `Mo` alone is two bytes a foreign lump can start with. mowad reads one
    // with no header, silently, and the listing shows what that left it; this
    // is where it is said.
    stray = wadLookalike( base + i )
    if ( stray != wadNone ) {
      findingIn( f )
      putMember( base + i )
      putStr( addr( sStartsMo ) )
      putNumber( stray )
      putStr( addr( sNoCarry ) )
      newline()
    }
  }

  if ( manifests > 1 ) {
    findingIn( f )
    putNumber( manifests )
    putStr( addr( sTwoTypes ) )
    newline()
  }

  // The directory, as one more range.
  order[lumps] = lumps
  posHi[lumps] = wadFileDirHigh( f )
  posLo[lumps] = wadFileDirLow( f )
  sizeHi[lumps] = 0
  sizeLo[lumps] = lumps * wadEntryBytes

  byName = false
  sortOrder( lumps + 1 )

  // **The sweep.** In position order, `reach` is as far as anything so far
  // covers and `owner` is what reached it, starting with the header. A range
  // starting short of the reach overlaps its owner; one starting past it leaves
  // a gap. A range starting at or past the end of the file is the finding
  // above and nothing here, and a marker covers nothing.
  //
  // **Entries with the same position and size are one range**, taken together
  // as an alias set: one payload under several names, which is structure and
  // not damage, so it is one line and never a pair. Only a range that shares
  // some bytes without being the same span is an overlap. The directory is not
  // an entry, and never joins a set.
  reachHi = 0
  reachLo = wadHeaderBytes
  owner = wadNone

  for ( u16 k = 0; k <= lumps; k += run ) {
    e = order[k]
    run = 1

    if ( sizeHi[e] == 0 && sizeLo[e] == 0 ) continue
    if ( !below32( posHi[e], posLo[e], endHi, endLo ) ) continue

    // Identical spans sort together, and the directory's index sorts it after
    // any entry sharing its span.
    while ( k + run <= lumps && order[ k + run ] != lumps && sameSpan( e, order[ k + run ] ) ) {
      run++
    }

    if ( e != lumps ) {
      tally[f].payloads++
      tally[f].served += run
    }

    if ( below32( posHi[e], posLo[e], reachHi, reachLo ) ) {
      findingIn( f )
      putEntry( f, e )
      putStr( addr( sAt ) )
      put32( posHi[e], posLo[e] )
      putStr( addr( sOverlaps ) )
      if ( owner == wadNone ) {
        putStr( addr( sHeaderIs ) )
      } else {
        putEntry( f, owner )
      }
      newline()
    } else if ( below32( reachHi, reachLo, posHi[e], posLo[e] ) ) {
      sub32( posHi[e], posLo[e], reachHi, reachLo )
      reportGap( f, reachHi, reachLo )
    }

    if ( run > 1 ) aliasSet( f, k, run )

    add32( posHi[e], posLo[e], sizeHi[e], sizeLo[e] )
    if ( below32( reachHi, reachLo, sumHi, sumLo ) ) {
      reachHi = sumHi
      reachLo = sumLo
      owner = e
    }
  }

  if ( below32( reachHi, reachLo, endHi, endLo ) ) {
    sub32( endHi, endLo, reachHi, reachLo )
    reportGap( f, reachHi, reachLo )
  }
}

local bool sameSpan( u16 a, u16 b ) {
  return posHi[a] == posHi[b] && posLo[a] == posLo[b] &&
         sizeHi[a] == sizeHi[b] && sizeLo[a] == sizeLo[b]
}

// The `run` entries of `order` from `k`, one span. **Bulk**: a summary counts
// it, and keeps it if it is one of its file's largest.
local sub aliasSet( u16 f, u16 k, u16 run ) {
  u16 base
  u16 m2
  u16 slot
  u16 j

  base = wadFileBase( f )
  m2 = run > 2 ? base + order[ k + 2 ] : wadNone
  tally[f].sets++

  if ( mode != infoSummary ) {
    findingIn( f )
    putAlias( run, base + order[k], base + order[ k + 1 ], m2 )
    return
  }

  counted++

  // Strictly larger displaces, so of two sets the same size the earlier stays.
  slot = f * topSets
  j = 0
  while ( j < topSets && top[ slot + j ].count >= run ) {
    j++
  }

  if ( j == topSets ) return

  for ( u16 i = topSets - 1; i > j; i-- ) {
    top[ slot + i ].count = top[ slot + i - 1 ].count
    top[ slot + i ].m0 = top[ slot + i - 1 ].m0
    top[ slot + i ].m1 = top[ slot + i - 1 ].m1
    top[ slot + i ].m2 = top[ slot + i - 1 ].m2
  }

  top[ slot + j ].count = run
  top[ slot + j ].m0 = base + order[k]
  top[ slot + j ].m1 = base + order[ k + 1 ]
  top[ slot + j ].m2 = m2
}

// `sumHi:sumLo` bytes at `hi:lo`. **Bulk**: a summary adds it to its file's
// count instead of printing it.
local sub reportGap( u16 f, u16 hi, u16 lo ) {
  if ( mode == infoSummary ) {
    counted++
    tally[f].gaps++
    add32( tally[f].gapHi, tally[f].gapLo, sumHi, sumLo )
    tally[f].gapHi = sumHi
    tally[f].gapLo = sumLo
    return
  }

  findingIn( f )
  put32( sumHi, sumLo )
  putStr( addr( sBytes ) )
  putStr( addr( sAt ) )
  put32( hi, lo )
  putStr( addr( sGapTail ) )
  newline()
}

local bool isTypes( u16 lump ) {
  for ( u16 k = 0; k < wadNameBytes; k++ ) {
    if ( peek8( wadName( lump ) + k ) != typesName[k] ) return false
    if ( typesName[k] == 0 ) return true
  }

  return true
}

// ---- names across the chain ----
//
// Sorted by name, a run of equal names is a lump and the lumps it shadows. The
// winner is asked of `wadLump` rather than read off the end of the run, so what
// this reports is what a program reading the chain is handed. TYPES is left
// out of the findings: each file has its own, and their rows merge rather than
// one shadowing another - so in the counts each file's last TYPES wins.

local sub checkNames {
  u16 total
  u16 run
  u16 first
  u16 win
  u16 home
  u16 m
  u16 f

  total = wadCount()

  for ( u16 i = 0; i < total; i++ ) {
    order[i] = i
  }

  byName = true
  sortOrder( total )

  // Marked at the first of each run, so the findings come out in index order
  // rather than in whatever order the names sort into.
  for ( u16 i = 0; i < total; i++ ) {
    sizeLo[i] = 0
  }

  for ( u16 k = 0; k < total; k += run ) {
    run = 1
    while ( k + run < total && sameName( order[k], order[ k + run ] ) ) {
      run++
    }

    first = order[k]

    if ( isTypes( first ) ) {
      for ( u16 j = k; j < k + run; j++ ) {
        f = wadFileOf( order[j] )
        if ( j + 1 < k + run && wadFileOf( order[ j + 1 ] ) == f ) {
          tally[f].repeats++
        } else {
          tally[f].wins++
        }
      }

      continue
    }

    win = run == 1 ? first : wadLump( wadName( first ) )
    home = wadFileOf( win )

    for ( u16 j = k; j < k + run; j++ ) {
      m = order[j]
      f = wadFileOf( m )

      if ( m == win ) {
        tally[f].wins++
      } else if ( f == home ) {
        tally[f].repeats++
      } else {
        tally[f].shadowed++
      }
    }

    if ( run == 1 ) continue

    // **Bulk** when the whole run is in one file, and a summary counts it. A
    // run starting in an earlier file than its winner's is an override, and
    // prints whatever the mode.
    if ( mode == infoSummary && wadFileOf( first ) == home ) {
      counted++
    } else {
      sizeLo[first] = run
      posLo[first] = win
    }
  }

  for ( u16 i = 0; i < total; i++ ) {
    if ( sizeLo[i] == 0 ) continue

    found++
    wadPutName( i )
    putStr( addr( sColon ) )
    putNumber( sizeLo[i] )
    putStr( addr( sLumps ) )
    putNumber( posLo[i] )
    putStr( addr( sIn ) )
    putPath( wadFileOf( posLo[i] ) )
    putStr( addr( sWins ) )
    newline()
  }
}

local bool sameName( u16 a, u16 b ) {
  for ( u16 k = 0; k < wadNameBytes; k += 2 ) {
    if ( peek16( wadName( a ) + k ) != peek16( wadName( b ) + k ) ) return false
  }

  return true
}

// ---- the manifests ----

local u8[wadRowBytes] row

local sub putRowName {
  for ( u16 k = 0; k < wadNameBytes && row[k] != 0; k++ ) {
    putChar( row[k] >= 32 && row[k] < 127 ? row[k] : '?' )
  }
}

local sub checkRows( u16 f ) {
  u16 m
  u16 lump
  wadType has

  if ( wadManifestBad( f ) ) {
    findingIn( f )
    putStr( addr( sBadTypes ) )
    newline()
  }

  m = wadManifest( f )
  if ( m == wadNone ) return

  wadStartAs( m, wadTypeTypes )

  while ( wadNext( addr( row ), wadRowBytes ) == wadRowBytes ) {
    lump = wadLump( addr( row ) )

    if ( lump == wadNone ) {
      findingIn( f )
      putStr( addr( sRow ) )
      putRowName()
      putStr( addr( sNoLump ) )
      newline()
      continue
    }

    has = wadTypeOf( lump )
    if ( wadTypeFrom() == wadFromHeader && has != wadType( row[wadNameBytes] ) ) {
      findingIn( f )
      putStr( addr( sRow ) )
      putRowName()
      putStr( addr( sSays ) )
      putStr( wadTypeName( wadType( row[wadNameBytes] ) ) )
      putStr( addr( sHeadSays ) )
      putStr( wadTypeName( has ) )
      newline()
    }
  }
}

// ---- the tally ----

local const u8[] sTally    = "tally$"
local const u8[] sLumpsOf  = " lumps - $"
local const u8[] sWin      = " win, $"
local const u8[] sShadowed = " shadowed by a later file, $"
local const u8[] sRepeated = " repeated within the file$"
local const u8[] sBytesIn  = " bytes in $"
local const u8[] sGap      = " gap$"
local const u8[] sGaps     = " gaps$"
local const u8[] sSet      = " alias set - $"
local const u8[] sSets     = " alias sets - $"
local const u8[] sPayload  = " distinct payload serves $"
local const u8[] sPayloads = " distinct payloads serve $"
local const u8[] sEntries  = " entries$"

// A line a file, and a second for its gaps when it has any - the full mode's
// gap lines, added up.
local sub putTally {
  newline()
  putStr( addr( sTally ) )
  newline()

  for ( u16 f = 0; f < wadFiles(); f++ ) {
    putPath( f )
    putStr( addr( sColon ) )
    putNumber( wadFileLumps( f ) )
    putStr( addr( sLumpsOf ) )
    putNumber( tally[f].wins )
    putStr( addr( sWin ) )
    putNumber( tally[f].shadowed )
    putStr( addr( sShadowed ) )
    putNumber( tally[f].repeats )
    putStr( addr( sRepeated ) )
    newline()

    if ( tally[f].gaps > 0 ) {
      putPath( f )
      putStr( addr( sColon ) )
      put32( tally[f].gapHi, tally[f].gapLo )
      putStr( addr( sBytesIn ) )
      putNumber( tally[f].gaps )
      putStr( tally[f].gaps == 1 ? addr( sGap ) : addr( sGaps ) )
      putStr( addr( sGapTail ) )
      newline()
    }

    if ( tally[f].sets > 0 ) putSets( f )
  }
}

// A file's alias sets in a line, then its largest.
local sub putSets( u16 f ) {
  u16 slot

  putPath( f )
  putStr( addr( sColon ) )
  putNumber( tally[f].sets )
  putStr( tally[f].sets == 1 ? addr( sSet ) : addr( sSets ) )
  putNumber( tally[f].payloads )
  putStr( tally[f].payloads == 1 ? addr( sPayload ) : addr( sPayloads ) )
  putNumber( tally[f].served )
  putStr( addr( sEntries ) )
  newline()

  slot = f * topSets

  for ( u16 j = 0; j < topSets && top[ slot + j ].count > 0; j++ ) {
    putPath( f )
    putStr( addr( sColon ) )
    putAlias( top[ slot + j ].count, top[ slot + j ].m0, top[ slot + j ].m1, top[ slot + j ].m2 )
  }
}

// ---- the listing ----

local const u8[] sRefused = ": not opened - $"
local const u8[] sIwad    = ": IWAD, $"
local const u8[] sPwad    = ": PWAD, $"
local const u8[] sDir     = " lumps, directory at $"
local const u8[] sComma   = ", $"
local const u8[] sHead    = "    #  f  name        offset      size  type     from$"
local const u8[] sHeader  = "header$"
local const u8[] sRowFrom = "manifest$"
local const u8[] sDash    = "-$"

local sub listLump( u16 i ) {
  wadType t

  right16( i, 5 )
  spaces( 2 )
  putNumber( wadFileOf( i ) )
  spaces( 2 )
  wadPutName( i )
  spaces( wadNameBytes - nameLen( i ) )
  right32( wadPosHigh( i ), wadPosLow( i ), 10 )
  right32( wadSizeHigh( i ), wadSizeLow( i ), 10 )
  spaces( 2 )

  t = wadTypeOf( i )

  if ( wadTypeFrom() == wadUntyped ) {
    putStr( addr( sDash ) )
    spaces( 8 )
    putStr( addr( sDash ) )
  } else {
    putStr( wadTypeName( t ) )
    spaces( 9 - strLen( wadTypeName( t ) ) )
    putStr( wadTypeFrom() == wadFromHeader ? addr( sHeader ) : addr( sRowFrom ) )
  }

  newline()
}

local sub showListing {
  newline()
  putStr( addr( sHead ) )
  newline()

  for ( u16 i = 0; i < wadCount(); i++ ) {
    listLump( i )
  }
}

// Everything that needs the table, then the manifests, which do not.
local sub showFindings {
  newline()
  putStr( addr( sFindings ) )
  newline()

  colSeg = blockBase()
  haveTable = blockFits( colSeg, colRows * 5 * 2 )
  found = 0
  counted = 0

  if ( haveTable ) {
    for ( u16 f = 0; f < wadFiles(); f++ ) {
      checkFile( f )
    }

    checkNames()
  } else {
    putStr( addr( sNoTable ) )
    newline()
  }

  for ( u16 f = 0; f < wadFiles(); f++ ) {
    checkRows( f )
  }

  if ( !haveTable ) return

  if ( found == 0 && counted == 0 ) {
    putStr( addr( sNone ) )
    newline()
  } else if ( found == 0 ) {
    putStr( addr( sInTally ) )
    newline()
  }

  if ( mode == infoSummary ) putTally()
}

// ---- entry ----

// The whole program: read the tail, open the chain, and say what the mode asks
// for.
sub infoRun {
  takeTail()

  if ( pathCount == 0 ) {
    putUsage()
    return
  }

  for ( u16 f = 0; f < pathCount; f++ ) {
    putNumber( f )
    space()
    putPath( f )

    if ( !wadOpen( pathOf( f ) ) ) {
      putStr( addr( sRefused ) )
      putStr( wadWhy() )
      newline()
      return
    }

    putStr( wadFileIwad( f ) ? addr( sIwad ) : addr( sPwad ) )
    putNumber( wadFileLumps( f ) )
    putStr( addr( sDir ) )
    put32( wadFileDirHigh( f ), wadFileDirLow( f ) )
    putStr( addr( sComma ) )
    put32( wadFileSizeHigh( f ), wadFileSizeLow( f ) )
    putStr( addr( sBytes ) )
    newline()
  }

  // **`/l` never reaches the checks** - not the block, not either sort, not the
  // manifest scans. Running them and printing nothing would cost a listing of
  // DOOM.WAD the time the checks take, and a fast read is the point of it.
  if ( mode != infoSummary ) showListing()
  if ( mode != infoListing ) showFindings()

  wadClose()
}
