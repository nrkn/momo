// motext.momo - the text buffer an editor edits (DESIGN §54, §58).
//
// A line is a chain of chunks and the chunks are deliberately not kept full, so
// an insert moves bytes inside one chunk and touches nothing else. A chunk that
// fills splits in half and both halves have room again; a deletion that leaves
// one short folds the next into it, which puts a floor under occupancy. Every
// edit is bounded by a chunk rather than by the document, and a line has no
// length limit.
//
// It is this shape because of one measurement. There are no string instructions
// (§1), so moving a byte costs seventeen and a gap buffer would take about
// 0.6 seconds to move a 16 KB gap. Nothing here moves bulk text: a split moves
// half a chunk, a merge moves at most one, and an insert moves part of one.
//
// **The text lives past our own segment** (§58), in the block DOS gave us, and a
// chunk is addressed as a *paragraph* rather than as an offset - both are sixteen
// bytes, so chunk `c` is the paragraph `c` past the base and no index ever has to
// hold more than one chunk.
//
// **The records live in the heap the text vacated** - the chunk links, the line
// heads and the undo log, all views rather than arrays. Nothing of either half is
// in the image, which is the rule the move settled: **capacity lives in the heap
// or past the segment, and the image is for code.** An ordinary array is emitted
// as `times N db 0` and puts every byte of capacity into the `.COM`, which at
// this size is tens of kilobytes of zeros on disk.
//
// **It claims the bottom of the heap for those records**, and a program
// partitioning the rest starts after it:
//
//   view u8[myBytes] mine = _heap[textHeap]
//
// That is §17's static partitioning with this library going first. Two libraries
// both wanting the heap is the point at which that stops being enough, and
// nothing here pre-solves it.
//
// **The caller never indexes a chunk.** Reading is `lineSlice`, which walks the
// chain once and copies out. That is the rule the piece-table draft produced and
// it holds here too: the chain is walked once per line, never once per character.
//
// **`textSave` is here on an argument that has since reversed.** It used to be
// here because it handed DOS each chunk where it already lay, which needed
// everything private in this file. §58 put the chunks somewhere DOS cannot be
// pointed at, so it stages through a buffer in our own segment and now needs
// nothing but `lineSlice`. It stays because `textLoad` cannot leave - that one
// does need the privates - and splitting a file's two halves across two libraries
// is worse than the inconsistency. §11 prunes the include either way.

include "lib/std/file.momo"
include "lib/std/block.momo"

// ---- capacity ----
//
// Sized by consts here, the way momolo sizes `maxElements`. **These are the
// ceiling rather than the demand**: a far region emits no storage, so a size
// here costs nothing until a chunk is actually handed out, and `textInit` caps
// what it hands out at whatever the machine turned out to have. A smaller
// machine gets a smaller buffer rather than no editor.
//
// **`maxChunks` may not pass 32,767.** The link array is `u16` per chunk and a
// far region is reached at a `u16` offset, so twice this has to fit one - which
// is the one relationship here that is arithmetic rather than judgement.

local const chunkSize = 16
local const halfChunk = chunkSize / 2
local const maxChunks = 24000
local const maxUndo   = 2048

// **Chunks rather than bytes**, because the byte count no longer fits a `u16` -
// which is the whole of what moving past the segment bought. A program that
// wants to know the capacity in bytes multiplies, in whatever width it likes.
// **Public because a test has had to chase it twice.** A group longer than the
// log is a case worth covering and the fixture that covers it has to be sized
// against this number, so the number is readable rather than copied.
const textUndoMax  = maxUndo
const textMaxLines = 12000
const textChunks   = maxChunks
const textChunkSize = chunkSize

// ---- storage ----

// **The text lives past our own segment**, in the block DOS gave us (§47), and
// the chunks are addressed by *segment* rather than by offset: a chunk is
// sixteen bytes and so is a paragraph, so chunk `c` is the paragraph `c` past
// the base. That is why there is no offset arithmetic below and no 64 KB cap
// above - the index never has to hold more than one chunk, so `maxChunks` is
// bounded by the block and by the records, not by what a `u16` can reach.
//
// **Two windows, because a split and a merge copy between two chunks.** One
// would mean changing the segment between every read and its write.
//
// §16 reloads ES per access and never hoists a runtime segment, which is
// exactly what makes this safe and is also what it costs: about eighteen cycles
// for every byte actually touched. Nothing here touches more than a chunk at a
// time, which is the whole reason the argument that refused far memory stopped
// being true - it was pricing a buffer nobody had built yet.
local u16 textBase
local u16 srcSeg
local u16 dstSeg

// **The records followed the text out.** They were views over the heap, which
// cost the image nothing and cost the *segment* three bytes a chunk and four a
// line - so the ceiling stopped being the text and became a table describing
// it. Past the segment there is no table to run out of.
//
// Four regions rather than one, because each is reached at a `u16` offset and
// together they are more than 64 KB. They are laid out in order from the base
// and the text starts after them, which is the whole of the arithmetic.
local const nextParas = ( maxChunks * 2 ) / chunkSize
local const usedParas = maxChunks / chunkSize
local const headParas = ( textMaxLines * 2 ) / chunkSize
local const lenParas  = ( textMaxLines * 2 ) / chunkSize
local const recParas  = nextParas + usedParas + headParas + lenParas

local u16 recBase
local u16 nextSeg
local u16 usedSeg
local u16 headSeg
local u16 lenSeg

local far u8[chunkSize] src = srcSeg
local far u8[chunkSize] dst = dstSeg

// **The window is set immediately before it is used**, and nothing between the
// two calls out to anything that could move it. That is the one rule this
// arrangement adds and the one way it can go quietly wrong.
local sub atDst( u16 c ) {
  dstSeg = textBase + c
}

local sub atSrc( u16 c ) {
  srcSeg = textBase + c
}

// Chunk 0 is the null, so `next == 0` ends a chain and no real chunk is 0. A
// chunk's bytes are at `c * chunkSize`, and there is no table of addresses
// because `chunkSize` is a power of two and §26 folds the multiply to a shift.
// A table would be right if the stride were imposed, as §43's is; here it is
// ours to choose, so it is chosen to need no table.
// **Views over the heap, not arrays**, and not a `group` either - which is a
// loss worth naming. §52 exists so a record can be read as a row, and §18 lays a
// group out as parallel arrays anyway, so what changes here is only the source
// form. What forces it is that a group's fields are storage: they would be
// emitted as `times N db 0` and put every byte of capacity into the `.COM`,
// which at this size is tens of kilobytes of zeros on disk.
//
// So the records went where the text used to be. **The heap did not get smaller
// when the text moved past the segment - it got vacated**, and this is what moved
// into it.
local far u16[maxChunks] chunkNext = nextSeg
local far u8[maxChunks]  chunkUsed = usedSeg

// **A high-water mark and a list of what came back**, which is what removes the
// walk that used to thread every chunk onto a free list at startup. At this
// capacity that walk is twenty-four thousand far writes, and a far write is not
// a near one - it is about a second on a 4.77 MHz machine, spent building a
// list that a counter describes for nothing.
//
// `chunkHigh` is the lowest chunk never handed out; `chunkFree` is the head of
// the returned ones. Taking prefers the returned list, so a long session reuses
// rather than climbing.
local u16 chunkHigh
local u16 chunkFree

// What the machine actually had room for, which is not what the consts above
// declare. Set by `textInit` from the block DOS gave us.
local u16 chunkLimit
local u16 lineLimit

local far u16[textMaxLines] lineHead = headSeg
local far u16[textMaxLines] lineLen  = lenSeg
local u16 lineCount

// What this library claims at the bottom of the heap, so a program can say
// where its own regions start. It used to be the text's byte count; the text
// has moved and the records have taken its place, so the number changed and
// the contract did not.
//
//   view u8[myBytes] mine = _heap[textHeap]
//
// `npm run memory` reports a view over `_heap` as a claim rather than an alias
// precisely so this addition can be checked rather than asserted.
const textHeap = maxUndo * 7

// The undo log records edits rather than storage: what was done and where, never
// which chunk it landed in. Reversal goes back through the ordinary operations,
// so there is no inverse of anything here - only the other one of a pair.
local const opInsert = 1
local const opDelete = 2
local const opSplit  = 3
local const opJoin   = 4

// `joinPrev` says this entry is part of the same *user* action as the one
// before it. Typing thirty characters is thirty entries and one step back,
// because an editor where undo means "one character" is one nobody uses.
//
// The run is kept as marked entries rather than as a count on one entry
// because redo has to put the characters back, and a single entry with a
// count has nowhere to keep them.
// Views over the heap for the same reason the records are: a group's fields are
// storage, and at this size that is kilobytes of zeros in the `.COM` for capacity
// nobody has used yet. **The principle the move settled: capacity lives in the
// heap and code lives in the image.**
local const logAt = 0

local view u8[maxUndo]  logOp   = _heap[logAt]
local view u16[maxUndo] logLine = _heap[logAt + maxUndo]
local view u16[maxUndo] logCol  = _heap[logAt + maxUndo * 3]
local view u8[maxUndo]  logCh   = _heap[logAt + maxUndo * 5]
local view bool[maxUndo] logJoin = _heap[logAt + maxUndo * 6]

// A window rather than a stack that fills: when the log is full the oldest entry
// goes, because dropping the newest would mean the edit just made is the one
// that cannot be taken back.
//
// `undoCount` is how many entries the log holds and `undoDone` is how many of
// them are currently applied - so the entries above the cursor are the future,
// which is the whole of redo. A fresh edit throws that future away, because
// there is no longer one history to be at a point in.
local u16 undoHead
local u16 undoCount
local u16 undoDone

// Set by `undoBreak` and cleared by the next push. Only the caller knows that
// the cursor moved, or that a file was opened, or that anything else happened
// between two keystrokes that should stop them being one action - so the run is
// broken from outside rather than guessed at from in here.
local bool breakRun

// A **group** is the caller going further than that and saying several edits
// are one action: a selection deleted across three lines, a paste that replaces
// what was there. `continuesRun` can see the shapes typing makes and cannot see
// a command, so the command says so - and it says so through §48's bracket, so
// the close cannot be forgotten.
//
// It counts rather than nests. A group inside a group is part of the outer one,
// because a paste that deletes a selection first is one thing a person did.
local u16 stepDepth

// A group longer than the log can hold is not recorded at all. `stepLost` stops
// the rest of it going in on top of a log that has already been emptied, and
// `undoLost` is what a caller asks afterwards.
local bool stepLost
local bool undoLost

// Suspended while an undo runs, or the reversal would push its own entry and the
// log would never drain. `textLoad` suspends it too.
local bool undoing

// **Which limit stopped it**, because "does not fit in the buffer" has now been
// the wrong half of the answer twice. A file that ran out of *lines* and one
// that ran out of *bytes* want different things done about them - a bigger
// `textMaxLines` and a bigger `maxChunks` are separate numbers - and a person
// told only that it did not fit cannot tell which they are looking at.
const whyNothing = 0
const whyChunks  = 1
const whyLines   = 2
const whyBlock   = 3

local u8 whyNoRoom

// Set the moment an edit could not get the chunk or the line it needed, and
// cleared only by `textInit`. Every refusal below leaves the buffer unchanged
// rather than half changed, which is the right behaviour and is also silent -
// so a program that reads a file in has no way to tell a file that fitted from
// one that stopped part way, and would save the truncation back over it.
local bool noRoom

// Where the last undo acted. An editor has to put the cursor back, and the entry
// is the only thing that knows: the caller cannot work it out afterwards,
// because the edit it is looking at has already been reversed.
local u16 undoAtLine
local u16 undoAtCol

// lineSeek answers three things and a routine returns one. `seekPrev` is 0 when
// the chunk found is the line's head, and it exists because unlinking a chunk
// needs the one before it - which a forward chain only knows while walking.
local u16 seekChunk
local u16 seekOff
local u16 seekPrev

// ---- the free list ----

local u16 chunkTake() {
  u16 c

  if ( chunkFree != 0 ) {
    c = chunkFree
    chunkFree = chunkNext[c]
  } else if ( chunkHigh < chunkLimit ) {
    c = chunkHigh
    chunkHigh++
  } else {
    return 0
  }

  chunkNext[c] = 0
  chunkUsed[c] = 0
  return c
}

local sub chunkGive( u16 c ) {
  chunkUsed[c] = 0
  chunkNext[c] = chunkFree
  chunkFree = c
}

// Whether the last operation had a chunk to work with. An edit that could not
// take one leaves the buffer unchanged rather than half changed, so a caller
// that never asks is wrong rather than unlucky.
bool textFull() => chunkFree == 0 && chunkHigh >= chunkLimit

// ---- seeking ----

// The chunk holding column `col` of line `ln`, and the offset within it. A
// column exactly on a chunk boundary stays at the end of the earlier chunk,
// which is what makes an append fill a chunk rather than start a new one.
local sub lineSeek( u16 ln, u16 col ) {
  u16 c
  u16 left
  u16 prev

  c = lineHead[ln]
  left = col
  prev = 0

  while ( left > chunkUsed[c] && chunkNext[c] != 0 ) {
    left -= chunkUsed[c]
    prev = c
    c = chunkNext[c]
  }

  // Past the end of the last chunk: clamp, so a caller appending to a line whose
  // length it got wrong writes at the end rather than off it.
  if ( left > chunkUsed[c] ) left = chunkUsed[c]

  seekChunk = c
  seekOff = left
  seekPrev = prev
}

// ---- the undo log ----

// Whether this edit continues the one before it as a single user action.
//
// Typing runs forward a column at a time. Backspace runs backward a column at
// a time. Forward Delete stays put and eats what follows, so it repeats at the
// same column. Those three are the runs worth joining and nothing else is:
// splitting a line is deliberate, and so is joining one.
local bool continuesRun( u8 op, u16 ln, u16 col ) {
  u16 at

  if ( breakRun || undoDone == 0 ) return false

  at = ( undoHead + undoDone - 1 ) % maxUndo
  if ( logLine[at] != ln || logOp[at] != op ) return false

  if ( op == opInsert ) return logCol[at] + 1 == col
  if ( op == opDelete ) return logCol[at] == col || logCol[at] == col + 1

  return false
}

local sub undoPush( u8 op, u16 ln, u16 col, u8 ch ) {
  u16 at
  bool joins

  if ( undoing ) return
  if ( stepLost ) return

  joins = continuesRun( op, ln, col )

  // Inside a group everything after the first entry joins, whatever the edits
  // look like. The first one does not, because a group starts an action rather
  // than continuing one - `undoOpen` breaks the run and that is what this reads.
  if ( stepDepth > 0 && !breakRun ) joins = true

  breakRun = false

  // Anything undone and not redone is gone the moment a new edit lands: there
  // is no longer one history for the cursor to be part way along.
  undoCount = undoDone

  if ( undoCount == maxUndo ) {
    // Dropping the oldest entry is right for a run of typing, where what goes
    // is an older action. **Inside a group it would break the group this entry
    // belongs to**, and half a group restored is a document nobody asked for -
    // so a group the log cannot hold is not recorded at all, and says so.
    if ( stepDepth > 0 ) {
      stepLost  = true
      undoLost  = true
      undoHead  = 0
      undoCount = 0
      undoDone  = 0
      return
    }

    undoHead = ( undoHead + 1 ) % maxUndo
    undoCount--
    undoDone--
  }

  at = ( undoHead + undoCount ) % maxUndo
  logOp[at]       = op
  logLine[at]     = ln
  logCol[at]      = col
  logCh[at]       = ch
  logJoin[at] = joins

  undoCount++
  undoDone++
}

// Stop the next edit joining the last one. The caller says when: a cursor that
// moved, a file that opened, a command that ran.
sub undoBreak {
  breakRun = true
}

// ---- a group of edits that are one action ----
//
//   undoStep {
//     rangeDelete( ... )
//     rangeInsert( ... )
//   }
//
// §48's bracket, declared here because this file owns both halves. A command
// that opened one and forgot to close it would put every edit after it into the
// same action for the rest of the session, which is exactly the shape §48 is
// for - the compiler emits the close.

sub undoOpen {
  if ( stepDepth == 0 ) {
    breakRun = true
    stepLost = false
    undoLost = false
  }

  stepDepth++
}

sub undoClose {
  if ( stepDepth > 0 ) stepDepth--

  if ( stepDepth == 0 ) {
    breakRun = true
    stepLost = false
  }
}

// The two halves are public because the bracket expands to calls on them at the
// use site, which is in another file. **The bracket is the way to use them** -
// an open without a close would put every edit for the rest of the session into
// one action, which is the failure §48 exists to remove.
bracket undoStep = undoOpen / undoClose

// Whether the group that just closed was longer than the log can hold, which is
// the one way an edit here happens and cannot be taken back. A caller that never
// asks is the bug this exists to make findable - the same call `textNoRoom`
// makes about a buffer that would not fit a file.
bool textUndoLost() => undoLost

// Steps back and steps forward available, counted in entries rather than in
// user actions - a run reports as its length and takes one keystroke to undo.
u16 textUndos() => undoDone
u16 textRedos() => undoCount - undoDone

// Whether anything has been refused for want of space since `textInit`. A
// caller that never asks is the bug this exists to make findable.
bool textNoRoom() => noRoom

// One of `whyChunks`, `whyLines` or `whyBlock`, which are three different
// problems with three different answers.
u8 textWhyNoRoom() => whyNoRoom

// How many lines this machine had room for, beside `textRoom` for the chunks.
u16 textLineRoom() => lineLimit

u16 undoLine() => undoAtLine
u16 undoCol() => undoAtCol

// ---- writing ----

// Move the upper half of a full chunk into a fresh one and link it in. Half a
// chunk moves, once per half a chunk of insertions, which is a constant per
// character rather than anything that grows.
local sub chunkSplit( u16 c ) {
  u16 d

  d = chunkTake()
  if ( d == 0 ) {
    noRoom = true
    whyNoRoom = whyChunks
    return
  }

  atSrc( c )
  atDst( d )

  for ( u16 i = 0; i < chunkSize - halfChunk; i++ ) {
    dst[i] = src[ halfChunk + i ]
  }

  chunkUsed[d] = chunkSize - halfChunk
  chunkNext[d] = chunkNext[c]
  chunkUsed[c] = halfChunk
  chunkNext[c] = d
}

sub lineInsert( u16 ln, u16 col, u8 ch ) {
  u16 c
  u16 off
  u16 d

  if ( ln >= lineCount ) return

  lineSeek( ln, col )
  c = seekChunk
  off = seekOff

  if ( chunkUsed[c] == chunkSize ) {
    if ( off == chunkSize && chunkNext[c] == 0 ) {
      // Appending past the end of a full last chunk. Splitting here would leave
      // both halves half empty and do it again half a chunk later, so a file
      // read in character by character would occupy twice the buffer it needs.
      // Link a fresh chunk instead and fill it.
      d = chunkTake()
      if ( d == 0 ) {
        noRoom = true
        whyNoRoom = whyChunks
        return
      }

      chunkNext[c] = d
      c = d
      off = 0
    } else {
      chunkSplit( c )
      if ( chunkUsed[c] == chunkSize ) return    // chunkSplit set noRoom

      // The split moved the upper half away, so the position may have gone too.
      if ( off > chunkUsed[c] ) {
        off -= chunkUsed[c]
        c = chunkNext[c]
      }
    }
  }

  atDst( c )
  for ( u16 i = chunkUsed[c]; i > off; i-- ) {
    dst[i] = dst[ i - 1 ]
  }

  dst[off] = ch
  chunkUsed[c]++
  lineLen[ln]++

  undoPush( opInsert, ln, col, ch )
}

sub lineAppend( u16 ln, u8 ch ) => lineInsert( ln, lineLen[ln], ch )

// After a deletion has left `c` short, fold the chunk after it in if the two
// together fit, and drop `c` out of the chain if it has emptied with nothing to
// fold.
//
// The floor is the reason for it: after a fold no adjacent pair can sum to a
// chunk or less, so a line cannot drift below half occupancy however long the
// session runs. Splitting alone has no such floor - it only ever adds chunks -
// so without this a buffer degrades until the file is reloaded.
//
// Redistribution is deliberately absent. A short chunk beside a full one stays
// short, which the floor tolerates, and borrowing would buy a better constant
// for a second policy to get wrong.
local sub chunkMerge( u16 ln, u16 c, u16 prev ) {
  u16 d
  u16 at
  u16 n

  d = chunkNext[c]

  if ( d != 0 && chunkUsed[c] + chunkUsed[d] <= chunkSize ) {
    atSrc( d )
    atDst( c )
    at = chunkUsed[c]
    n  = chunkUsed[d]

    for ( u16 i = 0; i < n; i++ ) {
      dst[ at + i ] = src[i]
    }

    chunkUsed[c] = at + n
    chunkNext[c] = chunkNext[d]
    chunkGive( d )
    return
  }

  // Empty, with nothing to fold into it. Unlink it - unless it is all the line
  // has, because a line always owns at least one chunk even when it is blank.
  if ( chunkUsed[c] == 0 && ( prev != 0 || chunkNext[c] != 0 ) ) {
    if ( prev == 0 ) {
      lineHead[ln] = chunkNext[c]
    } else {
      chunkNext[prev] = chunkNext[c]
    }
    chunkGive( c )
  }
}

sub lineDelete( u16 ln, u16 col ) {
  u16 c
  u16 prev
  u16 off
  u16 n
  u8  gone

  if ( ln >= lineCount || col >= lineLen[ln] ) return

  lineSeek( ln, col )
  c    = seekChunk
  off  = seekOff
  prev = seekPrev

  // A seek that stopped at the end of a chunk means the character wanted is the
  // first of the next one. Insertion wants the earlier chunk and deletion the
  // later, which is the one place the two disagree about the same position.
  //
  // A loop rather than the single step it looks like, because a chunk holding
  // nothing satisfies the same condition and there may be a run of them. Getting
  // this wrong is not a missed character: `used` goes to 255 on the decrement
  // below and the line then reports a chunk of whatever the heap holds next.
  while ( off == chunkUsed[c] && chunkNext[c] != 0 ) {
    prev = c
    c = chunkNext[c]
    off = 0
  }

  // Unreachable while the merge keeps empty chunks out of a chain, which is
  // exactly why it is written down: the merge is a policy and this is the
  // invariant it happens to maintain.
  if ( chunkUsed[c] == 0 ) return

  atDst( c )
  n    = chunkUsed[c]
  gone = dst[off]

  // Read before the push rather than inside it: the window has to still be on
  // this chunk when the shift below runs, and a call in between is where that
  // stops being obvious.
  undoPush( opDelete, ln, col, gone )

  for ( u16 i = off; i + 1 < n; i++ ) {
    dst[i] = dst[ i + 1 ]
  }

  chunkUsed[c]--
  lineLen[ln]--

  if ( chunkUsed[c] < halfChunk ) chunkMerge( ln, c, prev )
}

// Enter. The chunk under the cut is divided, its tail becomes the head of a new
// chain, and the line records below shift by one. No text moves beyond the one
// chunk being cut.
sub lineSplit( u16 ln, u16 col ) {
  u16 c
  u16 off
  u16 d
  u16 tail

  if ( ln >= lineCount || lineCount >= lineLimit ) return

  lineSeek( ln, col )
  c = seekChunk
  off = seekOff

  d = chunkTake()
  if ( d == 0 ) {
    noRoom = true
    whyNoRoom = whyChunks
    return
  }

  atSrc( c )
  atDst( d )

  for ( u16 i = 0; i < chunkUsed[c] - off; i++ ) {
    dst[i] = src[ off + i ]
  }

  chunkUsed[d] = chunkUsed[c] - off
  chunkNext[d] = chunkNext[c]
  chunkUsed[c] = off
  chunkNext[c] = 0

  for ( u16 i = lineCount; i > ln + 1; i-- ) {
    lineHead[i]   = lineHead[i - 1]
    lineLen[i] = lineLen[i - 1]
  }

  tail = lineLen[ln] - col
  lineLen[ln] = col
  lineHead[ln + 1]   = d
  lineLen[ln + 1] = tail
  lineCount++

  undoPush( opSplit, ln, col, 0 )
}

// Join the line below onto this one: its chain links on the end and the records
// close up. The inverse of lineSplit, and wanted by backspace at column 0 quite
// as much as by undo - which is the argument for undo going back through the
// ordinary operations rather than owning reversals of its own.
sub lineJoin( u16 ln ) {
  u16 c

  if ( ln + 1 >= lineCount ) return

  // Recorded before the join, because afterwards the column it happened at is
  // the one thing nothing can recover. Backspace at column 0 is a join, and an
  // edit that cannot be taken back is worse than one that is slow.
  undoPush( opJoin, ln, lineLen[ln], 0 )

  c = lineHead[ln]
  while ( chunkNext[c] != 0 ) {
    c = chunkNext[c]
  }

  chunkNext[c] = lineHead[ln + 1]
  lineLen[ln] += lineLen[ln + 1]

  for ( u16 i = ln + 1; i + 1 < lineCount; i++ ) {
    lineHead[i]   = lineHead[i + 1]
    lineLen[i] = lineLen[i + 1]
  }
  lineCount--
}

// One entry backwards. Every arm is an ordinary operation, which is what keeps
// this short: there is no inverse of anything here, only the other one of a
// pair.
local sub undoEntry( u16 at ) {
  undoAtLine = logLine[at]
  undoAtCol  = logCol[at]

  if ( logOp[at] == opInsert ) {
    lineDelete( logLine[at], logCol[at] )
  } else if ( logOp[at] == opDelete ) {
    lineInsert( logLine[at], logCol[at], logCh[at] )
  } else if ( logOp[at] == opSplit ) {
    lineJoin( logLine[at] )
  } else if ( logOp[at] == opJoin ) {
    lineSplit( logLine[at], logCol[at] )
  }
}

// One entry forwards - the same four operations the other way round, which is
// why redo needed no new machinery beyond remembering what was inserted.
local sub redoEntry( u16 at ) {
  undoAtLine = logLine[at]
  undoAtCol  = logCol[at]

  if ( logOp[at] == opInsert ) {
    lineInsert( logLine[at], logCol[at], logCh[at] )
  } else if ( logOp[at] == opDelete ) {
    lineDelete( logLine[at], logCol[at] )
  } else if ( logOp[at] == opSplit ) {
    lineSplit( logLine[at], logCol[at] )
  } else if ( logOp[at] == opJoin ) {
    lineJoin( logLine[at] )
  }
}

// One user action back: the entry the cursor is on, and every entry before it
// marked as continuing the same run. A `joinPrev` that is false ends it, which
// is why the first entry of a run never carries one.
sub undoOnce {
  u16 at
  bool more

  if ( undoDone == 0 ) return

  undoing = true
  more = true

  while ( more ) {
    undoDone--
    at = ( undoHead + undoDone ) % maxUndo
    undoEntry( at )
    more = logJoin[at] && undoDone > 0
  }

  breakRun = true
  undoing = false
}

// One user action forward, which is the same run read the other way: the entry
// at the cursor, and every following one marked as continuing it.
sub redoOnce {
  u16 at
  bool more

  if ( undoDone >= undoCount ) return

  undoing = true
  more = true

  while ( more ) {
    at = ( undoHead + undoDone ) % maxUndo
    redoEntry( at )
    undoDone++

    more = false
    if ( undoDone < undoCount ) {
      more = logJoin[ ( undoHead + undoDone ) % maxUndo ]
    }
  }

  breakRun = true
  undoing = false
}

// ---- reading ----

u16 textLines() => lineCount

u16 lineLength( u16 ln ) => ln < lineCount ? lineLen[ln] : 0

// `count` bytes of line `ln` from column `col`, copied to `at`. Returns how many
// were actually there. One walk of the chain however long the line is, which is
// the whole read interface: there is deliberately no "character at" call for a
// caller to put in a loop.
u16 lineSlice( u16 ln, u16 col, u16 count, u16 at ) {
  u16 c
  u16 left
  u16 done
  u16 n

  if ( ln >= lineCount ) return 0

  c = lineHead[ln]
  left = col
  done = 0

  while ( c != 0 && done < count ) {
    if ( left >= chunkUsed[c] ) {
      left -= chunkUsed[c]
    } else {
      atDst( c )
      n = chunkUsed[c] - left
      if ( n > count - done ) n = count - done

      for ( u16 i = 0; i < n; i++ ) {
        poke8( at + done + i, dst[ left + i ] )
      }

      done += n
      left = 0
    }
    c = chunkNext[c]
  }

  return done
}

// How many chunks a line occupies. A diagnostic rather than part of the model -
// it is how the occupancy floor is observed, and the test project reads it.
u16 lineChunks( u16 ln ) {
  u16 c
  u16 n

  if ( ln >= lineCount ) return 0

  c = lineHead[ln]
  n = 0
  while ( c != 0 ) {
    n++
    c = chunkNext[c]
  }
  return n
}

// ---- setting up ----

local sub lineNew {
  if ( lineCount >= lineLimit ) {
    noRoom = true
    whyNoRoom = whyLines
    return
  }

  lineHead[lineCount]   = chunkTake()
  lineLen[lineCount] = 0
  lineCount++
}

// A library has no top-level statements to run, so this is explicit - the same
// reason §43's row table is filled by a call rather than by setting a mode.
sub textInit {
  u16 room

  lineCount  = 0
  chunkFree  = 0
  chunkHigh  = 1
  chunkLimit = 0
  lineLimit  = 0
  undoHead   = 0
  undoCount  = 0
  undoDone   = 0
  undoing    = false
  breakRun   = true
  noRoom     = false
  whyNoRoom  = whyNothing
  stepDepth  = 0
  stepLost   = false
  undoLost   = false

  // The four record regions in order from the base, then the text after them.
  // Nothing is allocated here - a far region is an address - so this is where
  // the layout is decided and the only place it exists.
  recBase = blockBase()
  textBase = 0

  if ( recBase == 0 ) {
    noRoom = true
    whyNoRoom = whyBlock
    return
  }

  nextSeg  = recBase
  usedSeg  = nextSeg + nextParas
  headSeg  = usedSeg + usedParas
  lenSeg   = headSeg + headParas
  textBase = lenSeg + lenParas

  // **The capacity is what is left rather than what was asked for.** A smaller
  // machine gets a smaller buffer, which is the whole reason the consts above
  // are a ceiling: sizing the regions to the block would mean sizing them at
  // runtime, and a far region takes a constant.
  //
  // Compared rather than added, so a high base cannot wrap past the end and
  // come back looking like room - the same care `blockFits` takes.
  if ( blockEnd() <= textBase ) {
    noRoom = true
    whyNoRoom = whyBlock
    return
  }

  room = blockEnd() - textBase

  chunkLimit = maxChunks
  if ( room < chunkLimit ) chunkLimit = room

  // Chunk 0 is the null and a line needs one of its own, so two is the floor
  // below which there is no buffer rather than a small one.
  if ( chunkLimit < 2 ) {
    chunkLimit = 0
    noRoom = true
    whyNoRoom = whyBlock
    return
  }

  lineLimit = textMaxLines

  lineNew()
}

// Whether there is a buffer at all. `textNoRoom` says the same thing and more,
// so this exists only for a program that wants to tell a machine with no room
// past the segment from a file that was too big for one that had it.
bool textHasBuffer() => textBase != 0

// How many chunks this machine actually had room for, which is `textChunks`
// on anything with a normal amount of conventional memory and less on the
// rest. A program showing a capacity should show this one.
u16 textRoom() => chunkLimit

// One character of a file being read in. A newline starts a line, anything else
// appends. **Records no undo**: reading a file in is not an edit anybody wants
// to step back through, and a log full of the file would leave no room for the
// session.
sub textLoad( u8 ch ) {
  undoing = true

  if ( ch == '\n' ) {
    lineNew()
  } else if ( ch != '\r' ) {
    lineAppend( lineCount - 1, ch )
  }

  undoing = false
}

// ---- writing it out ----

// DOS convention, and `textLoad` skips the carriage return on the way back in,
// so a file written here reloads to exactly the buffer that wrote it.
local const u8[] lineEnd = "\r\n"

// **DOS writes from `DS:DX` (§38) and the text is no longer in `DS`**, so it
// has to come back through our own segment on the way out. Which is a better
// arrangement than the one it replaced rather than a worse one: this file's
// first version handed DOS one chunk at a time, so a save was an interrupt per
// sixteen bytes.
local const stageBytes = 512
local u8[stageBytes] stage

// The whole buffer to an already-open handle, returning the bytes written. The
// handle is the caller's: this knows how a buffer is shaped and nothing about
// where a file came from.
//
// **A newline goes between lines and not after the last**, which is what makes
// the round trip exact. A file ending in one loads as a final empty line, so
// writing separators reproduces the trailing newline without a rule about it.
//
// Each chunk is handed to DOS where it already lies, so nothing is copied on the
// way out - which is the whole reason this routine is in this file.
u16 textSave( u16 handle ) {
  u16 total
  u16 col
  u16 n

  total = 0

  for ( u16 ln = 0; ln < lineCount; ln++ ) {
    col = 0
    n = lineSlice( ln, col, stageBytes, addr( stage ) )

    while ( n > 0 ) {
      total += fileWrite( handle, addr( stage ), n )
      col += n
      n = lineSlice( ln, col, stageBytes, addr( stage ) )
    }

    if ( ln + 1 < lineCount ) total += fileWrite( handle, addr( lineEnd ), 2 )
  }

  return total
}
