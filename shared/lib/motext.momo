// motext.momo - the text buffer an editor edits (DESIGN §54, §58).
//
// A line is a chain of chunks and the chunks are deliberately not kept full, so
// an insert moves bytes inside one chunk and touches nothing else. A chunk that
// fills splits in half and both halves have room again; a deletion that leaves
// one short folds the next into it, which puts a floor under occupancy. Every
// edit is bounded by a chunk rather than by the document, and a line has no
// length limit.
//
// It is this shape because of one measurement. There are no string instructions
// (§1), so moving a byte costs seventeen and a gap buffer would take about
// 0.6 seconds to move a 16 KB gap. Nothing here moves bulk text: a split moves
// half a chunk, a merge moves at most one, and an insert moves part of one.
//
// **The text lives past our own segment** (§58), in the block DOS gave us, and a
// chunk is addressed as a *paragraph* rather than as an offset - both are sixteen
// bytes, so chunk `c` is the paragraph `c` past the base and no index ever has to
// hold more than one chunk.
//
// **Everything followed it out.** The chunk links, the line tables and the undo
// log were views over the heap the text had vacated - which was right while the
// heap was where the room was, and stopped being right as each one grew. They are
// all past the segment now, laid out by `textInit` from the block DOS gave us.
//
// Nothing of any of it is in the image, which is the rule the first move settled
// and the second kept: **capacity lives past the segment and the image is for
// code.** An ordinary array is emitted as `times N db 0` and puts every byte of
// capacity into the `.COM`; a `far` region emits nothing at all.
//
// **So this library claims no heap**, and `textHeap` is zero. It is still what a
// program writes to say where its own partitioning starts (§17), and it still
// means the same thing - there is simply nothing in front of it any more.
//
// **The caller never indexes a chunk.** Reading is `lineSlice`, which walks the
// chain once and copies out. That is the rule the piece-table draft produced and
// it holds here too: the chain is walked once per line, never once per character.
//
// **`textSave` is here on an argument that has since reversed.** It used to be
// here because it handed DOS each chunk where it already lay, which needed
// everything private in this file. §58 put the chunks somewhere DOS cannot be
// pointed at, so it stages through a buffer in our own segment and now needs
// nothing but `lineSlice`. It stays because `textLoad` cannot leave - that one
// does need the privates - and splitting a file's two halves across two libraries
// is worse than the inconsistency. §11 prunes the include either way.

include "lib/std/file.momo"
include "lib/std/block.momo"

// ---- capacity ----
//
// Sized by consts here, the way momolo sizes `maxElements`. **These are the
// ceiling rather than the demand**: a far region emits no storage, so a size
// here costs nothing until a chunk is actually handed out, and `textInit` caps
// what it hands out at whatever the machine turned out to have. A smaller
// machine gets a smaller buffer rather than no editor.
//
// **`maxChunks` may not pass 32,767.** The link array is `u16` per chunk and a
// far region is reached at a `u16` offset, so twice this has to fit one - which
// is the one relationship here that is arithmetic rather than judgement.

local const chunkSize = 16
local const halfChunk = chunkSize / 2
// **Bounded by addressing, not by taste.** `chunkNext` is a `u16` per chunk in a
// far region, and a far region is reached at a `u16` offset - so more than 32,767
// chunks is two bytes each of somewhere this cannot point at. What a machine
// actually gets is worked out in `textInit` and is usually less.
local const maxChunks = 32000
local const maxUndo   = 2048

// **More than one document, sharing one chunk store.**
//
// Every region here is either *per document* - the line tables and the undo log
// - or *shared* - the chunks, their links and the free list. Splitting the chunks
// would divide the capacity between documents whether they were using it or not;
// sharing means a chunk belongs to whichever line points at it and the free list
// never learns there is more than one.
//
// **What a document costs even while empty** is its line tables and its log:
// 3,000 paragraphs for 12,000 lines of each table and 896 for the log, so about
// 62 KB. That is not free and the number says so - on a 577 KB machine the
// shared chunk store goes 27,800 for one document, 24,500 for two, 18,000 for
// four.
//
// **Two**, because two is what the feature is for: moving text between a pair of
// files. The third and fourth are a convenience costing a quarter of the buffer,
// which is the wrong trade on this machine and may be the right one on a bigger
// one - so it is a const, and the arithmetic to redo is written above it.
//
// The line tables are what dominates, not the log. Anybody raising this should
// look at `textMaxLines` first.
local const maxDocs = 2

// **Chunks rather than bytes**, because the byte count no longer fits a `u16` -
// which is the whole of what moving past the segment bought. A program that
// wants to know the capacity in bytes multiplies, in whatever width it likes.
// **Public because a test has had to chase it twice.** A group longer than the
// log is a case worth covering and the fixture that covers it has to be sized
// against this number, so the number is readable rather than copied.
const textUndoMax  = maxUndo
const textMaxLines = 12000
const textMaxDocs  = maxDocs
const textChunks   = maxChunks
const textChunkSize = chunkSize

// ---- storage ----

// **The text lives past our own segment**, in the block DOS gave us (§47), and
// the chunks are addressed by *segment* rather than by offset: a chunk is
// sixteen bytes and so is a paragraph, so chunk `c` is the paragraph `c` past
// the base. That is why there is no offset arithmetic below and no 64 KB cap
// above - the index never has to hold more than one chunk, so `maxChunks` is
// bounded by the block and by the records, not by what a `u16` can reach.
//
// **Two windows, because a split and a merge copy between two chunks.** One
// would mean changing the segment between every read and its write.
//
// §16 reloads ES per access and never hoists a runtime segment, which is
// exactly what makes this safe and is also what it costs: about eighteen cycles
// for every byte actually touched. Nothing here touches more than a chunk at a
// time, which is the whole reason the argument that refused far memory stopped
// being true - it was pricing a buffer nobody had built yet.
local u16 textBase
local u16 srcSeg
local u16 dstSeg

// **The records followed the text out.** They were views over the heap, which
// cost the image nothing and cost the *segment* three bytes a chunk and four a
// line - so the ceiling stopped being the text and became a table describing
// it. Past the segment there is no table to run out of.
//
// Four regions rather than one, because each is reached at a `u16` offset and
// together they are more than 64 KB. They are laid out in order from the base
// and the text starts after them, which is the whole of the arithmetic.
// The line tables are the only fixed-size regions, because `textMaxLines` is a
// constant and the chunk count is not. The two per-chunk records are laid out
// from what the machine turns out to have - see `textInit`.
local const headParas = ( textMaxLines * 2 ) / chunkSize
local const lenParas  = ( textMaxLines * 2 ) / chunkSize

local u16 recBase
local u16 nextSeg
local u16 usedSeg
local u16 headSeg
local u16 lenSeg

// **A document is these variables**, and switching is copying them out and the
// next one in. The alternative - indexing every access by a document number -
// would put an add on the hot path of a buffer whose whole design is about what
// an edit costs, to save about forty bytes of copying on a keystroke nobody
// presses in a loop.
//
// Seven segments and a dozen scalars, which is the whole of what a document is.
// Everything not in here is shared on purpose.
local u16[maxDocs] docHeadSeg
local u16[maxDocs] docLenSeg
local u16[maxDocs] docLogOp
local u16[maxDocs] docLogLine
local u16[maxDocs] docLogCol
local u16[maxDocs] docLogCh
local u16[maxDocs] docLogJoin

local u16[maxDocs] docLines
local u16[maxDocs] docLineLimit
local u16[maxDocs] docUndoHead
local u16[maxDocs] docUndoCount
local u16[maxDocs] docUndoDone
local u8[maxDocs]  docBreakRun
local u8[maxDocs]  docUndoLost
local u8[maxDocs]  docNoRoom
local u8[maxDocs]  docWhyNoRoom

local u16 curDoc

local far u8[chunkSize] src = srcSeg
local far u8[chunkSize] dst = dstSeg

// **The window is set immediately before it is used**, and nothing between the
// two calls out to anything that could move it. That is the one rule this
// arrangement adds and the one way it can go quietly wrong.
local sub atDst( u16 c ) {
  dstSeg = textBase + c
}

local sub atSrc( u16 c ) {
  srcSeg = textBase + c
}

// Chunk 0 is the null, so `next == 0` ends a chain and no real chunk is 0. A
// chunk's bytes are at `c * chunkSize`, and there is no table of addresses
// because `chunkSize` is a power of two and §26 folds the multiply to a shift.
// A table would be right if the stride were imposed, as §43's is; here it is
// ours to choose, so it is chosen to need no table.
// **Regions, not arrays**, and not a `group` either - which is a loss worth
// naming. §52 exists so a record can be read as a row, and §18 lays a group out
// as parallel arrays anyway, so what changes here is only the source form. What
// forces it is that a group's fields are storage: they would be emitted as
// `times N db 0` and put every byte of capacity into the `.COM`, which at this
// size is tens of kilobytes of zeros on disk.
//
// They were views over the heap for one step, which is what the text vacated by
// leaving. Then they outgrew that too, and followed it.
local far u16[maxChunks] chunkNext = nextSeg
local far u8[maxChunks]  chunkUsed = usedSeg

// **A high-water mark and a list of what came back**, which is what removes the
// walk that used to thread every chunk onto a free list at startup. At this
// capacity that walk is twenty-four thousand far writes, and a far write is not
// a near one - it is about a second on a 4.77 MHz machine, spent building a
// list that a counter describes for nothing.
//
// `chunkHigh` is the lowest chunk never handed out; `chunkFree` is the head of
// the returned ones. Taking prefers the returned list, so a long session reuses
// rather than climbing.
local u16 chunkHigh
local u16 chunkFree

// How many are out on loan. Two instructions, and it makes the invariant this
// file most depends on into something a test can read: **what a document gives
// back has to equal what it took**. Nothing could see that before, which is how
// `textClear` came to keep the chunks it emptied.
local u16 chunkLive

// What the machine actually had room for, which is not what the consts above
// declare. Set by `textInit` from the block DOS gave us.
local u16 chunkLimit
local u16 lineLimit

local far u16[textMaxLines] lineHead = headSeg
local far u16[textMaxLines] lineLen  = lenSeg
local u16 lineCount

// What this library claims at the bottom of the heap, so a program can say
// where its own regions start. It used to be the text's byte count; the text
// has moved and the records have taken its place, so the number changed and
// the contract did not.
//
//   view u8[myBytes] mine = _heap[textHeap]
//
// `npm run memory` reports a view over `_heap` as a claim rather than an alias
// precisely so this addition can be checked rather than asserted.
// **Zero, because this library no longer claims any.** The undo log was the last
// thing it kept inside the segment and is past it now, so a program that includes
// this gets the whole heap. The name stays: it is what callers write, and what it
// means - *where yours starts* - has not changed.
const textHeap = 0

// The undo log records edits rather than storage: what was done and where, never
// which chunk it landed in. Reversal goes back through the ordinary operations,
// so there is no inverse of anything here - only the other one of a pair.
local const opInsert = 1
local const opDelete = 2
local const opSplit  = 3
local const opJoin   = 4

// `joinPrev` says this entry is part of the same *user* action as the one
// before it. Typing thirty characters is thirty entries and one step back,
// because an editor where undo means "one character" is one nobody uses.
//
// The run is kept as marked entries rather than as a count on one entry
// because redo has to put the characters back, and a single entry with a
// count has nowhere to keep them.
// **Past the segment, like the text and the records.** It was views over the
// heap, on the principle that capacity lives in the heap and code lives in the
// image - which was right while there was heap to live in, and stopped being so
// when this was the last large thing inside 64 KB. Fourteen kilobytes of near
// memory for a log that is written once per keystroke and read only when
// somebody presses `^Z`.
//
// The cost is five `ES` reloads on a push instead of five near writes, against a
// keystroke that `drawrate` measured in tens of milliseconds. The gain is the
// fourteen kilobytes, and that **`textHeap` is zero now** - this library claims
// no near memory at all, so a program gets the whole heap for its own.
//
// It is also what makes a second document affordable: a log each, out there,
// where there is room for them.
local const opParas   = maxUndo / chunkSize
local const lineParas = ( maxUndo * 2 ) / chunkSize
local const logParas  = opParas * 3 + lineParas * 2

local u16 logOpSeg
local u16 logLineSeg
local u16 logColSeg
local u16 logChSeg
local u16 logJoinSeg

local far u8[maxUndo]  logOp   = logOpSeg
local far u16[maxUndo] logLine = logLineSeg
local far u16[maxUndo] logCol  = logColSeg
local far u8[maxUndo]  logCh   = logChSeg
local far u8[maxUndo]  logJoin = logJoinSeg

// A window rather than a stack that fills: when the log is full the oldest entry
// goes, because dropping the newest would mean the edit just made is the one
// that cannot be taken back.
//
// `undoCount` is how many entries the log holds and `undoDone` is how many of
// them are currently applied - so the entries above the cursor are the future,
// which is the whole of redo. A fresh edit throws that future away, because
// there is no longer one history to be at a point in.
local u16 undoHead
local u16 undoCount
local u16 undoDone

// Set by `undoBreak` and cleared by the next push. Only the caller knows that
// the cursor moved, or that a file was opened, or that anything else happened
// between two keystrokes that should stop them being one action - so the run is
// broken from outside rather than guessed at from in here.
local bool breakRun

// A **group** is the caller going further than that and saying several edits
// are one action: a selection deleted across three lines, a paste that replaces
// what was there. `continuesRun` can see the shapes typing makes and cannot see
// a command, so the command says so - and it says so through §48's bracket, so
// the close cannot be forgotten.
//
// It counts rather than nests. A group inside a group is part of the outer one,
// because a paste that deletes a selection first is one thing a person did.
local u16 stepDepth

// A group longer than the log can hold is not recorded at all. `stepLost` stops
// the rest of it going in on top of a log that has already been emptied, and
// `undoLost` is what a caller asks afterwards.
local bool stepLost
local bool undoLost

// Suspended while an undo runs, or the reversal would push its own entry and the
// log would never drain. `textLoad` suspends it too.
local bool undoing

// **Which limit stopped it**, because "does not fit in the buffer" has now been
// the wrong half of the answer twice. A file that ran out of *lines* and one
// that ran out of *bytes* want different things done about them - a bigger
// `textMaxLines` and a bigger `maxChunks` are separate numbers - and a person
// told only that it did not fit cannot tell which they are looking at.
const whyNothing = 0
const whyChunks  = 1
const whyLines   = 2
const whyBlock   = 3

local u8 whyNoRoom

// Set the moment an edit could not get the chunk or the line it needed, and
// cleared only by `textInit`. Every refusal below leaves the buffer unchanged
// rather than half changed, which is the right behaviour and is also silent -
// so a program that reads a file in has no way to tell a file that fitted from
// one that stopped part way, and would save the truncation back over it.
local bool noRoom

// Where the last undo acted. An editor has to put the cursor back, and the entry
// is the only thing that knows: the caller cannot work it out afterwards,
// because the edit it is looking at has already been reversed.
local u16 undoAtLine
local u16 undoAtCol

// lineSeek answers three things and a routine returns one. `seekPrev` is 0 when
// the chunk found is the line's head, and it exists because unlinking a chunk
// needs the one before it - which a forward chain only knows while walking.
local u16 seekChunk
local u16 seekOff
local u16 seekPrev

// ---- the free list ----

local u16 chunkTake() {
  u16 c

  if ( chunkFree != 0 ) {
    c = chunkFree
    chunkFree = chunkNext[c]
  } else if ( chunkHigh < chunkLimit ) {
    c = chunkHigh
    chunkHigh++
  } else {
    return 0
  }

  chunkNext[c] = 0
  chunkUsed[c] = 0
  chunkLive++
  return c
}

local sub chunkGive( u16 c ) {
  chunkUsed[c] = 0
  chunkNext[c] = chunkFree
  chunkFree = c
  chunkLive--
}

// Every chunk of a line back, head included. **This did not exist while
// `textClear` was only ever reached from `textInit`**, where the allocator is
// reset wholesale a few lines later and a walk would have been invisible - so a
// clear that kept its chunks looked exactly like one that gave them up.
//
// A file open calls `textClear` now, and without this an editor would lose the
// store one file at a time: open a large file twice and the second one has
// nowhere to go, with nothing on screen to say why.
local sub lineDrop( u16 ln ) {
  u16 c
  u16 next

  c = lineHead[ln]

  while ( c != 0 ) {
    next = chunkNext[c]
    chunkGive( c )
    c = next
  }

  lineHead[ln] = 0
}

// Whether the last operation had a chunk to work with. An edit that could not
// take one leaves the buffer unchanged rather than half changed, so a caller
// that never asks is wrong rather than unlucky.
bool textFull() => chunkFree == 0 && chunkHigh >= chunkLimit

// ---- seeking ----

// The chunk holding column `col` of line `ln`, and the offset within it. A
// column exactly on a chunk boundary stays at the end of the earlier chunk,
// which is what makes an append fill a chunk rather than start a new one.
local sub lineSeek( u16 ln, u16 col ) {
  u16 c
  u16 left
  u16 prev

  c = lineHead[ln]
  left = col
  prev = 0

  while ( left > chunkUsed[c] && chunkNext[c] != 0 ) {
    left -= chunkUsed[c]
    prev = c
    c = chunkNext[c]
  }

  // Past the end of the last chunk: clamp, so a caller appending to a line whose
  // length it got wrong writes at the end rather than off it.
  if ( left > chunkUsed[c] ) left = chunkUsed[c]

  seekChunk = c
  seekOff = left
  seekPrev = prev
}

// ---- the undo log ----

// Whether this edit continues the one before it as a single user action.
//
// Typing runs forward a column at a time. Backspace runs backward a column at
// a time. Forward Delete stays put and eats what follows, so it repeats at the
// same column. Those three are the runs worth joining and nothing else is:
// splitting a line is deliberate, and so is joining one.
local bool continuesRun( u8 op, u16 ln, u16 col ) {
  u16 slot

  if ( breakRun || undoDone == 0 ) return false

  slot = ( undoHead + undoDone - 1 ) % maxUndo
  if ( logLine[slot] != ln || logOp[slot] != op ) return false

  if ( op == opInsert ) return logCol[slot] + 1 == col
  if ( op == opDelete ) return logCol[slot] == col || logCol[slot] == col + 1

  return false
}

local sub undoPush( u8 op, u16 ln, u16 col, u8 ch ) {
  u16 slot
  bool joins

  if ( undoing ) return
  if ( stepLost ) return

  joins = continuesRun( op, ln, col )

  // Inside a group everything after the first entry joins, whatever the edits
  // look like. The first one does not, because a group starts an action rather
  // than continuing one - `undoOpen` breaks the run and that is what this reads.
  if ( stepDepth > 0 && !breakRun ) joins = true

  breakRun = false

  // Anything undone and not redone is gone the moment a new edit lands: there
  // is no longer one history for the cursor to be part way along.
  undoCount = undoDone

  if ( undoCount == maxUndo ) {
    // Dropping the oldest entry is right for a run of typing, where what goes
    // is an older action. **Inside a group it would break the group this entry
    // belongs to**, and half a group restored is a document nobody asked for -
    // so a group the log cannot hold is not recorded at all, and says so.
    if ( stepDepth > 0 ) {
      stepLost  = true
      undoLost  = true
      undoHead  = 0
      undoCount = 0
      undoDone  = 0
      return
    }

    undoHead = ( undoHead + 1 ) % maxUndo
    undoCount--
    undoDone--
  }

  slot = ( undoHead + undoCount ) % maxUndo
  logOp[slot]       = op
  logLine[slot]     = ln
  logCol[slot]      = col
  logCh[slot]       = ch
  logJoin[slot] = joins ? 1 : 0

  undoCount++
  undoDone++
}

// Stop the next edit joining the last one. The caller says when: a cursor that
// moved, a file that opened, a command that ran.
sub undoBreak {
  breakRun = true
}

// ---- a group of edits that are one action ----
//
//   undoStep {
//     rangeDelete( ... )
//     rangeInsert( ... )
//   }
//
// §48's bracket, declared here because this file owns both halves. A command
// that opened one and forgot to close it would put every edit after it into the
// same action for the rest of the session, which is exactly the shape §48 is
// for - the compiler emits the close.

sub undoOpen {
  if ( stepDepth == 0 ) {
    breakRun = true
    stepLost = false
    undoLost = false
  }

  stepDepth++
}

sub undoClose {
  if ( stepDepth > 0 ) stepDepth--

  if ( stepDepth == 0 ) {
    breakRun = true
    stepLost = false
  }
}

// The two halves are public because the bracket expands to calls on them at the
// use site, which is in another file. **The bracket is the way to use them** -
// an open without a close would put every edit for the rest of the session into
// one action, which is the failure §48 exists to remove.
bracket undoStep = undoOpen / undoClose

// Whether the group that just closed was longer than the log can hold, which is
// the one way an edit here happens and cannot be taken back. A caller that never
// asks is the bug this exists to make findable - the same call `textNoRoom`
// makes about a buffer that would not fit a file.
bool textUndoLost() => undoLost

// Steps back and steps forward available, counted in entries rather than in
// user actions - a run reports as its length and takes one keystroke to undo.
u16 textUndos() => undoDone
u16 textRedos() => undoCount - undoDone

// Whether anything has been refused for want of space since `textInit`. A
// caller that never asks is the bug this exists to make findable.
bool textNoRoom() => noRoom

// One of `whyChunks`, `whyLines` or `whyBlock`, which are three different
// problems with three different answers.
u8 textWhyNoRoom() => whyNoRoom

// How many lines this machine had room for, beside `textRoom` for the chunks.
u16 textLineRoom() => lineLimit

u16 undoLine() => undoAtLine
u16 undoCol() => undoAtCol

// ---- writing ----

// Move the upper half of a full chunk into a fresh one and link it in. Half a
// chunk moves, once per half a chunk of insertions, which is a constant per
// character rather than anything that grows.
local sub chunkSplit( u16 c ) {
  u16 d

  d = chunkTake()
  if ( d == 0 ) {
    noRoom = true
    whyNoRoom = whyChunks
    return
  }

  atSrc( c )
  atDst( d )

  for ( u16 i = 0; i < chunkSize - halfChunk; i++ ) {
    dst[i] = src[ halfChunk + i ]
  }

  chunkUsed[d] = chunkSize - halfChunk
  chunkNext[d] = chunkNext[c]
  chunkUsed[c] = halfChunk
  chunkNext[c] = d
}

sub lineInsert( u16 ln, u16 col, u8 ch ) {
  u16 c
  u16 off
  u16 d

  if ( ln >= lineCount ) return

  lineSeek( ln, col )
  c = seekChunk
  off = seekOff

  if ( chunkUsed[c] == chunkSize ) {
    if ( off == chunkSize && chunkNext[c] == 0 ) {
      // Appending past the end of a full last chunk. Splitting here would leave
      // both halves half empty and do it again half a chunk later, so a file
      // read in character by character would occupy twice the buffer it needs.
      // Link a fresh chunk instead and fill it.
      d = chunkTake()
      if ( d == 0 ) {
        noRoom = true
        whyNoRoom = whyChunks
        return
      }

      chunkNext[c] = d
      c = d
      off = 0
    } else {
      chunkSplit( c )
      if ( chunkUsed[c] == chunkSize ) return    // chunkSplit set noRoom

      // The split moved the upper half away, so the position may have gone too.
      if ( off > chunkUsed[c] ) {
        off -= chunkUsed[c]
        c = chunkNext[c]
      }
    }
  }

  atDst( c )
  for ( u16 i = chunkUsed[c]; i > off; i-- ) {
    dst[i] = dst[ i - 1 ]
  }

  dst[off] = ch
  chunkUsed[c]++
  lineLen[ln]++

  undoPush( opInsert, ln, col, ch )
}

sub lineAppend( u16 ln, u8 ch ) => lineInsert( ln, lineLen[ln], ch )

// After a deletion has left `c` short, fold the chunk after it in if the two
// together fit, and drop `c` out of the chain if it has emptied with nothing to
// fold.
//
// The floor is the reason for it: after a fold no adjacent pair can sum to a
// chunk or less, so a line cannot drift below half occupancy however long the
// session runs. Splitting alone has no such floor - it only ever adds chunks -
// so without this a buffer degrades until the file is reloaded.
//
// Redistribution is deliberately absent. A short chunk beside a full one stays
// short, which the floor tolerates, and borrowing would buy a better constant
// for a second policy to get wrong.
local sub chunkMerge( u16 ln, u16 c, u16 prev ) {
  u16 d
  u16 base
  u16 n

  d = chunkNext[c]

  if ( d != 0 && chunkUsed[c] + chunkUsed[d] <= chunkSize ) {
    atSrc( d )
    atDst( c )
    base = chunkUsed[c]
    n  = chunkUsed[d]

    for ( u16 i = 0; i < n; i++ ) {
      dst[ base + i ] = src[i]
    }

    chunkUsed[c] = base + n
    chunkNext[c] = chunkNext[d]
    chunkGive( d )
    return
  }

  // Empty, with nothing to fold into it. Unlink it - unless it is all the line
  // has, because a line always owns at least one chunk even when it is blank.
  if ( chunkUsed[c] == 0 && ( prev != 0 || chunkNext[c] != 0 ) ) {
    if ( prev == 0 ) {
      lineHead[ln] = chunkNext[c]
    } else {
      chunkNext[prev] = chunkNext[c]
    }
    chunkGive( c )
  }
}

sub lineDelete( u16 ln, u16 col ) {
  u16 c
  u16 prev
  u16 off
  u16 n
  u8  gone

  if ( ln >= lineCount || col >= lineLen[ln] ) return

  lineSeek( ln, col )
  c    = seekChunk
  off  = seekOff
  prev = seekPrev

  // A seek that stopped at the end of a chunk means the character wanted is the
  // first of the next one. Insertion wants the earlier chunk and deletion the
  // later, which is the one place the two disagree about the same position.
  //
  // A loop rather than the single step it looks like, because a chunk holding
  // nothing satisfies the same condition and there may be a run of them. Getting
  // this wrong is not a missed character: `used` goes to 255 on the decrement
  // below and the line then reports a chunk of whatever the heap holds next.
  while ( off == chunkUsed[c] && chunkNext[c] != 0 ) {
    prev = c
    c = chunkNext[c]
    off = 0
  }

  // Unreachable while the merge keeps empty chunks out of a chain, which is
  // exactly why it is written down: the merge is a policy and this is the
  // invariant it happens to maintain.
  if ( chunkUsed[c] == 0 ) return

  atDst( c )
  n    = chunkUsed[c]
  gone = dst[off]

  // Read before the push rather than inside it: the window has to still be on
  // this chunk when the shift below runs, and a call in between is where that
  // stops being obvious.
  undoPush( opDelete, ln, col, gone )

  for ( u16 i = off; i + 1 < n; i++ ) {
    dst[i] = dst[ i + 1 ]
  }

  chunkUsed[c]--
  lineLen[ln]--

  if ( chunkUsed[c] < halfChunk ) chunkMerge( ln, c, prev )
}

// Enter. The chunk under the cut is divided, its tail becomes the head of a new
// chain, and the line records below shift by one. No text moves beyond the one
// chunk being cut.
sub lineSplit( u16 ln, u16 col ) {
  u16 c
  u16 off
  u16 d
  u16 tail

  if ( ln >= lineCount || lineCount >= lineLimit ) return

  lineSeek( ln, col )
  c = seekChunk
  off = seekOff

  d = chunkTake()
  if ( d == 0 ) {
    noRoom = true
    whyNoRoom = whyChunks
    return
  }

  atSrc( c )
  atDst( d )

  for ( u16 i = 0; i < chunkUsed[c] - off; i++ ) {
    dst[i] = src[ off + i ]
  }

  chunkUsed[d] = chunkUsed[c] - off
  chunkNext[d] = chunkNext[c]
  chunkUsed[c] = off
  chunkNext[c] = 0

  for ( u16 i = lineCount; i > ln + 1; i-- ) {
    lineHead[i]   = lineHead[i - 1]
    lineLen[i] = lineLen[i - 1]
  }

  tail = lineLen[ln] - col
  lineLen[ln] = col
  lineHead[ln + 1]   = d
  lineLen[ln + 1] = tail
  lineCount++

  undoPush( opSplit, ln, col, 0 )
}

// Join the line below onto this one: its chain links on the end and the records
// close up. The inverse of lineSplit, and wanted by backspace at column 0 quite
// as much as by undo - which is the argument for undo going back through the
// ordinary operations rather than owning reversals of its own.
sub lineJoin( u16 ln ) {
  u16 c

  if ( ln + 1 >= lineCount ) return

  // Recorded before the join, because afterwards the column it happened at is
  // the one thing nothing can recover. Backspace at column 0 is a join, and an
  // edit that cannot be taken back is worse than one that is slow.
  undoPush( opJoin, ln, lineLen[ln], 0 )

  c = lineHead[ln]
  while ( chunkNext[c] != 0 ) {
    c = chunkNext[c]
  }

  chunkNext[c] = lineHead[ln + 1]
  lineLen[ln] += lineLen[ln + 1]

  for ( u16 i = ln + 1; i + 1 < lineCount; i++ ) {
    lineHead[i]   = lineHead[i + 1]
    lineLen[i] = lineLen[i + 1]
  }
  lineCount--
}

// One entry backwards. Every arm is an ordinary operation, which is what keeps
// this short: there is no inverse of anything here, only the other one of a
// pair.
local sub undoEntry( u16 slot ) {
  undoAtLine = logLine[slot]
  undoAtCol  = logCol[slot]

  if ( logOp[slot] == opInsert ) {
    lineDelete( logLine[slot], logCol[slot] )
  } else if ( logOp[slot] == opDelete ) {
    lineInsert( logLine[slot], logCol[slot], logCh[slot] )
  } else if ( logOp[slot] == opSplit ) {
    lineJoin( logLine[slot] )
  } else if ( logOp[slot] == opJoin ) {
    lineSplit( logLine[slot], logCol[slot] )
  }
}

// One entry forwards - the same four operations the other way round, which is
// why redo needed no new machinery beyond remembering what was inserted.
local sub redoEntry( u16 slot ) {
  undoAtLine = logLine[slot]
  undoAtCol  = logCol[slot]

  if ( logOp[slot] == opInsert ) {
    lineInsert( logLine[slot], logCol[slot], logCh[slot] )
  } else if ( logOp[slot] == opDelete ) {
    lineDelete( logLine[slot], logCol[slot] )
  } else if ( logOp[slot] == opSplit ) {
    lineSplit( logLine[slot], logCol[slot] )
  } else if ( logOp[slot] == opJoin ) {
    lineJoin( logLine[slot] )
  }
}

// One user action back: the entry the cursor is on, and every entry before it
// marked as continuing the same run. A `joinPrev` that is false ends it, which
// is why the first entry of a run never carries one.
sub undoOnce {
  u16 slot
  bool more

  if ( undoDone == 0 ) return

  undoing = true
  more = true

  while ( more ) {
    undoDone--
    slot = ( undoHead + undoDone ) % maxUndo
    undoEntry( slot )
    more = logJoin[slot] != 0 && undoDone > 0
  }

  breakRun = true
  undoing = false
}

// One user action forward, which is the same run read the other way: the entry
// at the cursor, and every following one marked as continuing it.
sub redoOnce {
  u16 slot
  bool more

  if ( undoDone >= undoCount ) return

  undoing = true
  more = true

  while ( more ) {
    slot = ( undoHead + undoDone ) % maxUndo
    redoEntry( slot )
    undoDone++

    more = false
    if ( undoDone < undoCount ) {
      more = logJoin[ ( undoHead + undoDone ) % maxUndo ] != 0
    }
  }

  breakRun = true
  undoing = false
}

// ---- reading ----

u16 textLines() => lineCount

u16 lineLength( u16 ln ) => ln < lineCount ? lineLen[ln] : 0

// `count` bytes of line `ln` from column `col`, copied to `at`. Returns how many
// were actually there. One walk of the chain however long the line is, which is
// the whole read interface: there is deliberately no "character at" call for a
// caller to put in a loop.
u16 lineSlice( u16 ln, u16 col, u16 count, a16 at ) {
  u16 c
  u16 left
  u16 done
  u16 n

  if ( ln >= lineCount ) return 0

  c = lineHead[ln]
  left = col
  done = 0

  while ( c != 0 && done < count ) {
    if ( left >= chunkUsed[c] ) {
      left -= chunkUsed[c]
    } else {
      atDst( c )
      n = chunkUsed[c] - left
      if ( n > count - done ) n = count - done

      for ( u16 i = 0; i < n; i++ ) {
        poke8( at + done + i, dst[ left + i ] )
      }

      done += n
      left = 0
    }
    c = chunkNext[c]
  }

  return done
}

// ---- display columns ----
//
// A tab is one byte and stands for the spaces up to the next multiple of a tab
// stop, so a line's bytes and the columns it covers on screen are different
// counts as soon as it holds one. **The stop is the caller's**: this knows
// characters rather than screens, and a buffer is not the place to decide how
// wide a tab is.
//
// All three reads live here rather than in the window for two reasons. Only this
// file walks a chain, and a read that went through `lineSlice` a slice at a time
// would be a second pass over every row drawn. And keeping all the tab arithmetic
// in one place is what stops the cursor and the text it sits in disagreeing about
// where a column is.

// The display column byte `col` of line `ln` starts at.
u16 lineCellOf( u16 ln, u16 col, u16 stop ) {
  u16 c
  u16 seen
  u16 cell
  u16 n

  if ( ln >= lineCount ) return 0

  c = lineHead[ln]
  seen = 0
  cell = 0

  while ( c != 0 && seen < col ) {
    atDst( c )
    n = chunkUsed[c]
    if ( n > col - seen ) n = col - seen

    for ( u16 i = 0; i < n; i++ ) {
      if ( dst[i] == 9 ) {
        cell = cell + stop - cell % stop
      } else {
        cell++
      }
    }

    seen += n
    c = chunkNext[c]
  }

  return cell
}

// The byte of line `ln` whose display span holds column `cell`: a column inside
// a tab is that tab. Past the end of the line the answer is its length, which is
// where a cursor aiming there belongs.
u16 lineColAt( u16 ln, u16 cell, u16 stop ) {
  u16 c
  u16 col
  u16 pos
  u16 w
  u16 n

  if ( ln >= lineCount ) return 0

  c = lineHead[ln]
  col = 0
  pos = 0

  while ( c != 0 ) {
    atDst( c )
    n = chunkUsed[c]

    for ( u16 i = 0; i < n; i++ ) {
      w = 1
      if ( dst[i] == 9 ) w = stop - pos % stop
      if ( pos + w > cell ) return col
      pos += w
      col++
    }

    c = chunkNext[c]
  }

  return col
}

// `cells` display columns of line `ln` from column `from`, a tab expanded to
// spaces, copied to `at`. Returns how many were written - fewer when the line
// ends first. This is `lineSlice` for a screen, and the row a window draws.
//
// **A line with no tab pays one comparison a byte for this**, which is the
// reason it is one loop rather than a slice and a second pass. Two phases, and
// the first is usually empty: up to `from` the bytes are walked rather than
// copied, and a tab straddling `from` puts its remaining spaces at the head of
// the row. After that an output position is its own display column - column
// `from + ( p - at )` - so nothing counts columns while copying, and a byte is at
// least one cell, which bounds each chunk's copy before it starts.
u16 lineCells( u16 ln, u16 from, u16 cells, u16 stop, a16 at ) {
  u16 c
  u16 i
  u16 n
  u16 w
  u16 cell
  a16 out
  a16 end
  a16 base
  u8  b

  if ( ln >= lineCount ) return 0

  c = lineHead[ln]
  i = 0
  cell = 0
  out = at
  end = at + cells

  while ( c != 0 && cell < from ) {
    atDst( c )
    n = chunkUsed[c]

    while ( i < n && cell < from ) {
      w = 1
      if ( dst[i] == 9 ) w = stop - cell % stop

      // Only a tab can straddle `from`, and what is left of it starts the row.
      if ( cell + w > from ) {
        while ( out < end && out < at + cell + w - from ) {
          poke8( out, 32 )
          out++
        }
      }

      cell += w
      i++
    }

    if ( i >= n ) {
      c = chunkNext[c]
      i = 0
    }
  }

  while ( c != 0 && out < end ) {
    atDst( c )
    n = chunkUsed[c]
    if ( n - i > end - out ) n = i + end - out

    // Byte `i` lands at `base + i` until a tab widens the row.
    base = out - i

    while ( i < n ) {
      b = dst[i]

      if ( b != 9 ) {
        poke8( base + i, b )
      } else {
        w = stop - ( from + base + i - at ) % stop
        if ( w > end - ( base + i ) ) w = end - ( base + i )

        for ( u16 k = 0; k < w; k++ ) {
          poke8( base + i + k, 32 )
        }

        base = base + w - 1

        // Fewer bytes fit now; every one left is still at least a cell.
        if ( n - i - 1 > end - ( base + i + 1 ) ) n = i + 1 + end - ( base + i + 1 )
      }

      i++
    }

    out = base + i
    c = chunkNext[c]
    i = 0
  }

  return out - at
}

// ---- what a document indents with ----
//
// A guess for an editor deciding what Tab should type: 0 for tabs, a width for
// spaces, or `fallback` when nothing in the first `lines` lines is indented.
//
// **Tabs win when more lines start with a tab than with a space.** The width is
// the step between neighbouring lines that occurs most often - not the smallest
// indent, because a C comment's ` * ` is a one-space indent in a file indented by
// four, and going a level deeper is what the file's own width actually is. Only
// the first sixteen bytes of a line are read, which is further than any step, and
// only the first `lines` lines, because a guess does not need the whole file and
// an open should not pay for one.
local const indentHeadBytes = 16

local u8[indentHeadBytes] indentHead
local u16[9] indentSteps

u8 textIndent( u16 lines, u8 fallback ) {
  u16 tabbed
  u16 spaced
  u16 last
  u16 n
  u16 s
  u16 best
  bool before

  tabbed = 0
  spaced = 0
  last = 0
  before = false

  for ( u16 w = 0; w < len( indentSteps ); w++ ) {
    indentSteps[w] = 0
  }

  for ( u16 ln = 0; ln < lines && ln < lineCount; ln++ ) {
    n = lineSlice( ln, 0, indentHeadBytes, addr( indentHead ) )

    if ( n > 0 && indentHead[0] == 9 ) {
      tabbed++
      before = false
    } else {
      s = 0
      while ( s < n && indentHead[s] == ' ' ) s++

      // A blank line, or one of nothing but spaces, says nothing about depth and
      // must not become the neighbour the next line is measured against.
      if ( s < n ) {
        if ( s > 0 ) spaced++
        if ( before && s > last && s - last < len( indentSteps ) ) indentSteps[ s - last ]++
        last = s
        before = true
      }
    }
  }

  if ( tabbed > spaced ) return 0

  // Ties go to the smaller step: in a file indented by two, a jump of four is
  // two levels at once, and nothing indented by four jumps by two.
  best = 0
  for ( u16 w = 1; w < len( indentSteps ); w++ ) {
    if ( indentSteps[w] > indentSteps[best] ) best = w
  }

  if ( best == 0 ) return fallback
  return u8( best )
}

// How many chunks a line occupies. A diagnostic rather than part of the model -
// it is how the occupancy floor is observed, and the test project reads it.
u16 lineChunks( u16 ln ) {
  u16 c
  u16 n

  if ( ln >= lineCount ) return 0

  c = lineHead[ln]
  n = 0
  while ( c != 0 ) {
    n++
    c = chunkNext[c]
  }
  return n
}

// ---- loading in bulk ----
//
// Appending a character goes `textLoad` -> `lineAppend` -> `lineInsert` ->
// `lineSeek`, and counted from the emitted assembly on 2026-09-14 that is
// **eleven far accesses and four calls for one byte**: the line length read and
// written, the line head read, the chunk's fill read three times and written,
// the chain walked, and the byte itself. One of the eleven is the byte.
//
// None of it is wasted for an *edit*, which can land anywhere. All of it is
// wasted for a load, which always lands exactly where the last one did.
//
// So the position is kept in ordinary variables for the length of a load and
// written back at the end of it:
//
//   textBulk {
//     while ( more ) textLoad( next() )
//   }
//
// **Inside the bracket nothing may read the buffer except `textLoad`.** The
// records are stale until it closes: `lineLen` and `chunkUsed` are a character
// behind for the whole load, so `lineLength` and `lineSlice` would answer from
// a character ago. Reading a file, printing a dot and the caller's own
// bookkeeping are all fine - none of them is this buffer.
//
// `textNoRoom` is fine too, and has to be: it reads an ordinary flag that the
// fast path sets directly, and a loader that cannot ask whether the buffer
// filled has to read the whole file to find out.
//
// Which is exactly why this is a bracket and not a flag - §48 emits the close,
// so the window cannot be left open by a path somebody forgot.
local bool bulking
local u16 loadChunk
local u16 loadUsed
local u16 loadLine
local u16 loadLen

local sub bulkFlush {
  chunkUsed[loadChunk] = u8( loadUsed )
  lineLen[loadLine]    = loadLen
}

// Where the next character goes: the last line, its length, and the last chunk
// of it. Costs one `lineSeek` - once a line, rather than once a character.
//
// **It reloads the far window too.** Nothing between two characters moves it, so
// the write below does not touch it; saying so here is what keeps that true if
// the newline path ever grows something that does.
local sub bulkSeed {
  loadLine = lineCount - 1
  loadLen  = lineLen[loadLine]

  lineSeek( loadLine, loadLen )
  loadChunk = seekChunk
  loadUsed  = chunkUsed[loadChunk]

  atDst( loadChunk )
}

sub bulkOpen {
  if ( lineCount == 0 ) return

  // Suspended for the whole load rather than per character, and it is belt and
  // braces: the fast path pushes no undo entry at all.
  undoing = true
  bulking = true
  bulkSeed()
}

sub bulkClose {
  if ( bulking ) bulkFlush()

  bulking = false
  undoing = false
}

bracket textBulk = bulkOpen / bulkClose

// ---- setting up ----

local sub lineNew {
  if ( lineCount >= lineLimit ) {
    noRoom = true
    whyNoRoom = whyLines
    return
  }

  lineHead[lineCount]   = chunkTake()
  lineLen[lineCount] = 0
  lineCount++
}

// A library has no top-level statements to run, so this is explicit - the same
// reason §43's row table is filled by a call rather than by setting a mode.
// Out, and in. Written as two halves rather than one swap because `textInit` has
// to load a document it never saved.
local sub docSave {
  docLines[curDoc]      = lineCount
  docLineLimit[curDoc]  = lineLimit
  docUndoHead[curDoc]   = undoHead
  docUndoCount[curDoc]  = undoCount
  docUndoDone[curDoc]   = undoDone
  docBreakRun[curDoc]   = breakRun ? 1 : 0
  docUndoLost[curDoc]   = undoLost ? 1 : 0
  docNoRoom[curDoc]     = noRoom ? 1 : 0
  docWhyNoRoom[curDoc]  = whyNoRoom
}

local sub docLoad( u16 d ) {
  headSeg    = docHeadSeg[d]
  lenSeg     = docLenSeg[d]
  logOpSeg   = docLogOp[d]
  logLineSeg = docLogLine[d]
  logColSeg  = docLogCol[d]
  logChSeg   = docLogCh[d]
  logJoinSeg = docLogJoin[d]

  lineCount  = docLines[d]
  lineLimit  = docLineLimit[d]
  undoHead   = docUndoHead[d]
  undoCount  = docUndoCount[d]
  undoDone   = docUndoDone[d]
  breakRun   = docBreakRun[d] != 0
  undoLost   = docUndoLost[d] != 0
  noRoom     = docNoRoom[d] != 0
  whyNoRoom  = docWhyNoRoom[d]

  // **Not saved and not restored**, because none of them may be live across a
  // switch: a group is closed before a command ends, a bulk load is closed by
  // its bracket, and `undoing` is only true inside a step. A document caught
  // mid-anything would be a caller doing something this cannot make safe, so
  // they are reset rather than carried.
  undoing   = false
  bulking   = false
  stepDepth = 0
  stepLost  = false
}

u16 textDoc() => curDoc

// The document `d` becomes the one every other routine here is about. Nothing
// is copied and nothing is reloaded - the text was never in this segment, so a
// switch is seven segment registers worth of numbers and a dozen counters.
sub textSwitch( u16 d ) {
  if ( d >= maxDocs ) return
  if ( d == curDoc ) return

  docSave()
  curDoc = d
  docLoad( d )
}

// Empty the document in front of us, leaving every other one alone. **This is
// what a file open wants** - `textInit` lays out the machine and is called once,
// where this happens per file and must not touch the others.
sub textClear {
  // **The chunks go back before the counters do**, since the line table is the
  // only record of where they are: reset `lineCount` first and they are lost
  // rather than freed.
  for ( u16 ln = 0; ln < lineCount; ln++ ) {
    lineDrop( ln )
  }

  lineCount = 0
  undoHead  = 0
  undoCount = 0
  undoDone  = 0
  undoing   = false
  breakRun  = true
  noRoom    = false
  whyNoRoom = whyNothing
  bulking   = false
  stepDepth = 0
  stepLost  = false
  undoLost  = false

  if ( chunkLimit == 0 ) return

  lineLimit = textMaxLines
  lineNew()
}

sub textInit {
  u16 room
  u16 avail
  u16 spare
  u16 seg

  lineCount  = 0
  chunkFree  = 0
  chunkHigh  = 1
  chunkLive  = 0
  chunkLimit = 0
  lineLimit  = 0
  undoHead   = 0
  undoCount  = 0
  undoDone   = 0
  undoing    = false
  breakRun   = true
  noRoom     = false
  whyNoRoom  = whyNothing
  bulking    = false
  stepDepth  = 0
  stepLost   = false
  undoLost   = false

  // The four record regions in order from the base, then the text after them.
  // Nothing is allocated here - a far region is an address - so this is where
  // the layout is decided and the only place it exists.
  recBase = blockBase()
  textBase = 0

  if ( recBase == 0 ) {
    noRoom = true
    whyNoRoom = whyBlock
    return
  }

  // **The records are sized from what the machine has, not from the ceiling.**
  // This used to lay them out at `maxChunks` and give the text whatever was
  // left, on the stated grounds that "a far region takes a constant" - which is
  // true of its *declared size* and not of its base, and the bases here have
  // been variables all along. So a machine that could not reach the ceiling paid
  // for it anyway, in records for chunks that could never exist.
  //
  // It is worth the arithmetic because it is the difference between fitting and
  // not: a 577 KB machine went from 24,000 chunks to about 28,500, and the file
  // that prompted this needs 27,953.
  if ( blockEnd() <= recBase ) {
    noRoom = true
    whyNoRoom = whyBlock
    return
  }

  avail = blockEnd() - recBase

  if ( avail <= ( headParas + lenParas + logParas ) * maxDocs ) {
    noRoom = true
    whyNoRoom = whyBlock
    return
  }

  // What is left after the line tables is shared between the text and the two
  // per-chunk records, in the ratio they cost: sixteen bytes of text, two of
  // `chunkNext`, one of `chunkUsed` - nineteen sixteenths of a paragraph each.
  //
  // **Divided before it is multiplied**, with the remainder carried. `spare * 16`
  // leaves a `u16` at four thousand paragraphs and the machine this was measured
  // on has thirty-six thousand. Third time that exact shape has been needed;
  // `loadrate` was the first.
  spare = avail - ( headParas + lenParas + logParas ) * maxDocs
  chunkLimit = spare / 19 * 16 + ( spare % 19 ) * 16 / 19

  if ( chunkLimit > maxChunks ) chunkLimit = maxChunks

  // Rounded up, because a region that stops one paragraph short of its last
  // entry is a region whose last entry is somebody else.
  // **The shared half first**: the chunk links and their fill, which every
  // document draws from.
  nextSeg  = recBase
  usedSeg  = nextSeg + ( chunkLimit + 7 ) / 8

  // Then a set of per-document regions apiece. The log is fixed by `maxUndo`
  // rather than by the machine - a log is a window on history and a bigger one
  // stops being better where a person would rather have the text.
  seg = usedSeg + ( chunkLimit + 15 ) / 16

  for ( u16 d = 0; d < maxDocs; d++ ) {
    docHeadSeg[d] = seg
    seg = seg + headParas

    docLenSeg[d] = seg
    seg = seg + lenParas

    docLogOp[d] = seg
    seg = seg + opParas

    docLogLine[d] = seg
    seg = seg + lineParas

    docLogCol[d] = seg
    seg = seg + lineParas

    docLogCh[d] = seg
    seg = seg + opParas

    docLogJoin[d] = seg
    seg = seg + opParas
  }

  textBase = seg

  // Compared rather than added, so a high base cannot wrap past the end and
  // come back looking like room - the same care `blockFits` takes.
  if ( blockEnd() <= textBase ) {
    noRoom = true
    whyNoRoom = whyBlock
    return
  }

  // The ratio is exact; the rounding above is not. Whatever slack that left,
  // this takes back.
  room = blockEnd() - textBase
  if ( room < chunkLimit ) chunkLimit = room

  // Chunk 0 is the null and a line needs one of its own, so two is the floor
  // below which there is no buffer rather than a small one.
  if ( chunkLimit < 2 ) {
    chunkLimit = 0
    noRoom = true
    whyNoRoom = whyBlock
    return
  }

  // **Every document, not only the first.** They share the chunk store, so an
  // empty one costs a line and its terminator; leaving them uninitialised would
  // mean a switch landing in whatever the records held.
  for ( u16 d = 0; d < maxDocs; d++ ) {
    curDoc = d

    // **Nothing is in any of them yet**, whatever these arrays remember from a
    // previous layout. The allocator was reset a few lines up, so a `textClear`
    // that believed a stale line count would hand the same chunks out twice.
    docLines[d] = 0

    docLoad( d )
    textClear()
    docSave()
  }

  curDoc = 0
  docLoad( 0 )
}

// Whether there is a buffer at all. `textNoRoom` says the same thing and more,
// so this exists only for a program that wants to tell a machine with no room
// past the segment from a file that was too big for one that had it.
bool textHasBuffer() => textBase != 0

// How many chunks this machine actually had room for, which is `textChunks`
// on anything with a normal amount of conventional memory and less on the
// rest. A program showing a capacity should show this one.
u16 textRoom() => chunkLimit

// And how many of them are in use, across every document - they share the store,
// so there is one answer and not one per document.
u16 textUsed() => chunkLive

// One character of a file being read in. A newline starts a line, anything else
// appends. **Records no undo**: reading a file in is not an edit anybody wants
// to step back through, and a log full of the file would leave no room for the
// session.
//
// **Wrapped in `textBulk` this is about ten times less work per character**, and
// unwrapped it is what it always was. The difference is measured rather than
// asserted - `loadrate` reports both - and the reason is counted below.
sub textLoad( u8 ch ) {
  u16 d

  if ( !bulking ) {
    undoing = true

    if ( ch == '\n' ) {
      lineNew()
    } else if ( ch != '\r' ) {
      lineAppend( lineCount - 1, ch )
    }

    undoing = false
    return
  }

  if ( ch == '\r' ) return

  if ( ch == '\n' ) {
    // The counters go back to the records before the line table moves, because
    // `lineNew` and `bulkSeed` both read them.
    bulkFlush()
    lineNew()

    // A refused line leaves `lineCount` where it was, so this re-seeds onto the
    // same last line and carries on appending to it - which is what the
    // unwrapped path does, and what the capacity test depends on.
    bulkSeed()
    return
  }

  if ( loadUsed == chunkSize ) {
    chunkUsed[loadChunk] = chunkSize

    d = chunkTake()
    if ( d == 0 ) {
      noRoom = true
      whyNoRoom = whyChunks
      return
    }

    chunkNext[loadChunk] = d
    loadChunk = d
    loadUsed  = 0
    atDst( loadChunk )
  }

  dst[loadUsed] = ch
  loadUsed++
  loadLen++
}

// ---- writing it out ----

// DOS convention, and `textLoad` skips the carriage return on the way back in,
// so a file written here reloads to exactly the buffer that wrote it.
local const u8[] lineEnd = "\r\n"

// **DOS writes from `DS:DX` (§38) and the text is no longer in `DS`**, so it
// has to come back through our own segment on the way out. Which is a better
// arrangement than the one it replaced rather than a worse one: this file's
// first version handed DOS one chunk at a time, so a save was an interrupt per
// sixteen bytes.
local const stageBytes = 512
local u8[stageBytes] stage

// The whole buffer to an already-open handle, answering whether **all** of it
// got there. The handle is the caller's: this knows how a buffer is shaped and
// nothing about where a file came from.
//
// **A newline goes between lines and not after the last**, which is what makes
// the round trip exact. A file ending in one loads as a final empty line, so
// writing separators reproduces the trailing newline without a rule about it.
//
// Each chunk is handed to DOS where it already lies, so nothing is copied on the
// way out - which is the whole reason this routine is in this file.
//
// ---- every write is checked against what it asked for ----------------------
//
// **DOS reports a short write by returning a smaller number and leaving carry
// alone.** `AH=40h` on a disk that filled up halfway writes what fits and says
// so only in `AX`, so §38's `fileFailed` is silent on the one failure that
// matters most here. This used to add the counts up and return the total, which
// nobody compared against anything - so a save could truncate a file, write part
// of it back, and be reported as a save.
//
// §55 has the rule from the other end, written about opening: *an editor that
// shows you part of a file and then writes that part back over the whole is
// worse than one that will not open it.* That is this hazard on the way out, and
// it was never closed.
//
// It stops at the first short write. There is nothing to be gained by putting
// more of a file on a disk that has already refused some of it, and a caller
// told `false` still has the document in memory, which is the copy that is right.
//
// **The byte count is secondary and is a `u16`**, so it wraps past 64 KB and is
// no use as a check from outside - which is why it is no longer the return.
// `textWrote` is for a test that knows its fixture is small.
local u16 saveWrote

u16 textWrote() => saveWrote

local bool putOut( u16 handle, a16 at, u16 n ) {
  u16 sent

  sent = fileWrite( handle, at, n )
  saveWrote += sent

  return sent == n
}

bool textSave( u16 handle ) {
  u16 col
  u16 n

  saveWrote = 0

  for ( u16 ln = 0; ln < lineCount; ln++ ) {
    col = 0
    n = lineSlice( ln, col, stageBytes, addr( stage ) )

    while ( n > 0 ) {
      if ( !putOut( handle, addr( stage ), n ) ) return false

      col += n
      n = lineSlice( ln, col, stageBytes, addr( stage ) )
    }

    if ( ln + 1 < lineCount ) {
      if ( !putOut( handle, addr( lineEnd ), 2 ) ) return false
    }
  }

  return true
}
