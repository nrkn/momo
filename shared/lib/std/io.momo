// std/io.momo - console output via DOS int 21h.
//
// Keyboard input lives in std/key.momo.

// putNumber's own workings. Not `local`, and the reason has changed since it was
// last written down here.
//
// It used to be the round trip: a private took every program that included this
// file out of the only test the parser has, and most programs include this file.
// That cost is gone - the printer lowers a private now (§14), and `local` here
// was tried once the cost went.
//
// What stopped it is the output. A const emits an `equ`, so `local` would put
// `io__ioBase` in place of `ioBase` in every program that includes this - 35 of
// them - and the assembly is the product rather than an intermediate (§1). The
// `io` prefix already separates these from anything a program is likely to write,
// and nothing here can be assigned, so there is no hole of the kind `randomSeed`
// had. A program that does declare its own `ioBase` is told so, by name, at
// compile time.
const ioBase      = 10
const ioZeroChar  = '0'
const ioMaxDigits = 5

sub putChar(u8 c) {
  _ah = 0x02
  _dl = c
  int 0x21
}

// Writes a '$'-terminated string. Pass addr(yourString).
sub putStr(u16 at) {
  _ah = 0x09
  _dx = at
  int 0x21
}

sub newline {
  putChar(13)
  putChar(10)
}

sub space => putChar(32)

// Decimal, most significant digit first.
sub putNumber(u16 n) {
  u8[ioMaxDigits] digits        // private scratch: a local, not a shared global
  u8 i

  if (n == 0) {
    putChar(ioZeroChar)
    return
  }

  // `n` is a parameter, so writing it here cannot affect the caller.
  for (i = 0; n > 0; i++) {
    digits[i] = u8(n % ioBase) + ioZeroChar
    n /= ioBase
  }

  for (; i > 0; i--) {
    putChar(digits[i - 1])
  }
}
