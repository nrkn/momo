// std/io.momo - console output via DOS int 21h.
//
// Keyboard input lives in std/key.momo.

// putNumber's own workings. These are NOT `local`, deliberately, and the reason
// is the round trip rather than the language: the printer splices every include
// into one file, so a private loses the owner its label is named after, and
// `npm test` skips any program containing one. 22 programs include this file, so
// marking these three private cost 19 of the 48 round-trip assertions - which is
// most of the only test the parser has.
//
// The `io` prefix is the pre-`local` answer to collisions and it still works.
// Contrast `randomSeed` in std/rand.momo, which is `local` because a program
// could otherwise write past the guard that keeps the generator alive: that is a
// correctness hole worth a skip, and three unwritable consts are not.
const ioBase      = 10
const ioZeroChar  = '0'
const ioMaxDigits = 5

sub putChar(u8 c) {
  _ah = 0x02
  _dl = c
  int 0x21
}

// Writes a '$'-terminated string. Pass addr(yourString).
sub putStr(u16 at) {
  _ah = 0x09
  _dx = at
  int 0x21
}

sub newline {
  putChar(13)
  putChar(10)
}

sub space => putChar(32)

// Decimal, most significant digit first.
sub putNumber(u16 n) {
  u8[ioMaxDigits] digits        // private scratch: a local, not a shared global
  u8 i

  if (n == 0) {
    putChar(ioZeroChar)
    return
  }

  // `n` is a parameter, so writing it here cannot affect the caller.
  for (i = 0; n > 0; i++) {
    digits[i] = u8(n % ioBase) + ioZeroChar
    n /= ioBase
  }

  for (; i > 0; i--) {
    putChar(digits[i - 1])
  }
}
