// std/str.momo - strings and blocks at runtime addresses.
//
// This is the library that could not be written before peek8/poke8 existed.
// Routines take scalars, so a buffer cannot be passed - but its ADDRESS can, and
// addr() is where one comes from:
//
//   const u8[] greeting = "hello$"
//   n = strLen( addr( greeting ) )
//
// Nothing here is bounds-checked, and nothing can be: an address is a runtime
// value, so there is no length to check it against. That is the trade peek and
// poke exist to make, and it is why they are spelled visibly at every use.
//
// Strings here are '$'-terminated. That is DOS's convention - int 21h AH=09
// scans for the byte - and it was inherited rather than chosen. Nothing in the
// compiler knows about '$' at any stage, so this is a convention of the
// libraries and not a property of the language; `putStr` requires it without
// ever naming the constant below, because DOS does the scanning. Every other
// reader of `strEnd` chose it.
//
// The cost is that a string cannot contain '$'. Whether a convention only the
// DOS edge needs should reach this far is DESIGN §20.

const strEnd = '$'

// Length not counting the terminator.
u16 strLen( u16 at ) {
  u16 n
  n = 0

  while ( peek8( at + n ) != strEnd ) {
    n++
  }

  return n
}

// Copies up to and including the terminator, so the destination is a string
// afterwards. The destination must have room for strLen(from) + 1 bytes; nothing
// here can check that.
sub strCopy( u16 to, u16 from ) {
  u16 i
  u8  ch

  i = 0

  for ( ;; ) {
    ch = peek8( from + i )
    poke8( to + i, ch )
    if ( ch == strEnd ) break
    i++
  }
}

// The ADDRESS of the nth string in a run of them, counting from zero, where the
// run is one blob and each string ends in '$'.
//
//   const u8[] names = "Write$Paintbrush$Terminal$"
//   putStr( nthStr( addr( names ), 1 ) )        // Paintbrush
//
// This exists because a table of addresses cannot be written down: addr() is a
// link-time constant and an array initialiser is folded before there is anything
// to point at, so `u16[] at = [ addr( a ), addr( b ) ]` is rejected. PITFALLS
// has the error and the reasoning.
//
// Walking is linear where a table would index, which for the handful of strings
// a caller indexes this way is nothing - and a blob is the maintainable half of
// the trade anyway, since an offset table written by hand has to be recomputed
// whenever a string changes length.
//
// Past the end it returns the address of the byte after the last terminator,
// which is not a string. Nothing here can check n, for the same reason nothing
// else here bounds-checks.
u16 nthStr( u16 at, u16 n ) {
  u16 i
  u16 seen

  i = 0
  seen = 0

  while ( seen < n ) {
    if ( peek8( at + i ) == strEnd ) seen++
    i++
  }

  return at + i
}

// Negative, zero or positive on the first differing byte, like C's strcmp. i16
// because the difference of two bytes is signed - and because returning it,
// rather than -1/0/1, lets a caller sort as well as test.
i16 strCmp( u16 a, u16 b ) {
  u16 i
  u8  ca
  u8  cb

  i = 0

  for ( ;; ) {
    ca = peek8( a + i )
    cb = peek8( b + i )

    if ( ca != cb ) return i16( ca ) - i16( cb )
    if ( ca == strEnd ) return 0

    i++
  }
}

// The ADDRESS of the first `ch`, or 0 when there is none. Zero is a safe sentinel
// rather than a magic number: a .COM is loaded at 0x100, so no byte a Momo
// program can name lives at offset 0.
//
// Searching for '$' finds the terminator, which is the useful answer - it is the
// same address strLen would have you compute.
u16 strFind( u16 at, u8 ch ) {
  u16 i
  u8  c

  i = 0

  for ( ;; ) {
    c = peek8( at + i )

    if ( c == ch ) return at + i
    if ( c == strEnd ) return 0

    i++
  }
}

// Forward copy, so it is memcpy rather than memmove: overlapping regions where
// `to` is above `from` will copy bytes over themselves. Deliberate - the reverse
// loop that fixes it costs every caller that does not need it.
sub memCopy( u16 to, u16 from, u16 count ) {
  for ( u16 i = 0; i < count; i++ ) {
    poke8( to + i, peek8( from + i ) )
  }
}

sub memFill( u16 at, u16 count, u8 value ) {
  for ( u16 i = 0; i < count; i++ ) {
    poke8( at + i, value )
  }
}

// ---- digits ----

// `n` bytes at `at`, read as a decimal number. **False when any one of them is
// not a digit**, rather than stopping at the first - because a caller handed 12
// for `"12x"` has been told a typo was an answer, and a line number is exactly
// where that is obeyed silently.
//
// Empty is false too: there is no number in no characters, and returning 0 would
// be a valid line for a prompt somebody just pressed Enter at.
//
// The value comes back through `strValue` rather than the return, because there
// are two answers and the failing one has no number in it. Same shape §54 uses
// for where an undo landed.
local u16 numValue

u16 strValue() => numValue

bool strNumber( u16 at, u16 n ) {
  u8 ch

  numValue = 0
  if ( n == 0 ) return false

  for ( u16 i = 0; i < n; i++ ) {
    ch = peek8( at + i )

    // **Zeroed on the way out, not left part way.** A caller that ignores the
    // bool would otherwise be handed 12 for `"12x"`, which is the failure this
    // routine exists to prevent arriving by a different door.
    if ( ch < '0' || ch > '9' ) {
      numValue = 0
      return false
    }

    // **Past 65,535 is a refusal rather than a wrap**, and the two tests are
    // exact: anything above 6,553 cannot take another digit, and 6,553 itself
    // can take one only up to 5. A wrap here is the same shape as `"12x"` -
    // a number handed back that the person did not type.
    if ( numValue > 6553 || ( numValue == 6553 && ch > '5' ) ) {
      numValue = 0
      return false
    }

    numValue = numValue * 10 + u16( ch - '0' )
  }

  return true
}
