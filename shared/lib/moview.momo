// moview.momo - a window onto a motext buffer (PLAN §55).
//
// It holds a top line, a left column and a size, keeps a cursor inside them, and
// renders by handing one row at a time to a routine **the program defines**:
//
//   sub viewRow( u16 y, u16 at, u16 n )
//
// That is the seam `tiger` and `tigerpic` share over `plot`, and it is why this
// can be tested at all. A program that prints rows is a tier-2 test with a
// `.expected`; a program that writes cells is an editor; the library never
// learns which it is talking to.
//
// **Nothing here reads a key.** Scrolling happens because the cursor moved, and
// what moved it is the caller's business - so the whole of this is testable
// before any input exists.

include "lib/motext.momo"

// A row is copied out of the buffer before it is handed over, because §54's read
// interface is a slice rather than a character: the chain is walked once per
// row, never once per column.
const viewMaxWidth = 160

local u8[viewMaxWidth] row

local u16 top
local u16 left
local u16 height
local u16 width

local u16 curLine
local u16 curCol

// The other end of a selection - **a mark and a point**, where the point is the
// cursor above. That is what VS Code holds and what a caller extending with
// Shift already has half of; a range would be a second coordinate system to keep
// in step with the cursor that exists either way.
//
// It lives here because the other end of it does, and because the ordering - the
// question of which end comes first in the document - is an off-by-one that
// every caller who renders or deletes a selection would otherwise answer for
// itself. **It is also the shape multiple cursors want**, being an array of
// exactly this; §55 records why that changes nothing here.
local u16 markLine
local u16 markCol
local bool marked

// The column the cursor is *aiming* at, which is not always the one it is in.
// Moving down a long line onto a short one has to put the cursor somewhere the
// short line has, and moving off it again should go back to where it was - so
// the clamp is a display decision and this is the intent behind it. Horizontal
// motion and every edit set it; vertical motion keeps it.
local u16 goalCol

// ---- shape ----

sub viewSize( u16 h, u16 w ) {
  height = h
  width = w > viewMaxWidth ? viewMaxWidth : w
}

sub viewHome {
  top = 0
  left = 0
  curLine = 0
  curCol = 0
  marked = false
}

u16 viewTop() => top
u16 viewLeft() => left
u16 viewLine() => curLine
u16 viewCol() => curCol

// ---- the selection ----
//
// **Nothing here decides when a selection starts or ends**, which is the same
// call `viewRow` makes about drawing and `undoBreak` makes about a run of
// typing: whether a keystroke extends a selection or collapses one is a fact
// about the person's hand, not about the window. So a caller holding Shift calls
// `viewMark` before the motion and one that is not calls `viewUnmark`, and every
// motion routine below is untouched by either.

sub viewMark {
  if ( marked ) return

  markLine = curLine
  markCol  = curCol
  marked   = true
}

sub viewUnmark {
  marked = false
}

// Marked *and* not empty. An anchor sitting on the cursor selects nothing, and
// without this every caller would special-case it - a copy of no bytes, a
// delete of no characters, a highlight of no cells.
bool viewSelected() => marked && ( markLine != curLine || markCol != curCol )

u16 viewMarkLine() => markLine
u16 viewMarkCol()  => markCol

// Which end is the earlier one, asked once and answered here. A selection made
// upwards or leftwards has its anchor after its cursor, and every caller that
// forgot would work perfectly until somebody selected backwards.
local bool markFirst() => markLine < curLine || ( markLine == curLine && markCol < curCol )

u16 viewFromLine() => markFirst() ? markLine : curLine
u16 viewFromCol()  => markFirst() ? markCol  : curCol
u16 viewToLine()   => markFirst() ? curLine  : markLine
u16 viewToCol()    => markFirst() ? curCol   : markCol

// ---- following the cursor ----

// Scroll the least that brings the cursor back inside the window. Both axes are
// the same shape and neither is a special case, which is the whole reason a
// window is a pair of offsets rather than a mode.
local sub viewFollow {
  if ( curLine < top ) top = curLine
  if ( curLine >= top + height ) top = curLine - height + 1

  if ( curCol < left ) left = curCol
  if ( curCol >= left + width ) left = curCol - width + 1
}

// Put the cursor somewhere and scroll to suit. Clamped to the buffer, so a
// caller that walks off the end lands on the last line rather than outside it.
//
// **This sets the goal column**, because a caller naming one means it: typing,
// Home, End and the left and right arrows all know which column they want.
sub viewGoto( u16 ln, u16 col ) {
  goalCol = col
  viewPlace( ln, col )
}

// The same, keeping the goal. Vertical motion goes through here, so a run of
// Down over a short line comes out at the column it went in at rather than at
// wherever the shortest line on the way happened to end.
sub viewGotoLine( u16 ln ) {
  viewPlace( ln, goalCol )
}

local sub viewPlace( u16 ln, u16 col ) {
  u16 lines
  lines = textLines()

  curLine = ln
  if ( lines > 0 && curLine >= lines ) curLine = lines - 1

  curCol = col
  if ( curCol > lineLength( curLine ) ) curCol = lineLength( curLine )

  viewFollow()
}

// ---- rendering ----

// Every row of the window, in order, whether or not the buffer has a line for
// it. A row past the end is handed over with a length of 0 rather than skipped,
// because a window has a fixed shape and the caller is painting a rectangle -
// leaving those rows out would leave the previous frame's text on screen.
sub viewRender {
  u16 ln
  u16 n

  for ( u16 y = 0; y < height; y++ ) {
    ln = top + y
    n = 0

    if ( ln < textLines() ) n = lineSlice( ln, left, width, addr( row ) )

    viewRow( y, addr( row ), n )
  }
}
