// morange.momo - a span of text as one edit (DESIGN §61).
//
// Copy a span out, delete a span, insert a span. Three routines, and what makes
// them a file rather than three lines in an editor is that each one is several
// of §54's edits and **all of them have to be one step back**.
//
// **It needs nothing private to §54**, which is the same reason §59 is its own
// file. The span walk is `lineSlice`, `lineDelete`, `lineSplit` and `lineJoin`,
// all public; the grouping is `undoStep`, which §54 exposes as a bracket
// precisely so a command outside it can say that several edits are one action.
// `textSave` is inside the buffer because it could not be written anywhere else.
// This could, so it is.
//
// **A newline here is one byte.** §54's `textSave` owns the DOS convention and
// puts a carriage return back on the way out; a span going to a clipboard is
// text this program is holding for itself, so it holds it the way the buffer
// does rather than the way a file does.

include "lib/motext.momo"

local u16 endLine
local u16 endCol

// Whether the last `rangeCopy` got all of the span it was asked for. **The count
// alone cannot say**: a span that exactly filled the buffer returns the same
// number as one that was cut off, and the difference matters to a caller about
// to delete what it just copied.
local bool copyFit

// Where an insert finished, so a caller can put the cursor after what it pasted.
// The same call §54 makes with `undoLine` - the walk is the only thing that
// knows, and working it out afterwards means counting the newlines again.
u16 rangeEndLine() => endLine
u16 rangeEndCol()  => endCol
bool rangeCopied() => copyFit

// ---- reading a span out ----

// The span (fromLn, fromCol) to (toLn, toCol), exclusive of the end, copied to
// `at`. At most `max` bytes, and the count written is returned - so a caller
// with a fixed clipboard finds out that it did not all fit rather than being
// told about it later by a corrupted heap.
u16 rangeCopy( u16 fromLn, u16 fromCol, u16 toLn, u16 toCol, a16 at, u16 max ) {
  u16 done
  u16 last
  u16 c0
  u16 c1
  u16 want

  done = 0
  copyFit = true

  if ( textLines() == 0 ) return 0

  last = toLn
  if ( last >= textLines() ) last = textLines() - 1

  for ( u16 ln = fromLn; ln <= last; ln++ ) {
    c0 = 0
    if ( ln == fromLn ) c0 = fromCol

    c1 = lineLength( ln )
    if ( ln == last && toCol < c1 ) c1 = toCol

    if ( c1 > c0 ) {
      want = c1 - c0
      if ( want > max - done ) {
        want = max - done
        copyFit = false
      }

      if ( want > 0 ) done += lineSlice( ln, c0, want, at + done )
    }

    if ( ln < last ) {
      if ( done < max ) {
        poke8( at + done, '\n' )
        done++
      } else {
        copyFit = false
      }
    }
  }

  return done
}

// ---- taking a span out ----

// **The joins come before the deletes**, which is the whole shape of this. The
// obvious order is to empty every line in the span and then join what is left,
// and it means walking a different line each time; joining first pulls the rest
// of the span onto the first line, so the walk stays on one line and the count
// of what to remove is known before any of it moves.
sub rangeDelete( u16 fromLn, u16 fromCol, u16 toLn, u16 toCol ) {
  u16 last
  u16 tail
  u16 n

  if ( textLines() == 0 ) return

  last = toLn
  if ( last >= textLines() ) last = textLines() - 1
  if ( fromLn > last ) return

  undoStep {
    if ( fromLn == last ) {
      n = toCol
      if ( n > lineLength( fromLn ) ) n = lineLength( fromLn )

      while ( n > fromCol ) {
        lineDelete( fromLn, fromCol )
        n--
      }
    } else {
      // How much of what the joins are about to bring in belongs to the span:
      // all of every line between, and the head of the last one. Counted first,
      // because after the joins there is nothing left to count it from.
      tail = toCol
      if ( tail > lineLength( last ) ) tail = lineLength( last )

      n = tail
      for ( u16 ln = fromLn + 1; ln < last; ln++ ) {
        n += lineLength( ln )
      }

      while ( lineLength( fromLn ) > fromCol ) {
        lineDelete( fromLn, fromCol )
      }

      for ( u16 j = fromLn; j < last; j++ ) {
        lineJoin( fromLn )
      }

      while ( n > 0 ) {
        lineDelete( fromLn, fromCol )
        n--
      }
    }
  }
}

// ---- putting a span in ----

// `n` bytes at `at`, inserted at (ln, col). A newline splits the line, which is
// what makes a pasted span of three lines three lines rather than one with two
// control characters in it. A carriage return is dropped, the same way
// `textLoad` drops one, so a span that came from a file pastes clean.
sub rangeInsert( u16 ln, u16 col, a16 at, u16 n ) {
  u8 ch

  undoStep {
    for ( u16 i = 0; i < n; i++ ) {
      ch = peek8( at + i )

      if ( ch == '\n' ) {
        lineSplit( ln, col )
        ln++
        col = 0
      } else if ( ch != '\r' ) {
        lineInsert( ln, col, ch )
        col++
      }
    }
  }

  endLine = ln
  endCol  = col
}

// ---- where a span begins and ends ----
//
// Word motion is a span question asked from one end: `Ctrl+Left` is "the start of
// the word I am in", and selecting a word is the span between two of these. So it
// is here rather than in a file of its own, and it needs the same read interface
// as everything above - `lineSlice` and `lineLength`, nothing private to §54.

// Three classes, because a run of punctuation is a unit in every editor worth
// copying and so is a run of letters. `_` counts as a letter, which is what makes
// this useful on code rather than on prose.
local const clsSpace = 0
local const clsWord  = 1
local const clsPunct = 2

local u8 classOf( u8 ch ) {
  if ( ch == ' ' || ch == 9 ) return clsSpace
  if ( ch >= '0' && ch <= '9' ) return clsWord
  if ( ch >= 'A' && ch <= 'Z' ) return clsWord
  if ( ch >= 'a' && ch <= 'z' ) return clsWord
  if ( ch == '_' ) return clsWord

  return clsPunct
}

// A window onto one line, re-sliced when the walk leaves it. **Centred on the
// position asked for**, because this is the one reader here that goes backwards
// as well as forwards and a window anchored at either end would re-slice every
// character in one of the two directions.
local const wordWindow = 128

local u8[wordWindow] wbuf
local u16 winLine
local u16 winFrom
local u16 winLen
local bool winHeld

local u16 atLine
local u16 atCol

u16 wordLine() => atLine
u16 wordCol()  => atCol

local u8 charAt( u16 ln, u16 col ) {
  u16 from

  if ( !winHeld || ln != winLine || col < winFrom || col >= winFrom + winLen ) {
    from = 0
    if ( col > wordWindow / 2 ) from = col - wordWindow / 2

    winLen  = lineSlice( ln, from, wordWindow, addr( wbuf ) )
    winLine = ln
    winFrom = from
    winHeld = true
  }

  if ( col < winFrom || col >= winFrom + winLen ) return 0

  return wbuf[ col - winFrom ]
}

// **The window lives for one call and no longer.** Both routines below drop it
// before they start, so it can never be read after an edit has moved the text
// under it - which is the one way a cache like this goes quietly wrong, and it is
// closed by construction rather than by every caller remembering.
local sub wordForget {
  winHeld = false
}

// The start of the next word: skip the rest of whatever the cursor is inside,
// then skip the whitespace after it. That is Windows' rule rather than the one
// where the cursor lands on the *end* of a word, and it is what makes a run of
// `Ctrl+Right` read as walking the words.
sub wordNext( u16 ln, u16 col ) {
  u16 length
  u8  cls

  wordForget()
  length = lineLength( ln )

  // Past the end is the next line, the same wrap the right arrow already does.
  if ( col >= length ) {
    atLine = ln
    atCol  = length

    if ( ln + 1 < textLines() ) {
      atLine = ln + 1
      atCol  = 0
    }

    return
  }

  cls = classOf( charAt( ln, col ) )

  if ( cls != clsSpace ) {
    while ( col < length && classOf( charAt( ln, col ) ) == cls ) {
      col++
    }
  }

  while ( col < length && classOf( charAt( ln, col ) ) == clsSpace ) {
    col++
  }

  atLine = ln
  atCol  = col
}

// The start of the word the cursor is in, or of the one before it when it is
// already there - which is what makes a run of `Ctrl+Left` walk backwards rather
// than stick on the first boundary it finds.
sub wordPrev( u16 ln, u16 col ) {
  u8 cls

  wordForget()

  if ( col == 0 ) {
    atLine = 0
    atCol  = 0

    if ( ln > 0 ) {
      atLine = ln - 1
      atCol  = lineLength( ln - 1 )
    }

    return
  }

  col--

  while ( col > 0 && classOf( charAt( ln, col ) ) == clsSpace ) {
    col--
  }

  cls = classOf( charAt( ln, col ) )

  while ( col > 0 && classOf( charAt( ln, col - 1 ) ) == cls ) {
    col--
  }

  atLine = ln
  atCol  = col
}

// ---- every occurrence of one span, replaced by another ----
//
// It is here rather than in an editor because it is the same span walk as
// everything above with §59 choosing where: find a match, delete it, put the
// other text in, carry on. What makes it worth a routine of its own is that the
// carrying on is the part that can be wrong.
//
// **The walk continues from the end of what it wrote**, not from where the match
// was. Replacing `a` with `aa` would otherwise find its own output for ever, and
// a replacement that contains the term is not an unusual thing to ask for - it is
// what renaming `foo` to `foo2` looks like.
//
// **The whole thing is one `undoStep`.** A replace of four hundred occurrences
// that takes four hundred steps to undo is one nobody dares run.

include "lib/mofind.momo"

// The pattern is §59's, already set by `findSet`, because the caller had to set
// it to have something to replace. Returns how many were replaced.
u16 rangeReplaceAll( a16 at, u16 n ) {
  u16 ln
  u16 col
  u16 count

  count = 0

  if ( findLength() == 0 ) return 0

  undoStep {
    ln  = 0
    col = 0

    while ( findNext( ln, col ) ) {
      ln  = findLine()
      col = findCol()

      rangeDelete( ln, col, ln, col + findLength() )
      rangeInsert( ln, col, at, n )

      ln  = rangeEndLine()
      col = rangeEndCol()
      count++
    }
  }

  endLine = ln
  endCol  = col

  return count
}
