// build.momo - the immediate-mode surface: begin, openBox, closeBox, leaf.
//
// Ported from the clay study. Elements are pushed onto one flat array as they
// open, and a parent collects its children when it closes. Every entry point
// returns the element's index, and that index is the only handle momolo hands
// out - it is how a caller joins its own tables onto the geometry without the
// engine knowing they exist.
//
// **A box's settings are defaulted parameters (§49), named at the call.**
// momolo's builders take a config object with optional fields and `??`
// defaults; here the same fields are parameters with defaults, and a call site
// names only what differs - `openBox( isCol: true, gap: u )`. A default is
// restored by the routine on its way out, so the next box starts clean whether
// its call site says anything or not. The defaults are the element's: row, fit,
// no inset, no gap, start alignment, no upper bound.
//
// The settings are shaped for the call site rather than copied field for field
// from `el`:
//
//   insetX, insetY   the inset on both sides of one axis. Every box that has one
//                    wants it even, and a frame drawn above this layer adds its
//                    width to both
//   fixedW, fixedH   a fit whose minimum and maximum are equal, which is exactly
//                    what CLAY_SIZING_FIXED expands to - so two kinds, not three.
//                    0 is not fixed: a box fixed at nothing is not there
//   wMax, hMax       a ceiling on a fit or a grow, for when it is not fixed
//
// Every layer that forwards the settings restates the defaults, because an
// omitted argument cannot be passed on as omitted. That is why there are as few
// such layers as there are: pushElement applies them, openBox forwards them, and
// above this file each opener that takes them forwards them once more.
//
// A field left unwritten in `el` is a separate hazard - elements are reused
// between frames and `group` has no field initialisers - and pushElement
// handles it by writing every field, including the ones whose value it is
// clearing to zero.

include "lib/std/math.momo"

// The one place a box's settings reach the element, shared by openBox and leaf.
// Private to this file: nothing outside pushes an element without going through
// one of those two. A leaf passes nothing, since its size is given - so these
// defaults are what every leaf gets.
local u16 pushElement(
  bool isCol = false, u8 insetX = 0, u8 insetY = 0, u8 gap = 0,
  u8 alignMain = alignStart, u8 alignCross = alignStart,
  bool wGrow = false, u16 fixedW = 0, u16 wMax = unbounded,
  bool hGrow = false, u16 fixedH = 0, u16 hMax = unbounded
) {
  u16 i

  i = elCount

  el[i].isCol = isCol
  el[i].insetL = insetX
  el[i].insetR = insetX
  el[i].insetT = insetY
  el[i].insetB = insetY
  el[i].gap = gap
  el[i].alignMain = alignMain
  el[i].alignCross = alignCross
  el[i].wGrow = wGrow
  el[i].wMin = fixedW
  el[i].wMax = fixedW > 0 ? fixedW : wMax
  el[i].hGrow = hGrow
  el[i].hMin = fixedH
  el[i].hMax = fixedH > 0 ? fixedH : hMax

  // Cleared rather than assumed zero, for the reason in types.momo: nothing
  // re-zeroes a group between frames.
  el[i].childStart = 0
  el[i].childCount = 0
  el[i].w = 0
  el[i].h = 0
  el[i].minW = 0
  el[i].minH = 0
  el[i].x = 0
  el[i].y = 0
  el[i].overflowX = false
  el[i].overflowY = false

  elCount++

  return i
}

local sub attachToParent( u16 i ) {
  u16 p

  if ( openDepth == 0 ) return          // the root has no parent

  p = openStack[ openDepth - 1 ]
  el[p].childCount++
  childBuf[ childBufLen ] = i
  childBufLen++
}

u16 openBox(
  bool isCol = false, u8 insetX = 0, u8 insetY = 0, u8 gap = 0,
  u8 alignMain = alignStart, u8 alignCross = alignStart,
  bool wGrow = false, u16 fixedW = 0, u16 wMax = unbounded,
  bool hGrow = false, u16 fixedH = 0, u16 hMax = unbounded
) {
  u16 i

  i = pushElement(
    isCol: isCol, insetX: insetX, insetY: insetY, gap: gap,
    alignMain: alignMain, alignCross: alignCross,
    wGrow: wGrow, fixedW: fixedW, wMax: wMax,
    hGrow: hGrow, fixedH: fixedH, hMax: hMax
  )
  openStack[ openDepth ] = i
  openDepth++

  return i
}

sub closeBox {
  u16 i
  u16 n
  u16 base

  // An unbalanced close is a caller bug and nothing here can diagnose it.
  // Guarded anyway, because `openDepth--` at zero wraps to 65535 and the reads
  // that follow would scribble across the data section - a wrong answer with no
  // diagnostic is the worst shape a bug can take.
  if ( openDepth == 0 ) return

  openDepth--
  i = openStack[ openDepth ]
  n = el[i].childCount

  // Move this element's children out of the shared buffer into their permanent
  // run. They are the top n entries, still in order.
  el[i].childStart = childListLen
  base = childBufLen - n
  for ( u16 k = 0; k < n; k++ ) {
    childList[ childListLen ] = childBuf[ base + k ]
    childListLen++
  }
  childBufLen = base

  fitSize( i )
  attachToParent( i )
}

// An element whose size the caller already knows: a glyph run, an image, a
// widget measured elsewhere. momolo does not ask what it is or how it was
// measured - it is given the numbers and takes them at face value.
u16 leaf( u16 w, u16 h, u16 minW, u16 minH ) {
  u16 i
  u16 insetX
  u16 insetY
  u16 mw
  u16 mh

  i = pushElement()

  insetX = el[i].insetL + el[i].insetR
  insetY = el[i].insetT + el[i].insetB

  // A minimum says how far this may be squeezed, so one above the natural size
  // is a contradiction. Capped here rather than trusted: left alone it makes
  // pass 2's off-axis clamp *grow* the leaf to its minimum, which is the
  // opposite of what a minimum means.
  mw = min( minW, w )
  mh = min( minH, h )

  el[i].w = clamp( insetX + w, el[i].wMin, el[i].wMax )
  el[i].h = clamp( insetY + h, el[i].hMin, el[i].hMax )
  el[i].minW = clamp( insetX + mw, el[i].wMin, el[i].wMax )
  el[i].minH = clamp( insetY + mh, el[i].hMin, el[i].hMax )

  attachToParent( i )
  return i
}

// Start a frame. The root is a fixed-size box filling the viewport.
sub begin( u16 w, u16 h ) {
  elCount = 0
  openDepth = 0
  childBufLen = 0
  childListLen = 0

  openBox( isCol: true, fixedW: w, fixedH: h )
}

// ---- the reflow seam ------------------------------------------------------
//
// Between sizeX and sizeY a caller knows how wide its content ended up and may
// need to say how tall that made it. These two are the whole of that
// conversation, and neither knows why the answer changed.
//
// This is the inversion Clay's measure callback is turned inside out into: the
// engine offers a sequence point instead of calling out to the host. It matters
// more here than it did in TypeScript, because Momo has no function pointers -
// taking text out of the engine deleted the problem rather than solving it.

// The space inside a resolved element, once its inset is taken off. Meaningful
// only after sizeX has run.
sub setLeafHeight( u16 i, u16 h ) {
  u16 insetY

  insetY = el[i].insetT + el[i].insetB
  el[i].h = clamp( insetY + h, el[i].hMin, el[i].hMax )
  el[i].minH = clamp( insetY + h, el[i].hMin, el[i].hMax )
}

const u16 contentWidth( u16 i ) = el[i].w - el[i].insetL - el[i].insetR
