// mopaint.momo - the layer momolo does not have: colour, borders and text.
//
// Ported from the clay study, where it also sat outside the engine and for the
// same reason. **This is not the
// engine.** It keeps a style table parallel to the element array, keyed by the
// indices the builders hand back, and wraps those builders with ones that also
// record a style. Nothing here computes a layout, and nothing in shared/lib/momolo/
// knows this file exists.
//
// A border lives here rather than in the engine because a border is not
// geometry: it is a decision to draw something in space the caller already
// reserved. What the engine gets told is an inset, which it would have needed
// either way - see panelFramed.
//
// Wrapping lives here for the same reason, and it is the harder case. See
// reflowAll below: the engine offers a moment between sizeX and sizeY, and this
// layer does all the breaking inside it. Clay's engine calls out to a measure
// function from inside its own pass; momolo instead stops, lets this run, and
// carries the answer up the tree when it resumes.

include "lib/std/screen.momo"
include "lib/std/str.momo"
include "lib/momolo/types.momo"
include "lib/momolo/build.momo"

// What a layout unit means. The study runs the same scenes against a pixel
// target where these are 11 and 20 and text is proportional; here a unit is a
// character cell, so measuring a string is its length and a line is one cell.
const cellW      = 1
const lineHeight = 1

// Attribute meaning "draw nothing". A real attribute is 0..15, so 255 cannot
// collide with one - which is what the -1 of the TypeScript buys, spelled for
// a byte.
const transparent = 255

// Parallel to `el`. Every builder below writes every field, for the same reason
// pushElement does: nothing re-zeroes a group between frames, so a style left
// unwritten is the previous frame's.
group st[maxElements] {
  u8  bg
  u8  fg
  // addr() of a $-terminated string, or 0 for an element with no text. A .COM
  // loads at 0x100, so no byte a Momo program can name lives at offset 0.
  u16 text
  u8  border
  u8  borderColor
  // Where this element's wrapped lines start in the line table, and how many. A
  // count of 0 means "draw the whole run" - which is every label, and every
  // paragraph until reflowAll has been over it.
  u16 line0
  u8  lineCount
}

// Paragraphs awaiting a reflow, and the lines they came to. A line is a slice of
// the original string rather than a new one: Momo has no way to build a string at
// runtime, and it does not need one - a start address and a length say the same
// thing and cost three bytes.
const maxParas = 16
const maxLines = 64

local u16[maxParas] paraEl
local u16           paraCount

local u16[maxLines] lineAt
local u8[maxLines]  lineLen
local u16           lineTop

local sub stClear( u16 i ) {
  st[i].bg = transparent
  st[i].fg = lightGray
  st[i].text = 0
  st[i].border = 0
  st[i].borderColor = lightGray
  st[i].line0 = 0
  st[i].lineCount = 0
}

// begin() plus the root's style, since the root is the one element no caller
// creates.
sub paintBegin( u16 w, u16 h ) {
  begin( w, h )
  stClear( 0 )
  paraCount = 0
  lineTop = 0
}

// A container with nothing to draw: a spacer, or a row that only groups.
sub boxOpen {
  u16 i

  i = openBox()
  stClear( i )
}

sub panelOpen( u8 bg ) {
  u16 i

  i = openBox()
  stClear( i )
  st[i].bg = bg
}

// A frame's width is added to the inset before the engine sees it, so content is
// never drawn over. This is the whole of the argument that a border is paint
// rather than geometry - momolo is told a bigger inset and never hears the word.
sub panelFramed( u8 bg, u8 borderW, u8 frameColor ) {
  u16 i

  cfg.insetL += borderW
  cfg.insetR += borderW
  cfg.insetT += borderW
  cfg.insetB += borderW

  i = openBox()
  stClear( i )
  st[i].bg = bg
  st[i].border = borderW
  st[i].borderColor = frameColor
}

// The pairs (§48), which is where the nesting stops being a convention. Every
// one of these leaves a box open and `closeBox` is the only thing that closes
// one, so this is the file that can say so: the four openers are its own and
// `closeBox` is momolo's, which nothing below this layer knows to put together.
//
// A bracket declaration is program-wide, so including this file is how a scene
// gets them - and every existing call site still compiles, because a bracket
// adds a spelling rather than replacing one.
bracket paint  = paintBegin  / closeBox
bracket box    = boxOpen     / closeBox
bracket panel  = panelOpen   / closeBox
bracket framed = panelFramed / closeBox

// Both kinds of text run. The only thing that differs is what the leaf declares
// as its minimum width, and that is the whole of the distinction:
//
//   a label     is at least as wide as the whole string, always
//   a paragraph is at least as wide as its longest word
//
// The minimum propagates up the tree, so this decides how far any ancestor can
// later be compressed - a layout decision wearing a typographic name.
sub labelPaint( u16 at, u8 fg, u8 bg ) {
  u16 i
  u16 n

  n = strLen( at )
  i = leaf( n, lineHeight, n, lineHeight )

  stClear( i )
  st[i].text = at
  st[i].fg = fg
  st[i].bg = bg
}

// The minimum is the longest word, which in a Momo program is a compile-time
// constant because the string is - so shrink gets the right answer with no
// runtime word-breaking. Breaking it into lines to *draw* is what still needs
// the reflow seam.
sub paraPaint( u16 at, u16 minW, u8 fg, u8 bg ) {
  u16 i
  u16 n

  n = strLen( at )
  i = leaf( n, lineHeight, minW, lineHeight )

  stClear( i )
  st[i].text = at
  st[i].fg = fg
  st[i].bg = bg

  paraEl[paraCount] = i
  paraCount++
}

// The longest run of non-space bytes, which is exactly the minimum width a
// paragraph can be squeezed to: below it a word would have to break, and nothing
// here breaks words.
//
// paraPaint takes that number because for a scene written by hand it is a
// compile-time constant and writing it down costs nothing. A scene with fourteen
// captions is the case where writing it down is fourteen chances to be wrong
// about a string the compiler is holding anyway, so this works it out instead.
u16 longestWord( u16 at ) {
  u16 best
  u16 n
  u16 i
  u8  ch

  best = 0
  n = 0
  i = 0

  for ( ;; ) {
    ch = peek8( at + i )

    if ( ch == strEnd || ch == ' ' ) {
      if ( n > best ) best = n
      if ( ch == strEnd ) break
      n = 0
    } else {
      n++
    }

    i++
  }

  return best
}

// paraPaint with the minimum measured rather than passed.
sub paraAuto( u16 at, u8 fg, u8 bg ) => paraPaint( at, longestWord( at ), fg, bg )

// ---- the reflow -----------------------------------------------------------

// Break one run into lines no wider than `limit`, appending them to the line
// table and returning how many there were. Greedy, and the same rule as the
// TypeScript: a word that will not fit starts a new line, and a word wider than
// the line goes on its own and overflows, because there is nothing better to do
// with it.
//
// One difference worth stating. The TypeScript rebuilds each line from its words
// joined by single spaces, so a run of spaces in the source collapses. A slice
// cannot collapse anything, so this is equivalent only where the source already
// has single spaces - which every scene here does. A source with double spaces
// would measure short.
local u16 wrapInto( u16 at, u16 limit ) {
  u16 lim
  u16 n
  u16 i
  u16 lineStart
  u16 lineLength
  u16 wordStart
  u16 wordLen
  u16 candidate
  u8  ch

  lim = limit < 1 ? 1 : limit
  n = 0
  i = 0
  lineStart = 0
  lineLength = 0

  for ( ;; ) {
    for ( ;; ) {
      ch = peek8( at + i )
      if ( ch != 32 ) break
      i++
    }

    if ( peek8( at + i ) == strEnd ) break

    wordStart = i
    for ( ;; ) {
      ch = peek8( at + i )
      if ( ch == strEnd ) break
      if ( ch == 32 ) break
      i++
    }
    wordLen = i - wordStart

    candidate = lineLength == 0 ? wordLen : lineLength + 1 + wordLen

    if ( candidate <= lim ) {
      if ( lineLength == 0 ) lineStart = wordStart
      lineLength = candidate
      continue
    }

    if ( lineLength > 0 ) {
      lineAt[lineTop] = at + lineStart
      lineLen[lineTop] = u8( lineLength )
      lineTop++
      n++
    }

    lineStart = wordStart
    lineLength = wordLen
  }

  if ( lineLength > 0 ) {
    lineAt[lineTop] = at + lineStart
    lineLen[lineTop] = u8( lineLength )
    lineTop++
    n++
  }

  // An empty run still occupies one line, matching the TypeScript's
  // `lines.length === 0 ? [''] : lines`.
  if ( n == 0 ) {
    lineAt[lineTop] = at
    lineLen[lineTop] = 0
    lineTop++
    n = 1
  }

  return n
}

// Run between momolo's sizeX and refitY. Widths are final, so every paragraph can
// now be broken into lines and say how tall that made it.
//
// This is the whole of the inversion: Clay's engine calls a measure function from
// inside its own pass, and momolo instead stops, lets this run, and carries the
// answer up the tree when it resumes.
sub reflowAll {
  u16 i
  u16 first
  u16 n

  for ( u16 p = 0; p < paraCount; p++ ) {
    i = paraEl[p]
    first = lineTop
    n = wrapInto( st[i].text, contentWidth( i ) )

    st[i].line0 = first
    st[i].lineCount = u8( n )
    setLeafHeight( i, n * lineHeight )
  }
}

// ---- the renderer ---------------------------------------------------------
//
// One walk over `el` in order, reading the style table at the same index. That
// order is already paint order, because elements are pushed as they open and an
// immediate-mode builder opens them in pre-order - so there is no command list
// to build or consume. Later elements draw over earlier ones, which is the whole
// of the model.

// The text buffer, a word per cell: character in the low byte, attribute in the
// high byte. Writing it directly rather than through int 10h per cell is the
// difference between a screenful being instant and being visibly slow.
far u16[screenCols * screenRows] vram = 0xB800

// Bit 7 of the attribute means blink on default hardware, which would make every
// darkGray panel flash. int 10h AX=1003h with BL=0 trades blinking for bright
// backgrounds, so all sixteen colours are usable behind text.
sub useBrightBackgrounds {
  _ax = 0x1003
  _bx = 0x0000
  int 0x10
}

// Clipped at the screen edge on both axes, which is not politeness: momolo
// reports overflow rather than preventing it, so a scene is free to hand this a
// box that runs off the side.
local sub fillRect( u16 x, u16 y, u16 w, u16 h, u8 ch, u8 attr ) {
  u16 base
  u16 cell

  cell = ch | ( attr << 8 )

  for ( u16 r = 0; r < h; r++ ) {
    if ( y + r >= screenRows ) break

    base = ( y + r ) * screenCols + x

    for ( u16 c = 0; c < w; c++ ) {
      if ( x + c >= screenCols ) break
      vram[ base + c ] = cell
    }
  }
}

// A ring `b` cells thick, drawn in one colour. The engine already reserved the
// space; this only decides what goes in it.
local sub drawFrame( u16 x, u16 y, u16 w, u16 h, u8 b, u8 attr ) {
  u16 side

  fillRect( x, y, w, b, ' ', attr )
  fillRect( x, y + h - b, w, b, ' ', attr )

  // The left and right bars stop short of the corners the two rows above
  // already covered. Guarded because a box shorter than its own frame would
  // wrap the subtraction.
  if ( h > b + b ) {
    side = h - b - b
    fillRect( x, y + b, b, side, ' ', attr )
    fillRect( x + w - b, y + b, b, side, ' ', attr )
  }
}

// A run of exactly `count` characters, for a wrapped line - which is a slice of a
// longer string and so has no terminator of its own.
local sub drawRun( u16 at, u16 count, u16 x, u16 y, u8 attr ) {
  if ( y >= screenRows ) return

  for ( u16 i = 0; i < count; i++ ) {
    if ( x + i >= screenCols ) break
    vram[ y * screenCols + x + i ] = peek8( at + i ) | ( attr << 8 )
  }
}

local sub drawText( u16 at, u16 x, u16 y, u8 attr ) {
  u16 i
  u8  ch

  i = 0

  for ( ;; ) {
    ch = peek8( at + i )
    if ( ch == strEnd ) break
    if ( x + i >= screenCols ) break
    if ( y >= screenRows ) break

    vram[ y * screenCols + x + i ] = ch | ( attr << 8 )
    i++
  }
}

// Paint what is currently laid out, offset by where the composer put it.
//
// This is the whole of overlapping windows. A window is not part of a bigger
// layout: it is its own tree, laid out into its own root at its own size, and a
// screen is a list of them with an offset apiece. Z-order is list order, so
// there is no floating, no z-index, and no element that has to remember where it
// was put.
//
// The order a caller has to use follows from begin() resetting the element
// array: a layer is built, its passes run, anything read out of it read, and
// then it is painted - all before the next layer begins. The study this came
// from keeps every layer and renders at the end, which it can afford to; here
// the elements are gone as soon as the next paint( ) opens.
//
// That ordering is what makes an MDI child work rather than what makes it hard.
// A child lives inside its parent's client area, so the composer cannot place it
// until it knows where that client area landed - and it finds out by reading a
// resolved rectangle straight out of el[] between the two. momolo is being used
// as a coordinate system without knowing it is one, and nothing was added to
// allow it.
sub paintLayer( u16 dx, u16 dy ) {
  u8  bg
  u8  fg

  for ( u16 i = 0; i < elCount; i++ ) {
    bg = st[i].bg

    if ( bg != transparent ) {
      fillRect( el[i].x + dx, el[i].y + dy, el[i].w, el[i].h, ' ', color( bg, bg ) )
    }

    if ( st[i].border > 0 ) {
      fg = st[i].borderColor
      drawFrame( el[i].x + dx, el[i].y + dy, el[i].w, el[i].h, st[i].border, color( fg, fg ) )
    }

    if ( st[i].text != 0 ) {
      // Text starts inside the element's own inset, which for a run of text is
      // normally zero - but it costs nothing to be right about.
      fg = bg == transparent ? black : bg

      if ( st[i].lineCount == 0 ) {
        drawText(
          st[i].text,
          el[i].x + dx + el[i].insetL,
          el[i].y + dy + el[i].insetT,
          color( st[i].fg, fg )
        )
      } else {
        for ( u16 k = 0; k < st[i].lineCount; k++ ) {
          drawRun(
            lineAt[ st[i].line0 + k ],
            lineLen[ st[i].line0 + k ],
            el[i].x + dx + el[i].insetL,
            el[i].y + dy + el[i].insetT + k,
            color( st[i].fg, fg )
          )
        }
      }
    }
  }
}

// A screen that is one layout is the layer at the origin.
sub paintAll => paintLayer( 0, 0 )
