// consttst.momo - parameterised consts: substituted, never called.

include "std/io.momo"

const sqr(u8 n)                  = n * n
const u16 min(u16 a, u16 b) = a < b ? a : b
const u8 lo(u16 w) = u8(w)
const u8 hi(u16 w) = u8(w >> 8)
const isDigit(u8 c)              = c >= '0' && c <= '9'

// Compile-time table generation: every element folds during resolution.
const u16[] squares = [ sqr(0), sqr(1), sqr(2), sqr(3), sqr(4), sqr(5) ]

const packed = 0xBEEF

// A const whose BODY calls a fn. The call exists only in the expansion, so the
// call graph has to follow expansions or `double` is pruned and the emitter
// calls a label that is no longer there.
u16 double(u8 n) => n * 2

const plusOne(u8 n) = double(n) + 1

u16 i
u16 runtime

// ---- entry ----

// folded at compile time -> a plain immediate
putNumber(sqr(7))
newline()

// called with a runtime value -> substituted inline, no call emitted
runtime = 9
putNumber(sqr(u8(runtime)))
newline()

// nested const calls
putNumber(min(sqr(4), sqr(3)))
newline()

// the compile-time table
for (i = 0; i < 6; i++) {
  putNumber(squares[i])
  putChar(' ')
}
newline()

putNumber(hi(packed))
putChar(' ')
putNumber(lo(packed))
newline()

putNumber(isDigit('7'))
putNumber(isDigit('x'))
newline()

// a fn called from inside a const body: double(20) + 1
putNumber(plusOne(20))
putChar(' ')
// the same fn in the argument as well: double(double(3) + 1) is not what this
// says - it is double(6) + 1, with the argument evaluated via the stack
putNumber(plusOne(u8(double(3))))
newline()
