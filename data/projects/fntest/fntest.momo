// fntest.momo - fn: arguments and return values via mangled globals.

include "std/io.momo"

u16 add(u16 a, u16 b) {
  return a + b
}

i16 absolute(i16 v) {
  if (v < 0) {
    return -v
  }
  return v
}

sub emit(u8 c) {
  putChar(c)
}

// Deliberately nested: the inner call must not clobber the outer call's
// argument slots before the outer call happens.
u16 wrap(u16 a, u16 b) {
  return add(a, b) + 1
}

u16 acc
u16 i

// ---- entry ----

putNumber(add(3, 4))
newline()

// Nested call in an argument position. The numbers matter: with add(3, 4) as
// the second argument the clobber is invisible, because the inner call happens
// to overwrite slot `a` with the 3 that was already correctly in it. Picking a
// second argument whose own operands differ from the first argument's VALUE is
// what makes a broken evaluation order show up as a wrong number.
//
//   correct           3 + 70 = 73
//   without the stack add__a clobbered to 30, add__b = 70 -> 100
putNumber(add(add(1, 2), add(30, 40)))
newline()

// a fn calling a fn
putNumber(wrap(10, 20))
newline()

// signed argument, early return
putNumber(u16(absolute(-1234)))
newline()

// void fn, called as a statement
emit('o')
emit('k')
newline()

// fn call inside a loop and a compound expression
acc = 0
for (i = 1; i <= 5; i++) {
  acc = add(acc, i * i)
}
putNumber(acc)
newline()
