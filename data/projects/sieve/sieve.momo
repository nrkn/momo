// sieve.momo - Sieve of Eratosthenes.

include "std/io.momo"

const limit = 100

u8[limit] composite             // 0 = prime, 1 = composite

u16 i
u16 j
u16 count

sub runSieve {
  for (i = 2; i * i < limit; i++) {
    if (composite[i]) continue

    for (j = i * i; j < limit; j += i) {
      composite[j] = 1
    }
  }
}

// ---- entry ----

runSieve()

count = 0
for (i = 2; i < limit; i++) {
  if (composite[i]) continue

  putNumber(i)
  putChar(' ')
  count++
}

newline()
putNumber(count)
newline()
