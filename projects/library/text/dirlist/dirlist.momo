// dirlist.momo - modir (DESIGN §62).
//
// `dirtest`'s rule and `filetest`'s before it: **the test makes what it reads.**
//
// The extension is `.QQQ` because the first version used `.TXT` and matched the
// harness's own `OUT.TXT`, `STDOUT.TXT` and `STDERR.TXT` - seven entries where
// four were predicted, which is the failure this paragraph exists to warn about,
// walked into while writing it. A pattern a test creates files for has to be one
// nothing else can satisfy.
//
// **Creating the files out of order does not put them out of order.** Tier 2 runs
// under DOSBox over a *mounted host directory*, so what comes back is the host
// filesystem's order, and that is already alphabetical. Neutering the name
// comparison changed nothing and the fixture was the reason - so the sort is
// checked through the one ordering no filesystem can supply: `ZSUB` is a
// subdirectory named to sort last, and directories come first.
//
// The window and the thumb need no directory at all. What is under test there is
// arithmetic, and the interesting sizes are ratios - so they are made by
// shrinking the window rather than by creating thousands of files.

include "lib/std/io.momo"
include "lib/std/file.momo"
include "lib/modir.momo"

const u8[] fileZ = "ZED.QQQ\0"
const u8[] fileM = "MID.QQQ\0"
const u8[] fileA = "ALPHA.QQQ\0"
const u8[] fileB = "BETA.QQQ\0"

const u8[] subDir = "ZSUB\0"

const u8[] pattern = "*.QQQ\0"

// Matches `ZED.QQQ` and `ZSUB` and nothing the harness leaves behind. Two
// entries, and the right order is the reverse of the alphabetical one.
//
// **`Z*.*` rather than `Z*`**, and the difference is not cosmetic: a DOS pattern
// with no dot in it carries an empty extension, so `Z*` matches `ZSUB` and not
// `ZED.QQQ`. Measured rather than remembered - the first version found one entry
// where two were predicted.
const u8[] zPattern = "Z*.*\0"

// Inside the subdirectory, which is empty - so the only things `*.*` can match
// there are DOS's own two entries.
const u8[] subPattern = "ZSUB\\*.*\0"

const u8[] payload = "x"

const u8[] sLoaded = "loaded: $"
const u8[] sOrder  = "order:$"
const u8[] sNamed  = "named: $"
const u8[] sWindow = "window:$"
const u8[] sThumb  = "thumb:$"
const u8[] sSorted = "sorted:$"
const u8[] sDots   = "dots:$"
const u8[] sJump   = "jump:$"

u16 handle

sub make( u16 at ) {
  handle = fileCreate( at )
  fileWrite( handle, addr( payload ), 1 )
  fileClose( handle )
}

sub remove( u16 at ) {
  _ah = 0x41
  _dx = at
  int 0x21
}

// AH=39h and AH=3Ah. §38 leaves directories out of the library and this is a
// fixture rather than a capability - `dirtest` reaches past the library for
// delete in the same way and for the same reason.
sub makeDir( u16 at ) {
  _ah = 0x39
  _dx = at
  int 0x21
}

sub removeDir( u16 at ) {
  _ah = 0x3A
  _dx = at
  int 0x21
}

// **ASCIZ, so it is copied out and terminated here.** `putStr` looks for a `$`
// and would run off the end of a name into the next entry - which in this
// fixture happens to be zeroes, so the wrong version would print correctly and
// prove nothing.
u8[listNameMax + 1] shown

sub showName( u16 i ) {
  u16 at
  u16 n

  at = listName( i )
  n = 0
  while ( peek8( at + n ) != 0 ) {
    shown[n] = peek8( at + n )
    n++
  }

  shown[n] = '$'
  putStr( addr( shown ) )
  putChar( ' ' )
  putNumber( u16( listIsDir( i ) ) )
  newline()
}

// ---- four files and a directory ----

make( addr( fileZ ) )
make( addr( fileM ) )
make( addr( fileA ) )
make( addr( fileB ) )
makeDir( addr( subDir ) )

listLoad( addr( pattern ), dirNormal )

putStr( addr( sLoaded ) )
putNumber( listCount() )
putChar( ' ' )
putNumber( u16( listOverflowed() ) )
newline()

putStr( addr( sOrder ) )
newline()

for ( u16 i = 0; i < listCount(); i++ ) {
  showName( i )
}

// ---- which entry is a given name, without holding an index ----

putStr( addr( sNamed ) )
putNumber( u16( listIsNamed( 0, addr( fileA ) ) ) )
putChar( ' ' )
putNumber( u16( listIsNamed( 1, addr( fileA ) ) ) )
newline()

// ---- the window, which is §56's shape at a smaller size ----

sub showWindow {
  putNumber( listTop() )
  putChar( ' ' )
  putNumber( listCursor() )
  newline()
}

listSize( 2 )
listHome()

putStr( addr( sWindow ) )
newline()

showWindow()                    // 0 0

listDown()
showWindow()                    // 0 1

// The third entry is past a window of two, so the top follows by the least that
// brings the cursor back.
listDown()
showWindow()                    // 1 2

listEnd()
showWindow()                    // 2 3

// Clamped at both ends rather than wrapping, because a list is not a ring.
listDown()
showWindow()                    // 2 3

listHome()
showWindow()                    // 0 0

listUp()
showWindow()                    // 0 0

// ---- the thumb ----

sub showThumb {
  putNumber( listThumbSize() )
  putChar( ' ' )
  putNumber( listThumbAt() )
  newline()
}

putStr( addr( sThumb ) )
newline()

// A window that holds everything: the thumb fills the track and sits at the top,
// which is what says there is nothing to scroll.
listSize( 4 )
listHome()
showThumb()                     // 4 0

// Two of four visible, so half a track. At the top, then at the bottom - and
// **the bottom is what the arithmetic is for**: a thumb that stops short of it
// is the tell of the naive formula.
listSize( 2 )
listHome()
showThumb()                     // 1 0

listEnd()
showThumb()                     // 1 1

// Three of four, which is the only size here with a position strictly between
// the ends - so it is the one that says the division and its carry agree.
listSize( 3 )
listHome()
showThumb()                     // 2 0

listEnd()
showThumb()                     // 2 1

// One row of track, and a list longer than it: the thumb cannot be zero rows or
// the bar is empty exactly when it is carrying the most information.
listSize( 1 )
listHome()
showThumb()                     // 1 0

// ---- typing at the list ----
//
// Four files whose initials are all different, so which entry a letter means is
// never in doubt. The last one is the claim that matters: `A` from the end of
// the list has to wrap, and a search that started at the cursor and ran forward
// would find nothing.

putStr( addr( sJump ) )
newline()

listSize( 4 )
listHome()

listJump( 'M' )
putNumber( listCursor() )
putChar( ' ' )

// Lower case, because DOS uppercases the names and a person does not.
listJump( 'b' )
putNumber( listCursor() )
putChar( ' ' )

listJump( 'Z' )
putNumber( listCursor() )
putChar( ' ' )

// Nothing starts with Q, and nothing moves.
listJump( 'Q' )
putNumber( listCursor() )
putChar( ' ' )

// From the last entry, wrapping to the first.
listJump( 'A' )
putNumber( listCursor() )
newline()

// ---- the sort, through the one order a filesystem cannot produce ----
//
// `ZSUB` is a directory and sorts last by name, so directories-first is the only
// thing that can put it at the top. The cursor is printed with the count because
// a load resets the window - without that, this shorter list would inherit a
// cursor from the longer one above and point past its own end.

listLoad( addr( zPattern ), dirDirectory )

putStr( addr( sSorted ) )
newline()

putNumber( listCount() )
putChar( ' ' )
putNumber( listCursor() )
newline()

for ( u16 i = 0; i < listCount(); i++ ) {
  showName( i )
}

// ---- `.` is skipped and `..` is not ----
//
// An empty subdirectory holds exactly two entries and both of them are DOS's.
// `.` names the directory already being shown and can never do anything; `..` is
// the only way out of a subdirectory for a caller that does not take paths, and a
// panel that can be descended into and not left is worse than one with no
// directories at all.
//
// So the count here is the whole claim: two entries exist, one survives.

listLoad( addr( subPattern ), dirDirectory )

putStr( addr( sDots ) )
newline()

putNumber( listCount() )
newline()

for ( u16 i = 0; i < listCount(); i++ ) {
  showName( i )
}

remove( addr( fileZ ) )
remove( addr( fileM ) )
remove( addr( fileA ) )
remove( addr( fileB ) )
removeDir( addr( subDir ) )
