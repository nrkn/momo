// momolo.momo - the cross-check harness.
//
// Runs every scene in scenes/shell.momo through the engine and prints the resolved
// boxes as bare numbers, one line per element:
//
//   i x y w h minW minH oX oY
//
// momolo.expected holds the same numbers produced by the TypeScript engine this
// was ported from, running the same subset of passes and stopping at the same
// one - the vertical sizing pass, after which nothing else moves a box. They are
// concatenated in the order the entry section below runs the scenes: shell,
// sizing, capped, squeeze, overflow, alignment, wrapping.
//
// A scene is appended rather than inserted, so the numbers a scene already had
// keep the lines they had and a diff shows only what arrived.
//
// Two independent implementations of one algorithm agreeing on every integer is
// the point of the exercise, and this project is the whole of that claim.
//
// Nothing here draws. `mlodemo` is the project that puts a scene on the screen,
// and it shares these scenes rather than spelling them a second time - so the
// picture you look at is built from the tree these numbers verified.

include "lib/std/io.momo"
include "scenes/shell.momo"

// A number and its separator. All but the last column wants one, and a sub is
// shorter than a bare `space()` on its own line eight times - Momo ends a
// statement at a newline, so there is no way to put the pair on one line.
//
// The overflow columns are bools read into a u16 argument, which is free: a bool
// is genuinely 0 or 1, and only the reverse direction is restricted (DESIGN §3).
sub putField( u16 n ) {
  putNumber( n )
  space()
}

sub dumpBoxes {
  for ( u16 i = 0; i < elCount; i++ ) {
    putField( i )
    putField( el[i].x )
    putField( el[i].y )
    putField( el[i].w )
    putField( el[i].h )
    putField( el[i].minW )
    putField( el[i].minH )
    putField( el[i].overflowX )
    putNumber( el[i].overflowY )
    newline()
  }
}

// ---- entry ----------------------------------------------------------------

paint( 80 * u, 25 * lineHeight ) {
  buildShell()
}
runPasses()
dumpBoxes()

paint( 40 * u, 10 * lineHeight ) {
  buildSizing()
}
runPasses()
dumpBoxes()

paint( 30 * u, 3 * lineHeight ) {
  buildCapped()
}
runPasses()
dumpBoxes()

paint( 40 * u, 15 * lineHeight ) {
  buildSqueeze()
}
runPasses()
dumpBoxes()

paint( 20 * u, 3 * lineHeight ) {
  buildOverflow()
}
runPasses()
dumpBoxes()

paint( 40 * u, 13 * lineHeight ) {
  buildAlignment()
}
runPasses()
dumpBoxes()

paint( 52 * u, 9 * lineHeight ) {
  buildWrapping()
}
runPasses()
dumpBoxes()
