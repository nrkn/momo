// momolo.momo - the cross-check harness.
//
// Runs every scene in scenes/shell.momo through the engine and prints the resolved
// boxes as bare numbers, one line per element:
//
//   i x y w h minW minH oX oY
//
// momolo.expected holds the same numbers generated by the TypeScript engine in
// the clay study, running the same subset of passes, concatenated in the order
// below:
//
//   npm run reference -- --demo=shell     --stage=sizeY
//   npm run reference -- --demo=sizing    --stage=sizeY
//   npm run reference -- --demo=capped    --stage=sizeY
//   npm run reference -- --demo=squeeze   --stage=sizeY
//   npm run reference -- --demo=overflow  --stage=sizeY
//   npm run reference -- --demo=alignment --stage=sizeY
//
// Two independent implementations of one algorithm agreeing on every integer is
// the point of the exercise, and this project is the whole of that claim.
//
// Nothing here draws. `mlodemo` is the project that puts a scene on the screen,
// and it shares these scenes rather than spelling them a second time - so the
// picture you look at is built from the tree these numbers verified.

include "lib/std/io.momo"
include "scenes/shell.momo"

// A number and its separator. All but the last column wants one, and a sub is
// shorter than a bare `space()` on its own line eight times - Momo ends a
// statement at a newline, so there is no way to put the pair on one line.
//
// The overflow columns are bools read into a u16 argument, which is free: a bool
// is genuinely 0 or 1, and only the reverse direction is restricted (DESIGN §3).
sub putField( u16 n ) {
  putNumber( n )
  space()
}

sub dumpBoxes {
  for ( u16 i = 0; i < elCount; i++ ) {
    putField( i )
    putField( el[i].x )
    putField( el[i].y )
    putField( el[i].w )
    putField( el[i].h )
    putField( el[i].minW )
    putField( el[i].minH )
    putField( el[i].overflowX )
    putNumber( el[i].overflowY )
    newline()
  }
}

// ---- entry ----------------------------------------------------------------

paintBegin( 80 * u, 25 * lineHeight )
buildShell()
closeBox()
runPasses()
dumpBoxes()

paintBegin( 40 * u, 10 * lineHeight )
buildSizing()
closeBox()
runPasses()
dumpBoxes()

paintBegin( 30 * u, 3 * lineHeight )
buildCapped()
closeBox()
runPasses()
dumpBoxes()

paintBegin( 40 * u, 15 * lineHeight )
buildSqueeze()
closeBox()
runPasses()
dumpBoxes()

paintBegin( 20 * u, 3 * lineHeight )
buildOverflow()
closeBox()
runPasses()
dumpBoxes()

paintBegin( 40 * u, 13 * lineHeight )
buildAlignment()
closeBox()
runPasses()
dumpBoxes()
