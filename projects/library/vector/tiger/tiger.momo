// tiger.momo - the acceptance test, digested.
//
// The Ghostscript tiger, filled and stroked at 320x200, summarised into 339 lines
// that the vector study generates independently:
//
//   0..199    y count sumX      per scanline: pixels drawn, and the sum of their x
//   200..337  i colour count    per path: its fill colour and pixels drawn
//   338       hash              a rolling hash over every pixel, in draw order
//
// **Why a digest.** The tiger draws about 93,000 pixels. As a `.expected` file that
// is megabytes and as a diff it is unreadable, so what gets compared is a summary -
// and the summary is chosen to be hard to satisfy wrongly. Count and sum are
// order-independent, which is exactly why the hash is there: neither can tell a
// picture from the same picture painted in a different sequence, and painting order
// is the whole of what makes 138 overlapping paths look like a tiger.
//
// **It digests what was drawn, not what remains visible.** There is no framebuffer
// here to digest - 320x200 bytes is 64,000, against 37.9 KB of path data in a 64 KB
// segment - so an overdrawn pixel counts twice, on both sides. That is a complete
// claim about what the rasteriser produced and a weaker one about the final image.
// The image is `tigerpic`, and it is judged by eye, because that is what a
// picture is for.
//
// The data is shared with that project rather than copied: it lives at
// `scenes/tiger.momo`, which this program, tigerpic and tzoom all include by the
// same name. No project owns it, so none of them has to know where the others
// are.

// The crossing budget, sized by the study against this dataset. Must precede the
// momovec includes: an array dimension is needed where the array is declared, so
// unlike `plot` and `emitSpan` this cannot bind late.
//
// 1,024 against a measured worst single path of 692, on the tiger.
const maxCrossings = 1024

include "lib/std/io.momo"
include "lib/std/math.momo"
include "lib/momovec/direct.momo"
include "lib/momovec/types.momo"
include "lib/momovec/edges.momo"
include "lib/momovec/subdiv.momo"
include "lib/momovec/path.momo"
include "lib/momovec/fill.momo"

// Included before the arrays below, because it declares the bounds they are sized
// by - and those bounds are generated with the data rather than written here, so
// nothing carries a hand-maintained count of 138.
include "scenes/tiger.momo"

// The digest, accumulated as pixels are emitted.
u16[screenH] rowPixels
u16[screenH] rowSumX
u16[maxPaths] pathPixels
u16 orderHash

// Which path is being drawn, so its pixels can be counted against it. A global
// rather than a parameter because `plot` is called by the library, which knows
// nothing about paths.
u16 currentPath

// What a span means here: fill it. The library has no opinion - momovec's
// emitSpan prints one instead, from the same rasteriser.
//
// Spans arrive already clipped to the canvas, so this loop needs no bounds test of
// its own. That is the whole value of clipping at the span rather than the pixel:
// it saves almost no writes and takes a compare and a branch out of the innermost
// loop in the program.
sub emitSpan( u16 y, i16 x0, i16 x1 ) {
  i16 x

  for ( x = x0; x <= x1; x++ ) {
    plot( x, i16( y ) )
  }
}

sub plot( i16 x, i16 y ) {
  u16 ux
  u16 uy

  // Clipped here rather than in the rasteriser, so the digest counts what a screen
  // would have received. The library hands over everything it draws.
  if ( x < 0 ) return
  if ( y < 0 ) return
  if ( x > xMax ) return
  if ( y > yMax ) return

  ux = u16( x )
  uy = u16( y )

  rowPixels[ uy ] += 1
  rowSumX[ uy ] += ux
  pathPixels[ currentPath ] += 1

  // Order-sensitive, which the counters above are not. 31 is arbitrary and shared
  // with the study; what matters is that a different painting sequence gives a
  // different number.
  orderHash = orderHash * 31 + ux + uy
}

u16 i
u16 p

for ( i = 0; i < screenH; i++ ) {
  rowPixels[i] = 0
  rowSumX[i] = 0
}

for ( p = 0; p < maxPaths; p++ ) {
  pathPixels[p] = 0
}

orderHash = 0

// Paths in order, each filled then stroked. Array order IS declaration order for
// an immediate-mode builder, so this is paint order and there is no command list
// to sort - the same property momolo relied on.
for ( p = 0; p < maxPaths; p++ ) {
  currentPath = p

  if ( pathHasFill[p] != 0 ) {
    fillPath( p, true )
  }

  if ( pathHasStroke[p] != 0 ) {
    strokePath( p )
  }
}

// ---- the digest ----

for ( i = 0; i < screenH; i++ ) {
  putNumber( i )
  space()
  putNumber( rowPixels[i] )
  space()
  putNumber( rowSumX[i] )
  newline()
}

for ( p = 0; p < maxPaths; p++ ) {
  putNumber( p )
  space()
  putNumber( pathFill[p] )
  space()
  putNumber( pathPixels[p] )
  newline()
}

putNumber( orderHash )
newline()

// A capacity problem must not look like a rasteriser bug. The tiger's worst single
// path was measured at 692 crossings against a list of 1,024, so this should never
// fire - and if it does, it says so rather than quietly drawing a wrong tiger.
if ( crossingsOverflowed ) {
  putStr( addr( overflowed ) )
  newline()
}

const u8[] overflowed = "CROSSING LIST OVERFLOWED$"
