// strtest.momo - std/str.momo, the library peek8 and poke8 unlocked.
//
// Every routine here takes an address rather than an array, which is the whole
// point: before peek8 there was no way to write one that a second caller could
// reuse. So each case calls the library twice, on different buffers, and prints
// what it got - the same routine, no second copy of the loop.

include "lib/std/io.momo"
include "lib/std/str.momo"

const u8[] hello = "hello$"
const u8[] world = "world!$"
const u8[] empty = "$"
const u8[] path  = "hp 10/10$"

u8[16] buffer
u8[16] other

u16 found

// ---- entry ----

// strLen, on three different strings and one empty one.
putNumber( strLen( addr( hello ) ) )        // 5
newline()
putNumber( strLen( addr( world ) ) )        // 6
newline()
putNumber( strLen( addr( empty ) ) )        // 0
newline()

// strCopy carries the terminator, so the copy is a string too - strLen of it
// agreeing is the check that it did.
strCopy( addr( buffer ), addr( world ) )
putNumber( strLen( addr( buffer ) ) )       // 6
newline()
putStr( addr( buffer ) )                    // world!
newline()

// A copy compares equal to its source; two different strings do not, and the
// sign says which way round. 'h' is 104 and 'w' is 119, so hello - world is -15.
putNumber( u16( strCmp( addr( buffer ), addr( world ) ) ) )   // 0
newline()
putNumber( u16( strCmp( addr( hello ), addr( world ) ) ) )    // -15 = 65521
newline()
putNumber( u16( strCmp( addr( world ), addr( hello ) ) ) )    // 15
newline()

// A prefix sorts before the longer string: "hello" against "hello$" plus more.
strCopy( addr( other ), addr( hello ) )
poke8( addr( other ) + 5, '!' )
poke8( addr( other ) + 6, '$' )
putNumber( u16( strCmp( addr( hello ), addr( other ) ) ) )    // '$' - '!' = 3
newline()

// strFind returns an address, so the useful thing to print is the offset.
found = strFind( addr( path ), '/' )
putNumber( found - addr( path ) )           // 5
newline()

// Absent gives 0, which no real address can be.
putNumber( strFind( addr( path ), 'z' ) )   // 0
newline()

// Searching for the terminator finds it, at the length.
found = strFind( addr( path ), '$' )
putNumber( found - addr( path ) )           // 8
newline()

// memFill then memCopy, so the fill is visible in what the copy did not touch.
memFill( addr( buffer ), len( buffer ), '.' )
memCopy( addr( buffer ), addr( world ), 3 )
poke8( addr( buffer ) + 8, '$' )
putStr( addr( buffer ) )                    // wor.....
newline()

// memFill with a number rather than a character, read back through the array it
// filled - the two names for those bytes must agree.
memFill( addr( other ), 4, 7 )
putNumber( other[0] )                       // 7
newline()
putNumber( other[3] )                       // 7
newline()
putNumber( other[4] )                       // 111, left over from "hello" above
newline()

// strNumber: two answers, because the failing one has no number in it.
const u8[] nOk   = "1234"
const u8[] nBad  = "12x4"
const u8[] nBig  = "120000"
const u8[] nMax  = "65535"
const u8[] nOver = "65536"

sub showNum( u16 at, u16 n ) {
  putNumber( u16( strNumber( at, n ) ) )
  putChar( ' ' )
  putNumber( strValue() )
  newline()
}

showNum( addr( nOk ), len( nOk ) )          // 1 1234

// A digit that is not one refuses the whole answer, and leaves nothing behind
// for a caller who forgot to look at the bool.
showNum( addr( nBad ), len( nBad ) )        // 0 0

// No characters is not the number zero.
showNum( addr( nOk ), 0 )                   // 0 0

// Past what a u16 holds is a refusal rather than a wrap.
showNum( addr( nBig ), len( nBig ) )        // 0 0

// The two sides of the boundary, which is where an off-by-one in the overflow
// test would live and nowhere else.
showNum( addr( nMax ), len( nMax ) )        // 1 65535
showNum( addr( nOver ), len( nOver ) )      // 0 0

// ---- a number as text, which is the other direction ------------------------
//
// Written into a buffer and then printed through `putStr`, so what is checked is
// the bytes that landed rather than a second formatter agreeing with the first.
// The length is printed beside them because it is half the interface: a caller
// placing anything after the number is trusting it.

u8[16] buf

sub showText( u16 n ) {
  u16 used

  used = numText( addr( buf ), n )
  poke8( addr( buf ) + used, '$' )

  putNumber( used )
  putChar( ' ' )
  putStr( addr( buf ) )
  newline()
}

sub showRight( u16 n, u16 width ) {
  u16 used

  used = numRight( addr( buf ), n, width, '.' )
  poke8( addr( buf ) + used, '$' )

  putNumber( used )
  putChar( ' ' )
  putStr( addr( buf ) )
  newline()
}

// Zero is one digit, not none - a caller advancing by the return would otherwise
// write over it.
showText( 0 )                               // 1 0
showText( 7 )                               // 1 7
showText( 4096 )                            // 4 4096

// The widest a u16 gets, which is what `numMaxDigits` is sized for.
showText( 65535 )                           // 5 65535

// Right-aligned, padded, and the width comes back.
showRight( 7, 5 )                           // 5 ....7
showRight( 65535, 5 )                       // 5 65535

// **Too wide runs over rather than losing a digit**, and the return says so.
// A gutter dropping the leading 1 of 10000 would be wrong exactly where it is
// being relied on.
showRight( 10000, 3 )                       // 5 10000

// `numWidth` without writing anything, which is what `numRight` asks first.
putNumber( numWidth( 0 ) )
putChar( ' ' )
putNumber( numWidth( 9 ) )
putChar( ' ' )
putNumber( numWidth( 10 ) )
putChar( ' ' )
putNumber( numWidth( 65535 ) )
newline()                                   // 1 1 2 5

// Always four digits, because the reader is comparing rows.
numHex( addr( buf ), 0x73E0 )
poke8( addr( buf ) + 4, '$' )
putStr( addr( buf ) )
newline()                                   // 73E0

numHex( addr( buf ), 0x000F )
poke8( addr( buf ) + 4, '$' )
putStr( addr( buf ) )
newline()                                   // 000F

// ---- a text file as a string table ------------------------------------------
//
// The parse `keyprobe` reads its question list with, tested here because that
// program blocks on a keyboard and can never be run by a tier. What it does is
// small and every part of it is an off-by-one waiting to happen: the terminator
// that replaces a newline, the one that has to be added when there is no final
// newline, and the three kinds of line that produce nothing.
//
// **It rewrites its input**, so the fixture is a writable buffer rather than a
// `const` - and each case gets a fresh copy, because a parse that consumed its
// own output would pass the first time and only the first time.

u8[128] lines

sub loadLines( u16 at, u16 n ) {
  memCopy( addr( lines ), at, n )
}

// The table, printed as `count: a|b|c`, so a missing terminator and a spurious
// one look different from each other.
// **No trailing space on an empty table**, which is why the separator goes
// before each entry rather than after the count. The harness trims the very end
// of its output and nowhere else, so a line that stops being last is a line that
// grows a space - and this file has produced that failure before.
sub showLines( u16 n ) {
  u16 total
  u16 count

  total = strLines( addr( lines ), n )
  count = countStrs( addr( lines ), total )

  putNumber( count )
  putStr( addr( sColon ) )

  for ( u16 i = 0; i < count; i++ ) {
    putChar( i > 0 ? 124 : 32 )
    putStr( nthStr( addr( lines ), i ) )
  }

  newline()
}

u16 countStrs( u16 at, u16 bytes ) {
  u16 n
  n = 0

  for ( u16 i = 0; i < bytes; i++ ) {
    if ( peek8( at + i ) == strEnd ) n++
  }

  return n
}

const u8[] sColon = ":$"

// Three lines, DOS endings, and a final newline.
const u8[] plain = "one\r\ntwo\r\nthree\r\n"

// The same without the last newline, which is what an editor that does not add
// one produces - and the case that loses an entry if nothing terminates it.
const u8[] noEnd = "one\r\ntwo\r\nthree"

// Blank lines, a comment, and an indented line: a file laid out to be read.
const u8[] laidOut = "# what this asks\r\n\r\none\r\n\r\n  two\r\n# and why\r\nthree\r\n"

// Nothing but comments and blanks, which is a file somebody started and did not
// finish - an empty table rather than one entry of nothing.
const u8[] allSkip = "# only this\r\n\r\n"

loadLines( addr( plain ), len( plain ) )
showLines( len( plain ) )               // 3: one|two|three

loadLines( addr( noEnd ), len( noEnd ) )
showLines( len( noEnd ) )               // 3: one|two|three

loadLines( addr( laidOut ), len( laidOut ) )
showLines( len( laidOut ) )             // 3: one|two|three

loadLines( addr( allSkip ), len( allSkip ) )
showLines( len( allSkip ) )               // 0:
