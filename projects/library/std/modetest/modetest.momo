// modetest.momo - std/mode.momo (DESIGN §43).
//
// Text modes only for the geometry that has to be exact, because mode 3 is
// 80x25 on everything that can run this at all. The tall mode is asserted as an
// *inequality*, which is the honest claim: it is 43 rows on EGA and 50 on VGA
// from an identical pair of calls, and that the descriptor knows which is the
// whole reason it reads the BIOS back instead of trusting the table.
//
// Setting a mode clears the display and this program prints through DOS, which
// tier 2 redirects to a file - so the output is unaffected by what is on screen.

include "lib/std/io.momo"
include "lib/std/mode.momo"

u16 tall

videoMode {
  // ---- 80x25, where every field is known

  setMode( modeText )

  putNumber( screenWidth() )
  putChar( ' ' )
  putNumber( screenHeight() )
  newline()

  putNumber( screenSegment() )
  putChar( ' ' )
  putNumber( u16( screenElemBytes() ) )
  newline()

  // Width and stride coincide for every mode in the table, and the API keeps them
  // apart anyway - see the comment on screenStride.
  putNumber( u16( screenStride() == screenWidth() ) )
  newline()

  // ---- the tall text mode, where only the inequality is portable

  setMode( modeTall )
  tall = screenHeight()

  putNumber( u16( screenWidth() == 80 ) )
  putChar( ' ' )
  putNumber( u16( tall > 25 ) )
  newline()

  // ---- mode 13h, which reports 40 columns to the BIOS and 320 to us

  setMode( modeGfx256 )

  putNumber( screenWidth() )
  putChar( ' ' )
  putNumber( screenHeight() )
  newline()

  putNumber( screenSegment() )
  putChar( ' ' )
  putNumber( u16( screenElemBytes() ) )
  newline()

  // ---- the row table

  screenRowsInit()

  putNumber( screenRow( 0 ) )
  putChar( ' ' )
  putNumber( screenRow( 1 ) )
  putChar( ' ' )
  putNumber( screenRow( 199 ) )
  newline()

  // The close is restoreMode, emitted by videoMode (§48).
}

// ---- restoring empties the descriptor rather than leaving a stale answer

putNumber( screenWidth() )
putChar( ' ' )
putNumber( screenSegment() )
newline()

// ---- a tall mode survives save and restore, which the number cannot say
//
// The claim is a *round trip* rather than a row count, for the reason the tall
// mode above is asserted as an inequality: 43 and 50 are both right and the
// adapter decides. So the height is taken before and compared after, and the
// middle of the block sets the short mode so that a restore doing nothing would
// leave 25 rows behind and be seen.

setMode( modeTall )
tall = screenHeight()

videoMode {
  setMode( modeText )

  putNumber( u16( screenHeight() == 25 ) )
  newline()
}

// The descriptor was emptied by the restore, so the hardware is what gets asked.
putNumber( u16( adoptMode() ) )
putChar( ' ' )
putNumber( u16( screenWidth() == 80 ) )
putChar( ' ' )
putNumber( u16( screenHeight() == tall ) )
newline()

// ---- a graphics mode is refused, which is what makes the fallback reachable

setMode( modeGfx256 )

putNumber( u16( adoptMode() ) )
newline()

// ---- mode 7, which is describable and not necessarily usable
//
// Set through the BIOS rather than through the table, because the table is the
// modes a program here can *use* and nothing draws to 0xB000 - a row for it
// would be capacity with no consumer. This is a fixture, not a capability.
//
// The claim is that the descriptor tells the truth about a text mode the caller
// will have to turn down, which is what makes turning it down possible: `momoed`
// nails `vram` to 0xB800 for §43's own reason and asks the segment before it
// trusts the geometry. Without this, `mode mono` gave it a screen it wrote 2,000
// cells into and nobody could see.

_ah = 0x00
_al = 0x07
int 0x10

putNumber( u16( adoptMode() ) )
putChar( ' ' )
putNumber( screenSegment() )
newline()

// Leave the display the way this program found it.
setMode( modeText )

// ---- the DAC conversion, which is arithmetic and needs no hardware

putNumber( u16( dac8( 0 ) ) )
putChar( ' ' )
putNumber( u16( dac8( 4 ) ) )
putChar( ' ' )
putNumber( u16( dac8( 255 ) ) )
newline()
