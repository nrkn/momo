// fixmul.momo - fixMul on the 8086, against products worked out by hand, and
// `*` checked against fixMul called by name.
//
// Tier 2 rather than golden, and that is the point: the golden tier can only say
// the assembly did not change, and `lib/std/fixed.momo` is the first part of
// DESIGN §25 where plausible-looking code can still compute the wrong number.
// Every figure in `fixmul.expected` was derived by hand from the kernel before
// this was ever run.
//
// Each pair is printed twice - once through an explicit `fixMul` call and once
// through `*`, which the compiler lowers to exactly that call. The two lines must
// agree, so the reference and the sugar check each other rather than both being
// checked against the same guess.
//
// Printed as unsigned words, because `putNumber` takes a u16 - so -3.0 shows as
// 64768 rather than as -768. That is a bit pattern rather than a value, which
// makes it a stricter check, not a looser one.

include "lib/std/io.momo"
include "lib/std/fixed.momo"

// By name. `raw` carries the bits into a routine written in plain integers.
sub show( i8.8 x, i8.8 y ) {
  putNumber( u16( fixMul( raw i16( x ), raw i16( y ) ) ) )
  newline()
}

// Through `*`. The compiler writes the same two `raw` casts and the same call.
sub showOp( i8.8 x, i8.8 y ) {
  i8.8 p
  p = x * y
  putNumber( raw u16( p ) )
  newline()
}

sub both( i8.8 x, i8.8 y ) {
  show( x, y )
  showOp( x, y )
}

// Exact in 8.8 on both sides, so these are the products or nothing is.
both( 1.5, 2.0 )              // 3.0    -> 768
both( 1.5, 1.5 )              // 2.25   -> 576
both( 0.5, 0.5 )              // 0.25   -> 64
both( 10.0, 3.0 )             // 30.0   -> 7680
both( 1.0, 1.0 )              // 1.0    -> 256

// One step of 8.8 is 1/256, and 0.00390625 is exactly that - so this checks the
// smallest thing the type can hold survives a multiply by one.
both( 0.00390625, 1.0 )       // 1/256  -> 1

// 0.1 is 25.6 and stores as 26, so this is the product of what was stored rather
// than of what was written: 26*26 >> 8 is 2.
both( 0.1, 0.1 )              // ~0.01  -> 2

// Near the top of the range without leaving it.
both( 127.0, 1.0 )            // 127.0  -> 32512

// Sign, all four ways round.
both( -1.5, 2.0 )             // -3.0   -> 64768
both( 1.5, -2.0 )             // -3.0   -> 64768
both( -1.5, -2.0 )            // 3.0    -> 768

// Truncation toward zero, which is what magnitude-and-sign gives and what an
// arithmetic shift would not: -2, where `sar` would have produced -3.
both( -0.1, 0.1 )             // -2     -> 65534

// And one that overflows i8.8 deliberately, because wrapping is documented
// behaviour rather than an accident: 200.0 does not fit, and the low word is what
// 16-bit arithmetic always gives.
both( 100.0, 2.0 )            // wraps  -> 51200

// The unsigned path, which lowers to fixMulU instead. 200.0 is out of range for
// i8.8 and comfortably inside u8.8, so this is a value the signed cases cannot
// reach.
sub showU( u8.8 x, u8.8 y ) {
  u8.8 p
  p = x * y
  putNumber( raw u16( p ) )
  newline()
}

showU( 1.5, 2.0 )             // 3.0    -> 768
showU( 200.0, 1.0 )           // 200.0  -> 51200

// The intrinsic against the four-multiply reference, over 256 pairs that cross
// the byte boundary in both operands. This is what building the portable version
// first was for: the fast one has something to be wrong against.
//
// Both figures are predictions, not observations. 16 values of each operand is
// 256 pairs, and they must agree on every one.
u16 checked
u16 differ

// Counted by index rather than by value, and deliberately: stepping `a` by 4097
// until `a < 65535` fails never terminates, because 61455 + 4097 wraps to 16. A
// u16 loop counter cannot be bounded by a value near the top of its own range.
sub compare {
  u16 i
  u16 j
  u16 a
  u16 b

  checked = 0
  differ = 0

  for ( i = 0; i < 16; i++ ) {
    a = i * 4097
    for ( j = 0; j < 16; j++ ) {
      b = j * 4097
      checked = checked + 1
      if ( fixMulU( a, b ) != fixMulUParts( a, b ) ) {
        differ = differ + 1
      }
    }
  }
}

compare()
putNumber( checked )          // 256 pairs, so the loop really ran
newline()
putNumber( differ )           // 0
newline()

// The fold against the instructions. `mulshr8` on two constants is computed by
// the resolver and never reaches the emitter, so the two have to agree exactly or
// one source line means two things depending on where its operands came from.
// Nothing else in the suite calls it with two constants, so nothing else can tell.
const folded = mulshr8( 384, 512 )

u16 lhs
u16 rhs
u16 atRuntime

lhs = 384
rhs = 512
atRuntime = mulshr8( lhs, rhs )

putNumber( folded )           // 1.5 * 2.0, folded    -> 768
newline()
putNumber( atRuntime )        // the same, emitted    -> 768
newline()
