// smoke.momo - exercises as much of the language as possible in as little code
// as possible. Serves as the parser test fixture, and later as an end-to-end
// test: it must assemble, run, and print checkable output.

// ---- constants ------------------------------------------------------------

const limit     = 20                // untyped scalar -> NASM `equ`, no storage
const base      = 10
const maxDigits = 5
const zeroChar  = '0'               // char literal
const mask      = 0x7F              // hex literal
const stripe    = 0b1010_1010       // binary literal with digit separators

const u8[] banner = "smoke\r\n$"    // string literal -> u8 array
const u8[] fizz   = "fizz $"
const u8[] buzz   = "buzz $"

const squares = [                   // element type inferred from widest value
  0,  1,  4,
  9, 16, 25
]

// ---- globals --------------------------------------------------------------

u8[maxDigits] digits                // const-folded size, zero-filled
u8[3]         spare                 // sized, zero-filled
u8[6]         partial = [ 1, 2, 3 ] // tail zero-filled
u8[]          table   = [ 2, 4, 6, 8 ]

u16  value
u16  strAddr
u8   char
u8   hash
i16  signedAcc = -1                 // negative literal -> i16
i8   delta     = -3
bool done      = false

u16  divN
u16  divD
bool divResult

// Values chosen so signed and unsigned byte compares disagree: 200 is 0xC8,
// negative if misread as signed, and -5 is 0xFB, large if misread as unsigned.
u8   bigByte   = 200
u8   smallByte = 100
i8   negByte   = -5
i8   posByte   = 100

// ---- output ---------------------------------------------------------------

sub putChar {
  _ah = 0x02
  _dl = char
  int 0x21
}

sub putStr {
  _ah = 0x09
  _dx = strAddr
  int 0x21
}

sub newline {
  char = 13
  putChar()
  char = 10
  putChar()
}

sub peekKey {
  _ah = 0x01                        // non-blocking: check, do not wait
  int 0x16                          // second INT number -> second helper
  char = _al
}

u8 spaceCount

sub putSpaces {
  while (spaceCount > 0) {
    char = ' '
    putChar()
    spaceCount--
  }
}

/* Block comments do not nest, and one spanning lines counts as a newline
   for statement termination. */
sub putBar {
  u8 n

  // Assigned, not initialised: a sub-local is static storage, so an initialiser
  // would set n once at load and a second call to putBar would start at 3.
  n = 0

  do {
    char = '-'
    putChar()
    n++
  } while (n < 3)
}

// value -> decimal, most significant digit first
sub putNumber {
  u8  i                             // sub-local: static storage, scoped name
  u16 n

  n = value

  if (n == 0) {
    char = zeroChar
    putChar()
    return                          // bare early exit
  }

  for (i = 0; n > 0; i++) {
    digits[i] = u8(n % base) + zeroChar
    n /= base
  }

  for (; i > 0; i--) {              // empty init clause
    char = digits[i - 1]
    putChar()
  }
}

sub isDivisible {
  divResult = divN % divD == 0      // subs return nothing: results come back
}                                   // in a global, as everything else does

// ---- main loop ------------------------------------------------------------

sub run {
  for (value = 1; value <= limit; value++) {
    if (value == 13) continue
    if (value > 17) break

    putNumber()
    char = ' '
    putChar()

    divN = value
    divD = 3
    isDivisible()
    done = divResult
    if (done) {
      strAddr = addr(fizz)
      putStr()
    }

    divD = 5
    isDivisible()
    if (divResult) {
      strAddr = addr(buzz)
      putStr()
    }

    if (
      value > 3 &&                  // multi-line condition: newline is not a
      value < 9                     // terminator while bracket depth > 0
    ) {
      char = squares[value - 3] + zeroChar
      putChar()
    }

    if (value < 5) {
      char = 'a'
    } else if (value < 10) {
      char = 'b'
    } else {
      char = 'c'
    }
    putChar()

    if (!done || value == limit) {
      char = done ? '*' : value > 10 ? '#' : '.'   // nested, right-assoc
      putChar()
    }

    spaceCount = 2
    putSpaces()

    if (partial[value % 6]) {       // truthiness on an array element
      char = '+'
      putChar()
    }

    newline()
  }

  checksum()                        // forward reference: defined below
}

// ---- arithmetic -----------------------------------------------------------

sub checksum {
  u8 i

  hash = 0
  for (i = 0; ; i++) {              // empty condition + break
    hash = u8((hash << 1) ^ digits[i])
    if (i == maxDigits - 1) break
  }

  hash &= mask
  hash |= 0x20
  hash ^= 0x01
  hash >>= 1                        // u8 -> shr
  hash = u8(~hash)
  hash = u8(hash + table[1])
  hash = u8((hash & mask) | (i * 2))  // bare & | * (compound forms above)
  hash = u8(hash ^ stripe)

  signedAcc = i16(value) - 1        // u16 x signed needs an explicit cast
  signedAcc >>= 2                   // i16 -> sar, not shr
  signedAcc += delta                // i16 += i8
  signedAcc -= 2
  signedAcc *= 3
  if (signedAcc < 0) signedAcc = -signedAcc

  value = u16(signedAcc)
  value %= 100
  value <<= 1
  value = value / 2 + 1               // bare /

  if (delta != 0 && signedAcc >= 0) {
    putNumber()
    newline()
  }
}

// ---- entry ----------------------------------------------------------------

strAddr = addr(banner)
putStr()

run()

// Called twice on purpose. A sub-local is static, so if putBar's counter were
// set by an initialiser rather than an assignment it would still hold 3 on the
// second call and print one dash instead of three.
putBar()
putBar()
newline()

// Same-signedness byte operands compare in AL with no widening. The values
// make the signedness observable: misread, neither line prints its letter.
if (bigByte > smallByte) {          // unsigned: 200 > 100
  char = 'u'
  putChar()
}
if (negByte < posByte) {            // signed: -5 < 100, though 0xFB > 0x64 unsigned
  char = 'i'
  putChar()
}
newline()

peekKey()
