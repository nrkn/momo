// momolo.momo - momolo on an 8086. Chunks 1 to 4: the engine, complete bar the
// reflow seam.
//
// See PORT.md in the clay-study for the plan this follows. The engine lives in
// m_el.momo, m_fit.momo, m_bld.momo, m_size.momo and m_place.momo; this file is
// the scenes and the dump.
//
// Three scenes, all of them lifted box for box from the study's demo gallery.
// The output is one line per element, `i x y w h minW minH oX oY`, held against the
// same numbers from the TypeScript engine running the same subset of passes:
//
//   npm run reference -- --demo=shell   --stage=sizeY
//   npm run reference -- --demo=sizing  --stage=sizeY
//   npm run reference -- --demo=capped  --stage=sizeY
//   npm run reference -- --demo=squeeze --stage=sizeY
//
// concatenated in that order. Two independent implementations of one algorithm
// agreeing on every integer is the point of the exercise.
//
// `shell` exercises the most engine in one picture and was the only scene for
// three chunks. It is not enough on its own, and knowing what it cannot reach is
// worth more than the coverage it does give:
//
//   sizing   every grow in shell is uncapped, so a candidate never reaches its
//            maximum and the cap-and-remove path never runs. The middle swatch
//            of the third strip is grow(0, 8) and settles it.
//   squeeze  shell's shrink stops well above its floors, so shrink's own removal
//            never runs either, and nothing in shell overflows at all. The
//            8-wide track squeezes both paragraphs onto their longest word and
//            still does not fit.
//   capped   the other three all remove a candidate from the end of the list, or
//            from a position where order has stopped mattering, so shift-down and
//            swap-with-last cannot be told apart. Four swatches with the SECOND
//            capped can: it drops out mid-distribution, and the two units left
//            over then go to survivors that the two schemes order differently.
//
// Running three scenes also tests something one scene structurally cannot: that
// a second `begin()` reuses the element array correctly. Nothing re-zeroes a
// group, so every field has to be written by pushElement, and until there was a
// second frame that invariant was an argument rather than a result.
//
// shell is 72 columns because that is what the study's gallery uses, which keeps
// the two sides trivially comparable. A text mode screen is 80, and the scene
// should move to it once the cross-check has done its work - see PORT.md.

include "std/io.momo"
include "std/str.momo"

include "m_el.momo"
include "m_fit.momo"
include "m_bld.momo"
include "m_size.momo"
include "m_place.momo"

// One unit is one character cell, and one line of text is one cell tall. The
// study runs the same scenes against a pixel target where these are 11 and 20;
// nothing below mentions a cell, which is what makes that possible.
const u          = 1
const lineHeight = 1

// The study derives this as max(1, u >> 3), so it is one cell here and two
// pixels there. A border is not geometry - it is a decision to draw in space the
// caller reserved - so what the engine gets told is the inset.
const border = 1

// ---- the content ----------------------------------------------------------

const u8[] sMomolo   = "momolo$"
const u8[] sGeometry = "geometry$"
const u8[] sNew      = "New$"
const u8[] sOpen     = "Open$"
const u8[] sSave     = "Save$"
const u8[] sQuit     = "Quit$"
const u8[] sBody     = "wrapped text in a narrow column$"
const u8[] sCentred  = "centred on both axes$"
const u8[] sA        = "a$"
const u8[] sB        = "bbbb$"
const u8[] sC        = "cc$"
const u8[] sLeft     = "squeezed left column$"
const u8[] sRight    = "squeezed right column$"
const u8[] sReady    = "ready$"

const u8[] sAbc      = "abc$"
const u8[] sDe       = "de$"
const u8[] sFghi     = "fghi$"
const u8[] sCapFit   = "fit() - as wide as the words$"
const u8[] sCapGrow  = "grow() - converge on a common width$"
const u8[] sCapMixed = "fixed(6), grow(0, 8) capped, grow()$"

const u8[] sAlpha    = "alpha beta$"
const u8[] sGamma    = "gamma delta$"
const u8[] sTrack26  = "track of 26$"
const u8[] sTrack22  = "track of 22$"
const u8[] sTrack14  = "track of 14$"
const u8[] sTrack8   = "track of 8$"

const u8[] sAa       = "aa$"
const u8[] sBb       = "bb$"
const u8[] sCc       = "cc$"
const u8[] sDd       = "dd$"

// A paragraph's minimum width is its longest word, and that one number is the
// whole of what makes it a paragraph rather than a label. In a Momo program it is
// a compile-time constant because the string is - so shrink gets the right answer
// with no runtime word-breaking anywhere, and wrapping can wait for chunk 6.
const bodyMinW     = 7          // "wrapped"
const squeezedMinW = 8          // "squeezed"
const trackMinW    = 5          // "alpha", and "gamma" is the same length

// ---- the two kinds of text run --------------------------------------------
//
// These are paint's job and will move to m_paint.momo when it exists. They are
// here because a leaf's size has to come from somewhere, and measuring a
// monospaced string is `strLen` - which is the whole of what paint contributes to
// geometry in the cell target.

// A run that will never be broken: a menu item, a heading, a status line. It
// refuses to be narrowed, so an ancestor cannot compress past it.
u16 labelAt( u16 at ) {
  u16 n

  n = strLen( at )
  return leaf( n, lineHeight, n, lineHeight )
}

// A run that may be broken across lines. Created at its full one-line width; its
// minimum is its longest word, and nothing else about it differs.
u16 paraAt( u16 at, u16 minW ) {
  u16 n

  n = strLen( at )
  return leaf( n, lineHeight, minW, lineHeight )
}

// ---- the dump -------------------------------------------------------------

// A number and its separator. All but the last column wants one, and a sub is
// shorter than a bare `space()` on its own line eight times - Momo ends a
// statement at a newline, so there is no way to put the pair on one line.
//
// The overflow columns are bools read into a u16 argument, which is free: a bool
// is genuinely 0 or 1, and only the reverse direction is restricted (DESIGN §3).
sub putField( u16 n ) {
  putNumber( n )
  space()
}

sub dumpBoxes {
  u16 i

  for ( i = 0; i < elCount; i++ ) {
    putField( i )
    putField( el[i].x )
    putField( el[i].y )
    putField( el[i].w )
    putField( el[i].h )
    putField( el[i].minW )
    putField( el[i].minH )
    putField( el[i].overflowX )
    putNumber( el[i].overflowY )
    newline()
  }
}

sub runPasses {
  sizeX()
  sizeY()
  place()
}

// ---- shared scene pieces --------------------------------------------------
//
// The study writes these as functions taking a closure. Momo has no closures, so
// a wrapper becomes an open/close pair and the caller writes the body between
// them - which is what PORT.md meant by "the openBox/closeBox pair is what ports,
// and the closure is a TypeScript convenience only".

// A caption above a strip of content.
sub stripOpen( u16 caption ) {
  cfgCol()
  cfgGrowW()
  openBox()

    labelAt( caption )

    cfgGrowW()
    cfg.gap = u
    openBox()
}

sub stripClose {
  closeBox()                    // the row of content
  closeBox()                    // the captioned column
}

// A centred label in a panel. The width is whatever the caller left in cfg,
// which works because cfg is not spent until openBox - so the four wrappers
// below differ only in how they set it.
local sub swatchBody( u16 at ) {
  cfgInsetX( u )
  cfg.alignMain = alignCenter
  openBox()
    labelAt( at )
  closeBox()
}

sub swatchFit( u16 at ) => swatchBody( at )

sub swatchGrow( u16 at ) {
  cfgGrowW()
  swatchBody( at )
}

sub swatchFixed( u16 at, u16 n ) {
  cfgFixedW( n )
  swatchBody( at )
}

// The one that matters here: a grow with a ceiling, so the candidate drops out
// of the convergence loop when it reaches it.
sub swatchCapped( u16 at, u16 n ) {
  cfgGrowW()
  cfg.wMax = n
  swatchBody( at )
}

// ---- scene: shell ---------------------------------------------------------

sub buildShell {
  // ---- the frame
  cfgCol()
  cfgGrowW()
  cfgGrowH()
  openBox()

    // ---- title bar. The empty grow box between the two labels is a spacer -
    // it is how you push something to the far end without a dedicated
    // alignment rule for it.
    cfgGrowW()
    cfgFixedH( lineHeight )
    cfgInsetX( u )
    openBox()
      labelAt( addr( sMomolo ) )
      cfgGrowW()
      openBox()
      closeBox()
      labelAt( addr( sGeometry ) )
    closeBox()

    // ---- body: a fixed sidebar and a growing pane
    cfgGrowW()
    cfgGrowH()
    cfgInset( u )
    cfg.gap = u
    openBox()

      // ---- sidebar. The study's paint layer adds a border's width to the
      // inset before handing it over, because a border reserves geometry the
      // engine has to know about while remaining something the engine never
      // hears of. There is no paint layer yet, so it is added here.
      cfgCol()
      cfgFixedW( 16 * u )
      cfgGrowH()
      cfgInset( u + border )
      openBox()
        labelAt( addr( sNew ) )
        labelAt( addr( sOpen ) )
        labelAt( addr( sSave ) )
        labelAt( addr( sQuit ) )
        cfgFixedH( lineHeight )
        openBox()
        closeBox()
        paraAt( addr( sBody ), bodyMinW )
      closeBox()

      // ---- main pane
      cfgCol()
      cfgGrowW()
      cfgGrowH()
      cfgInset( u + border )
      cfg.gap = u
      cfg.alignMain = alignCenter
      cfg.alignCross = alignCenter
      openBox()
        labelAt( addr( sCentred ) )

        cfgGrowW()
        cfg.gap = u
        openBox()
          swatchGrow( addr( sA ) )
          swatchGrow( addr( sB ) )
          swatchGrow( addr( sC ) )
        closeBox()

        cfgFixedW( 24 * u )
        cfg.gap = u
        openBox()
          paraAt( addr( sLeft ), squeezedMinW )
          paraAt( addr( sRight ), squeezedMinW )
        closeBox()
      closeBox()

    closeBox()

    // ---- status bar
    cfgGrowW()
    cfgFixedH( lineHeight )
    cfgInsetX( u )
    openBox()
      labelAt( addr( sReady ) )
    closeBox()

  closeBox()
}

// ---- scene: sizing --------------------------------------------------------
//
// Two kinds and a clamp. fit hugs its content, grow shares what is left over,
// and fixed is a fit whose minimum and maximum are equal. The third strip is the
// one this port needed: a capped grow that stops at 8 while its neighbour keeps
// taking.

sub buildSizing {
  cfgCol()
  cfgGrowW()
  cfgGrowH()
  cfgInset( u )
  cfg.gap = u
  openBox()

    stripOpen( addr( sCapFit ) )
      swatchFit( addr( sAbc ) )
      swatchFit( addr( sDe ) )
      swatchFit( addr( sFghi ) )
    stripClose()

    stripOpen( addr( sCapGrow ) )
      swatchGrow( addr( sAbc ) )
      swatchGrow( addr( sDe ) )
      swatchGrow( addr( sFghi ) )
    stripClose()

    stripOpen( addr( sCapMixed ) )
      swatchFixed( addr( sAbc ), 6 * u )
      swatchCapped( addr( sDe ), 8 * u )
      swatchGrow( addr( sFghi ) )
    stripClose()

  closeBox()
}

// ---- scene: capped --------------------------------------------------------
//
// Four growing swatches in a fixed track, the second capped. It reaches its
// ceiling partway through the distribution and drops out, and the two units left
// over are handed to the survivors in order.
//
// This is the scene written for the port rather than ported to it. Every other
// scene removes a candidate from the end of the list, so shift-down and
// swap-with-last produce the same answer and candRemove's whole reason for being
// goes unchecked. Removing the second of four is the smallest shape that tells
// them apart: shift-down leaves the survivors in list order, swap-with-last puts
// the last one where the second was, and the remainder then lands on different
// swatches. Expected widths are 7, 5, 7, 6.

sub buildCapped {
  cfgCol()
  cfgGrowW()
  cfgGrowH()
  cfgInset( u )
  openBox()

    cfgFixedW( 28 * u )
    cfg.gap = u
    openBox()
      swatchGrow( addr( sAa ) )
      swatchCapped( addr( sBb ), 5 * u )
      swatchGrow( addr( sCc ) )
      swatchGrow( addr( sDd ) )
    closeBox()

  closeBox()
}

// ---- scene: squeeze -------------------------------------------------------
//
// The same pair of paragraphs in shrinking tracks. They converge downward, and
// once both reach their longest word the rest overflows rather than crushing
// them - which is the only place in these three scenes where an overflow flag is
// raised at all.

sub squeezeTrack( u16 caption, u16 width ) {
  stripOpen( caption )

    cfgFixedW( width )
    cfg.gap = u
    openBox()
      paraAt( addr( sAlpha ), trackMinW )
      paraAt( addr( sGamma ), trackMinW )
    closeBox()

  stripClose()
}

sub buildSqueeze {
  cfgCol()
  cfgGrowW()
  cfgGrowH()
  cfgInset( u )
  cfg.gap = u
  openBox()

    squeezeTrack( addr( sTrack26 ), 26 * u )
    squeezeTrack( addr( sTrack22 ), 22 * u )
    squeezeTrack( addr( sTrack14 ), 14 * u )
    squeezeTrack( addr( sTrack8 ), 8 * u )

  closeBox()
}

// ---- entry ----------------------------------------------------------------

begin( 72 * u, 24 * lineHeight )
buildShell()
closeBox()
runPasses()
dumpBoxes()

begin( 40 * u, 10 * lineHeight )
buildSizing()
closeBox()
runPasses()
dumpBoxes()

begin( 30 * u, 3 * lineHeight )
buildCapped()
closeBox()
runPasses()
dumpBoxes()

begin( 40 * u, 15 * lineHeight )
buildSqueeze()
closeBox()
runPasses()
dumpBoxes()
