// rndpix.momo - mode 13h, 320x200 in 256 colours, filled with random pixels.
//
// A demo rather than a test: it draws, waits for a key, and puts the display
// back. The whole frame is one far array, so plotting is an ordinary array
// store - no interrupt per pixel.

include "lib/std/key.momo"
include "lib/std/mode.momo"
include "lib/std/rand.momo"

// Mode 13h video memory: 320x200, one byte per pixel, at A000:0000.
//
// **A constant segment, deliberately, even though std/mode.momo knows it.**
// §16 loads ES per access, so a `u16` variable costs ten cycles more than an
// immediate every time - which `tigerpic` would pay 92,949 times - and §16 also
// refuses to hoist a runtime segment, so the constant is the only form §34 can
// ever improve. `screenSegment()` is for a program that does not know its mode
// at compile time, which is the properties query and is not built.
far u8[64000] pixels = 0xA000

// ---- entry ----

saveMode()
setMode( modeGfx256 )

for( u16 i = 0; i < len( pixels ); i++ ){
  // Any byte of the generator will do - std/rand.momo is xorshift, so the low
  // bits are as good as the high ones. An earlier version of this took bits 1..8
  // of an LCG, which repeat every 512 calls and banded the image every 1.6
  // scanlines.
  pixels[i] = u8( nextRandom() )
}

readKey()

restoreMode()
