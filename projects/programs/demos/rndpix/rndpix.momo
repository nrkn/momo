// rndpix.momo - mode 13h, 320x200 in 256 colours, filled with random pixels.
//
// A demo rather than a test: it draws, waits for a key, and puts the display
// back. The whole frame is one far array, so plotting is an ordinary array
// store - no interrupt per pixel.

include "lib/std/key.momo"
include "lib/std/rand.momo"

// 320 x 200, one byte per pixel, each an index into the palette.
far u8[64000] pixels = 0xA000

u8  savedMode
u16 i

// ---- entry ----

// AH=0Fh reports the current mode in AL; bit 7 is set when the last mode change
// suppressed the screen clear, so it is masked off before saving.
_ah = 0x0F
int 0x10
savedMode = _al & 0x7F

// AH=00h, AL=13h: 320x200, 256 colours, linear at 0xA000.
_ax = 0x0013
int 0x10

for( i = 0; i < len( pixels ); i++ ){
  // Any byte of the generator will do - std/rand.momo is xorshift, so the low
  // bits are as good as the high ones. An earlier version of this took bits 1..8
  // of an LCG, which repeat every 512 calls and banded the image every 1.6
  // scanlines.
  pixels[i] = u8( nextRandom() )
}

readKey()

// Restore the mode we found, which also clears the screen.
_ah = 0x00
_al = savedMode
int 0x10
