// loadrate.momo - what a file open costs when the disk is taken out of it
// (DESIGN §54, §58).
//
// A 286 read `momoed.asm` off a hard disk in 45 seconds and `edit.com` did it in
// 19. Four timings across two devices had already shown the floppy was not the
// difference, which left the loop - and a loop is measurable without a disk at
// all. That is this: the same shape of text through §54 from memory, timed.
//
// It now times it **both ways**, because §54 grew a bulk path and the whole
// claim of that path is a ratio. A program that prints the ratio is harder to be
// wrong about than a pair of numbers written down on different days.

include "lib/std/io.momo"
include "lib/std/time.momo"
include "lib/motext.momo"

// About thirty characters, which is what the `.asm` that prompted this averages.
// **Line length is not incidental**: a chunk holds sixteen, so the shape of the
// text decides how often a fresh one is taken and how far `lineSeek` walks to
// reach the end of a line.
const u8[] sample = "        mov     ax, [bx + 4]\n"

// Two chunks a line, so this is sixteen thousand of twenty-four thousand - big
// enough to time and clear of the ceiling.
const rounds = 8000

const u8[] sIntro = "loadrate - textLoad with no disk in the way.$"
const u8[] sPer   = " bytes a line$"
const u8[] sPlain = "ordinary: $"
const u8[] sBulk  = "bulk:     $"
const u8[] sLines = " lines, $"
const u8[] sTicks = " ticks, $"
const u8[] sRate  = " lines a second$"
const u8[] sTimes = "bulk is faster by tenths of: $"
const u8[] sQuick = "under one tick - use a slower machine or more rounds$"

u16 start
u16 plainTicks
u16 bulkTicks
u16 plainDone
u16 bulkDone

// Lines a second, with the remainder carried. **`done / spent` first is an
// integer divide that loses most of the answer** at these sizes - eight thousand
// lines in six hundred ticks is thirteen, and thirteen times eighteen is 234
// where the answer is 241. The other order overflows a `u16`, so the quotient
// and the remainder are scaled separately and added.
u16 perSecond( u16 done, u16 spent ) {
  if ( spent == 0 ) return 0

  return done / spent * ticksPerSecond + ( done % spent ) * ticksPerSecond / spent
}

sub report( a16 label, u16 done, u16 spent ) {
  putStr( label )
  putNumber( done )
  putStr( addr( sLines ) )
  putNumber( spent )
  putStr( addr( sTicks ) )
  putNumber( perSecond( done, spent ) )
  putStr( addr( sRate ) )
  newline()
}

// ---- entry ----

putStr( addr( sIntro ) )
newline()

putNumber( len( sample ) )
putStr( addr( sPer ) )
newline()

// ---- the path every caller has always had ----

textInit()

plainDone = 0
start = ticks()

for ( u16 i = 0; i < rounds; i++ ) {
  for ( u16 j = 0; j < len( sample ); j++ ) {
    textLoad( sample[j] )
  }

  plainDone++

  // The buffer is finite and this is sized near it, so stopping when it fills
  // is an ordinary outcome rather than a failure - what is timed is whatever
  // went in.
  if ( textNoRoom() ) break
}

plainTicks = ticksSince( start )

// ---- the same bytes inside the bracket ----

textInit()

bulkDone = 0
start = ticks()

textBulk {
  for ( u16 i = 0; i < rounds; i++ ) {
    for ( u16 j = 0; j < len( sample ); j++ ) {
      textLoad( sample[j] )
    }

    bulkDone++

    if ( textNoRoom() ) break
  }
}

bulkTicks = ticksSince( start )

// ---- what they cost ----

report( addr( sPlain ), plainDone, plainTicks )
report( addr( sBulk ), bulkDone, bulkTicks )

// The ratio, in tenths, and it is the tick counts rather than the rates because
// both runs put the same number of lines in - so the division is exact where a
// ratio of two rounded rates would not be.
if ( bulkTicks == 0 ) {
  putStr( addr( sQuick ) )
  newline()
} else {
  putStr( addr( sTimes ) )
  putNumber( plainTicks * 10 / bulkTicks )
  newline()
}
