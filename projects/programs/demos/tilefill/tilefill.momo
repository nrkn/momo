// tilefill.momo - a tile blitter: two 8x8 tiles, checkerboarded over mode 13h.
//
// The shape a tile engine actually has, which makes it the honest test of a few
// things nothing else exercises: many far writes inside one routine, a near read
// and a far write in the same loop, and `y * 320` address arithmetic.

include "lib/std/key.momo"
include "lib/std/mode.momo"

// 320 x 200, one byte per pixel, each an index into the palette.
//
// **A constant segment, deliberately, even though std/mode.momo knows it.**
// §16 loads ES per access, so a `u16` variable costs ten cycles more than an
// immediate every time - which `tigerpic` would pay 92,949 times - and §16 also
// refuses to hoist a runtime segment, so the constant is the only form §34 can
// ever improve. `screenSegment()` is for a program that does not know its mode
// at compile time, which is the properties query and is not built.
far u8[64000] pixels = 0xA000

const tileW  = 8
const tileH  = 8
const screenW = 320

// Derived rather than stated. len() works on a far region when it was declared
// with a size, and that size is an assertion about hardware rather than
// something the compiler measured.
const screenH     = len( pixels ) / screenW   // 200
const tilesAcross = screenW / tileW           // 40
const tilesDown   = screenH / tileH           // 25
const tileBytes   = tileW * tileH             // 64

// Both tiles in one array. Routines take scalars, so a tile cannot be passed -
// an offset into the set can, which is how a real tile engine does it anyway.
const u8[] tiles = [
  // 0: brick - red with white mortar
  15,15,15,15,15,15,15,15,
   4, 4, 4,15, 4, 4, 4,15,
   4, 4, 4,15, 4, 4, 4,15,
  15,15,15,15,15,15,15,15,
   4,15, 4, 4, 4,15, 4, 4,
   4,15, 4, 4, 4,15, 4, 4,
  15,15,15,15,15,15,15,15,
   4, 4, 4,15, 4, 4, 4,15,

  // 64: a blue diamond on black
   0, 0, 0, 9, 9, 0, 0, 0,
   0, 0, 9, 1, 1, 9, 0, 0,
   0, 9, 1, 1, 1, 1, 9, 0,
   9, 1, 1, 1, 1, 1, 1, 9,
   9, 1, 1, 1, 1, 1, 1, 9,
   0, 9, 1, 1, 1, 1, 9, 0,
   0, 0, 9, 1, 1, 9, 0, 0,
   0, 0, 0, 9, 9, 0, 0, 0,
]


// Copies one tile to grid position (tx, ty). `from` is a byte offset into
// `tiles`. Sixty-four far writes per call, which is the shape §16's ES hoisting
// would reward - one segment load for the routine instead of one per pixel.
sub blit( u16 from, u8 tx, u8 ty ) {
  u16 dest
  u16 src

  for( u16 row = 0; row < tileH; row++ ){
    dest = ( u16( ty ) * tileH + row ) * screenW + u16( tx ) * tileW
    src  = from + row * tileW

    for( u16 col = 0; col < tileW; col++ ){
      pixels[ dest + col ] = tiles[ src + col ]
    }
  }
}

// ---- entry ----

videoMode {
  setMode( modeGfx256 )

  for( u8 ty = 0; ty < tilesDown; ty++ ){
    for( u8 tx = 0; tx < tilesAcross; tx++ ){
      if( ( ( tx + ty ) & 1 ) == 0 ){
        blit( 0, tx, ty )
      } else {
        blit( tileBytes, tx, ty )
      }
    }
  }

  readKey()
}
