// tigerpic.momo - the Ghostscript tiger, drawn.
//
//   npm start tigerpic
//
// The point of the whole port, and the first thing here worth looking at rather
// than reading. 138 paths, 3,693 quadratic segments and 388 lines, filled by the
// nonzero rule and stroked with hairlines, into a mode 13h frame.
//
// A demo rather than a test: it draws, waits for a key and puts the display back,
// so it cannot have a `.expected` - tier 2 has no way to press one. The geometry is
// not taken on trust for that reason. `tiger` digests the same data
// through the same rasteriser and holds 339 numbers against the study - every
// scanline's pixel count and x-sum, every path's colour and pixel count, and a hash
// over every pixel in draw order. So this picture is made of numbers that have been
// checked, and only the drawing is new here.
//
// The data is shared rather than copied: `scenes/tiger.momo` is the one generated
// dataset, and `tiger` and `tzoom` include it by exactly this
// name. Three programs, one file, and no copy to drift.
//
// **The rasteriser cannot tell this program from the digest.** `shared/lib/momovec` asks a
// program for exactly two routines - `plot` and `emitSpan` - so one routine decides
// whether a pixel becomes a byte in video memory or a number, and nothing below it
// learns which. DESIGN §19's routine parameters would be one way to arrange that; late
// binding by name is the way that needed no language feature at all.
//
// Stated precisely because an earlier version of this comment said the two programs
// differ only in `plot`, and a diff says otherwise: this one sets a video mode, loads a
// palette and waits for a key, and the digest carries accumulators and printing. The
// INTERFACE is what is narrow, not the harnesses.

// The crossing budget, sized by the study against this dataset. Must precede the
// momovec includes: an array dimension is needed where the array is declared, so
// unlike `plot` and `emitSpan` this cannot bind late.
//
// 1,024 against a measured worst single path of 692, on the tiger.
const maxCrossings = 1024

include "lib/std/io.momo"
include "lib/std/key.momo"
include "lib/std/mode.momo"
include "lib/std/math.momo"
include "lib/momovec/direct.momo"
include "lib/momovec/types.momo"
include "lib/momovec/edges.momo"
include "lib/momovec/subdiv.momo"
include "lib/momovec/path.momo"
include "lib/momovec/fill.momo"

include "scenes/tiger.momo"

// Mode 13h video memory: 320x200, one byte per pixel, at A000:0000.
//
// **A constant segment, deliberately, even though std/mode.momo knows it.**
// §16 loads ES per access, so a `u16` variable costs ten cycles more than an
// immediate every time - which `tigerpic` would pay 92,949 times - and §16 also
// refuses to hoist a runtime segment, so the constant is the only form §34 can
// ever improve. `screenSegment()` is for a program that does not know its mode
// at compile time, which is the properties query and is not built.
far u8[64000] pixels = 0xA000

// The DAC, one entry at a time. The scene's values are already six bits - the
// generator divided by four - so they go straight to setDac, which takes the six
// the hardware wants. `dac8` is the other convention, and nothing here needs it.
sub loadPalette {
  for ( u16 i = 0; i < paletteSize; i++ ) {
    setDac( u8( i ), palR[i], palG[i], palB[i] )
  }
}

// The colour the current path is painting in. A global because `plot` is called by
// the library, which has no opinion about colour.
u8 ink

sub plot( i16 x, i16 y ) {
  if ( x < 0 ) return
  if ( y < 0 ) return
  if ( x > xMax ) return
  if ( y > yMax ) return

  pixels[ u16( y ) * screenW + u16( x ) ] = ink
}

// Spans arrive already clipped, so this needs no bounds test of its own - which is
// the whole value of clipping at the span rather than the pixel.
sub emitSpan( u16 y, i16 x0, i16 x1 ) {
  for ( i16 x = x0; x <= x1; x++ ) {
    pixels[ y * screenW + u16( x ) ] = ink
  }
}

u16 held

videoMode {
  setMode( modeGfx256 )
  loadPalette()

  // Paths in order, each filled then stroked. Array order IS declaration order for an
  // immediate-mode builder, so this is paint order - no command list, nothing to sort.
  for ( u16 p = 0; p < maxPaths; p++ ) {
    if ( pathHasFill[p] != 0 ) {
      ink = pathFill[p]
      fillPath( p, true )
    }

    if ( pathHasStroke[p] != 0 ) {
      ink = pathStroke[p]
      strokePath( p )
    }
  }

  // std/key has readKey, which blocks and returns what was pressed. Nothing here
  // wants the value, and discarding it is what a `sub` cannot do - so it goes into a
  // variable that exists to be ignored.
  held = readKey()
}
