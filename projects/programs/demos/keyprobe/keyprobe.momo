// keyprobe.momo - what the keyboard actually reports, on this machine.
//
// It asks for one combination at a time, records what came back, and writes the
// lot to KEYS.TXT beside the program. Run it, work down the list, then read the
// file.
//
// It exists because no headless tier can answer the question it asks. Whether
// Shift+Left is distinguishable from Left is a fact about a BIOS and a keyboard,
// and the only way to find out is to press the keys.
//
// **Reads with int 16h AH=10h, not AH=00h.** `std/key.momo` uses the older call,
// which filters out keys an enhanced keyboard reports and would hide exactly
// what this is looking for. If the two disagree, this file is the one to
// believe and `key.momo` is the one to change.
//
// The shift flags are read immediately after the key rather than before it, so
// they are the state a moment after the press. Holding the modifier until the
// prompt moves on is enough; releasing it instantly would report zero.
//
// **AH=10h reports an extended key as AL=0E0h, not AL=0.** The first run of this
// found it, and it is the reason the last two prompts exist: 0E0h is how the
// grey navigation keys are told apart from the numeric keypad, which reports the
// same scancodes with AL=0. Anything deciding "is this a character" on AL alone
// reads every grey key as the same one. Turn NumLock off for those two, or they
// report digits and say nothing.

include "lib/std/io.momo"
include "lib/std/str.momo"
include "lib/std/file.momo"

const strTerm  = '$'
const keyEsc16 = 0x011B

// One prompt per line, in the order they are asked. The count is derived below
// rather than written down, so adding one here cannot desynchronise anything.
//
// **This is the default rather than the list.** A file replaces it, one prompt a
// line - so probing three keys does not mean pressing thirty-six, and adding a
// question does not mean a rebuild. That last part is the point: a rebuild is a
// round trip through another machine, and a text file is something the editor on
// this one can write.
//
// **Named on the command line**, falling back to `KEYPROBE.CFG`:
//
//   keyprobe            the list below, or KEYPROBE.CFG if there is one
//   keyprobe tabs.cfg   whatever that file asks for
//
// The argument is why a set can ship with the program. A `KEYPROBE.CFG` on the
// disk would quietly become the default for every run, so the files that come
// with this are named for what they ask and are asked for by name.
const u8[] prompts = "Left$"
                     "Shift+Left$"
                     "Ctrl+Left$"
                     "Ctrl+Shift+Left$"
                     "Right$"
                     "Ctrl+Right$"
                     "Ctrl+Shift+Right$"
                     "Up$"
                     "Shift+Up$"
                     "Home$"
                     "Shift+Home$"
                     "Ctrl+Home$"
                     "End$"
                     "Shift+End$"
                     "Tab$"
                     "Shift+Tab$"
                     "Backspace$"
                     "Ctrl+Backspace$"
                     "Delete$"
                     "Shift+Delete$"
                     "Ctrl+S$"
                     "Ctrl+Z$"
                     "Ctrl+Y$"
                     "Ctrl+K$"
                     "Ctrl+/$"
                     "Ctrl+Enter$"
                     "F1$"
                     "Alt+F$"
                     "Enter$"
                     "PgUp$"
                     "PgDn$"
                     "Insert$"
                     "Ctrl+PgUp$"
                     "Ctrl+PgDn$"
                     "Keypad Left, NumLock OFF$"
                     "Keypad Home, NumLock OFF$"

const u8[] hexDigit = "0123456789ABCDEF"
const u8[] outName  = "KEYS.TXT\0"

const u8[] sIntro1 = "keyprobe - press each combination as it is asked for.$"
const u8[] sIntro2 = "If one is impossible or does nothing, press Esc to move on.$"
const u8[] sIntro3 = "Results go to KEYS.TXT.$"
const u8[] sHeader = "key                 AX   flags$"
const u8[] sStart  = "start                    $"
const u8[] sArrow  = "  -> $"
const u8[] sSpace  = " $"
const u8[] sPress  = "  press: $"
const u8[] sWrote  = "written to KEYS.TXT: $"
const u8[] sFailed = "could not create KEYS.TXT, DOS error $"
const u8[] sFromCfg = "list     $"
const u8[] sBuiltIn = "list     built-in$"
const u8[] sCut     = "  TRUNCATED - file is larger than the buffer$"

// ---- the report ----
//
// Built in the heap and written once. `io.momo` formats numbers straight to the
// console and there is no way to ask it for the text, so the two-digit-pair hex
// below is written here - which is the same gap `momoed` will meet the first
// time it wants a line number in a gutter.

const reportMax = 2048

view u8[reportMax] report = _heap[0]
u16 reportAt

// ---- the list, which may come from a file --------------------------------
//
// Read raw and then **compacted in place into exactly the shape the built-in
// list has**: one `$` a prompt. The walk below never learns which it got, which
// is what keeps the config from being a second code path.
//
// In place is safe because every byte either survives or is dropped - the
// output index is never ahead of the input one.
// Four kilobytes, where 1,024 lost the last question of the first real config -
// 1,312 bytes of file, read to byte 1,024, cut off mid-comment. Seven rows came
// back where eight were asked for, and nothing said so.
const cfgMax = 4096
const u8[] cfgName = "KEYPROBE.CFG\0"

// The command tail, which DOS leaves at PSP:0080h - a length, the text, a
// carriage return. Same bytes `momoed` reads for its filename and the same
// handling: skip the spaces, take one word.
u8[16] cfgArg

bool takeArg() {
  u16 n
  u16 at
  u16 out

  n = peek8( 0x80 )
  at = 0x81
  out = 0

  while ( n > 0 && peek8( at ) == ' ' ) {
    at++
    n--
  }

  while ( n > 0 && peek8( at ) != ' ' && peek8( at ) != 13 &&
          out < len( cfgArg ) - 1 ) {
    cfgArg[out] = peek8( at )
    out++
    at++
    n--
  }

  cfgArg[out] = 0
  return out > 0
}

view u8[cfgMax] cfg = _heap[reportMax]
u16 cfgLen
u8[20] cfgShown
bool cfgCut

sub loadConfig {
  u16 handle
  u16 got
  u16 n
  u16 size
  u16 opened

  cfgLen = 0

  opened = takeArg() ? addr( cfgArg ) : addr( cfgName )

  handle = fileOpen( opened, fileReadOnly )
  if ( fileFailed() ) return

  // **Asked before it is read**, because a read that fills the buffer cannot
  // tell a file that fitted exactly from one that did not. A probe list quietly
  // missing its last question is the failure this already had once, and a run
  // that says nothing is a record that lies by omission.
  size = fileSize( handle )
  cfgCut = size > cfgMax

  got = fileRead( handle, addr( cfg ), cfgMax )
  fileClose( handle )

  // §57 wants to ask a question and `str.momo` knows how to turn a file into a
  // list of them. It is there rather than here because this program cannot be
  // tested - it blocks on a keyboard - and the parse is exactly the kind of
  // thing that has an off-by-one in it.
  cfgLen = strLines( addr( cfg ), got )

  // The name that was opened, `$`-terminated for printing - the one on the
  // command line is ASCIZ because DOS wanted it that way.
  n = 0
  while ( peek8( opened + n ) != 0 && n < len( cfgShown ) - 1 ) {
    cfgShown[n] = peek8( opened + n )
    n++
  }

  cfgShown[n] = '$'
}

bool usingConfig() => cfgLen > 0

u16 promptsAt()  => usingConfig() ? addr( cfg ) : addr( prompts )
u16 promptsLen() => usingConfig() ? cfgLen : len( prompts )

sub addChar( u8 c ) {
  if ( reportAt >= reportMax ) return

  report[reportAt] = c
  reportAt++
}

sub addStr( u16 at ) {
  u16 i
  i = 0

  while ( peek8( at + i ) != strTerm ) {
    addChar( peek8( at + i ) )
    i++
  }
}

// The label, then spaces out to `width`, so the file lines up in a column.
//
// **At least one space, always.** A label longer than the column used to run
// straight into the hex - `...if there is none3920 032E` - which is a row that
// reads as one word and a number. The column is for the common case and the
// space is for the row that does not fit it.
sub addPadded( u16 at, u16 width ) {
  u16 i
  i = 0

  while ( peek8( at + i ) != strTerm ) {
    addChar( peek8( at + i ) )
    i++
  }

  addChar( ' ' )
  i++

  while ( i < width ) {
    addChar( ' ' )
    i++
  }
}

sub addHex( u16 w ) {
  addChar( hexDigit[ ( w >> 12 ) & 15 ] )
  addChar( hexDigit[ ( w >> 8 ) & 15 ] )
  addChar( hexDigit[ ( w >> 4 ) & 15 ] )
  addChar( hexDigit[ w & 15 ] )
}

sub addLineEnd {
  addChar( 13 )
  addChar( 10 )
}

sub putHex( u16 w ) {
  putChar( hexDigit[ ( w >> 12 ) & 15 ] )
  putChar( hexDigit[ ( w >> 8 ) & 15 ] )
  putChar( hexDigit[ ( w >> 4 ) & 15 ] )
  putChar( hexDigit[ w & 15 ] )
}

// ---- the keyboard ----

// int 16h AH=10h. The enhanced read: same AX as AH=00h for ordinary keys, and
// reports the ones AH=00h discards.
u16 readKeyEx() {
  _ah = 0x10
  int 0x16
  return _ax
}

// int 16h AH=12h. AL is the shift state - bit 0 right shift, 1 left shift,
// 2 ctrl, 3 alt - and AH carries the extended flags.
u16 shiftFlags() {
  _ah = 0x12
  int 0x16
  return _ax
}

// ---- counting the prompts ----

u16 countStrings( u16 at, u16 bytes ) {
  u16 n
  n = 0

  for ( u16 i = 0; i < bytes; i++ ) {
    if ( peek8( at + i ) == strTerm ) n++
  }
  return n
}

// ---- entry ----

u16 total
u16 label
u16 code
u16 flags
u16 handle
u16 written

putStr( addr( sIntro1 ) )
newline()
putStr( addr( sIntro2 ) )
newline()
putStr( addr( sIntro3 ) )
newline()

loadConfig()

// **Which list this run asked**, on screen and in the file. A subset run and a
// full run produce the same shape of file, so a KEYS.TXT that did not say would
// read as a complete record with rows quietly missing - which is the failure a
// record exists to prevent.
if ( usingConfig() ) {
  putStr( addr( sFromCfg ) )
  putStr( addr( cfgShown ) )
  if ( cfgCut ) putStr( addr( sCut ) )
} else {
  putStr( addr( sBuiltIn ) )
}

newline()
newline()

// **The toggles as the run starts**, before anybody has pressed anything.
// NumLock, CapsLock and Insert are state rather than modifiers, and a row
// further down carries whatever they were by then - so without this the
// file says what the state *became* and never what it began as.
//
// It is what turned a guess into an answer once already: the second run had
// NumLock set for the keypad rows and clear for every row above them, which
// places the keypress and says which way it went. That was reconstructable
// from thirty-six rows and is a line here.
addStr( addr( sStart ) )
addHex( 0 )
addStr( addr( sSpace ) )
addHex( shiftFlags() )
addLineEnd()

if ( usingConfig() ) {
  addStr( addr( sFromCfg ) )
  addStr( addr( cfgShown ) )
  if ( cfgCut ) addStr( addr( sCut ) )
} else {
  addStr( addr( sBuiltIn ) )
}

addLineEnd()

addStr( addr( sHeader ) )
addLineEnd()

total = countStrings( promptsAt(), promptsLen() )

for ( u16 i = 0; i < total; i++ ) {
  label = nthStr( promptsAt(), i )

  putNumber( i + 1 )
  putChar( '/' )
  putNumber( total )
  putStr( addr( sPress ) )
  putStr( label )
  newline()

  code  = readKeyEx()
  flags = shiftFlags()

  putStr( addr( sArrow ) )
  putHex( code )
  putChar( ' ' )
  putHex( flags )
  newline()

  addPadded( label, 26 )
  addHex( code )
  addChar( ' ' )
  addHex( flags )

  // A press that came back as Esc is one the machine would not give us, and
  // saying so in the file is better than leaving a row that looks measured.
  if ( code == keyEsc16 ) addStr( addr( sArrow ) )

  addLineEnd()
}

newline()

handle = fileCreate( addr( outName ) )

if ( fileFailed() ) {
  putStr( addr( sFailed ) )
  putNumber( fileError() )
  newline()
} else {
  written = fileWrite( handle, addr( report ), reportAt )
  fileClose( handle )

  putStr( addr( sWrote ) )
  putNumber( written )
  newline()
}
