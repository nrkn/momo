// simplerl.momo - the minimal version: an '@' moving around a hard-coded map.
//
// Deliberately left at this size. Anything further - mobs, items, generated
// levels - belongs in its own project rather than here, so this stays readable
// as the smallest thing that is recognisably a roguelike.
// ---
// Minimal roguelike skeleton - an '@' moving around a hard coded map

include "lib/std/io.momo"
include "lib/std/screen.momo"
include "lib/std/key.momo"
include "lib/std/rand.momo"
include "lib/std/math.momo"
include "lib/std/mode.momo"

// const

const map = "########    ########"
            "##....########....##"
            "##................##"
            "####............####"
            "  ##............##  "
            "  ##............##  "
            "####............####"
            "##................##"
            "##....########....##"
            "########    ########"

const mapW = 20
const mapH = len( map ) / mapW

const tileAt( u8 x, u8 y ) = map[ y * mapW + x ]

const defAttr = color( lightGray, black )
const playerAttr = color( yellow, black )

const solidBlock = 219

// state

u8 playerX = 9
u8 playerY = 4

// draw and move

// The main loop's own state - read by isMove and by the loop itself. Declared
// out here rather than in the block below because scoping is flat: a bracket
// body is a body, not a scope, and putting a declaration inside one would say
// otherwise.
u8 oldPx
u8 oldPy
u16 lastKey

bool isMove( u8 key ) => lo( lastKey ) == 0 && hi( lastKey ) == key

sub draw {
  u8 ch

  for( u8 y = 0; y < mapH; y++ ){
    for( u8 x = 0; x < mapW; x++ ){
      ch = tileAt( x, y )

      if( ch == '#') ch = solidBlock

      writeAt( x, y, ch, defAttr )
    }
  }
}

sub cls => clearScreen( defAttr )

// run

// The mode is saved and put back by std/mode.momo (§43). Its bracket (§48)
// makes the compiler emit the restore, so this leaves the display in whatever
// mode it was started from rather than in the one it chose. §11 prunes the mode
// table, since save and restore are all this calls.
videoMode {
  setTextMode()
  hideCursor()

  draw()
  writeAt( playerX, playerY, '@', playerAttr )

  while( true ){
    lastKey = readKey()

    if( lo( lastKey ) == keyEsc ) break

    oldPx = playerX
    oldPy = playerY

    if( isMove( keyUp ) && playerY > 0 ){
      playerY--
    } else if( isMove( keyDown ) && playerY < mapH - 1 ){
      playerY++
    } else if( isMove( keyLeft ) && playerX > 0 ){
      playerX--
    } else if( isMove( keyRight ) && playerX < mapW - 1 ){
      playerX++
    }

    if( tileAt( playerX, playerY ) == '#'){
      playerX = oldPx
      playerY = oldPy
    } else {
      writeAt( oldPx, oldPy, tileAt( oldPx, oldPy ), defAttr )
      writeAt( playerX, playerY, '@', playerAttr )
    }
  }

  moveTo( 0, 0 )
  showCursor()
  cls()
}
