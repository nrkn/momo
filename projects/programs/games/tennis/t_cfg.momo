// player 0 is on the left, player 1 on the right. Here rather than in
// tennis.momo because t_kbd.momo indexes by player too, and a module that
// includes this one should not have to depend on its parent's declaration order.
const playerCount = 2

const leftPlayer = 0
const rightPlayer = 1

// pixel units
const screenW = 320
const screenH = 200
const viewW = screenW / 2
const viewH = screenH / 2

const playLeft = 40
const playRight = 118
const playTop = 9
const playBottom = 80
const playW = playRight - playLeft + 1
const playH = playBottom - playTop + 1
const centerX = ( playLeft + playRight ) / 2
const scoreTop = 84
const scoreY = scoreTop + 1
// per player
const u8[] scoreXTens = [ 44, 101 ]
const u8[] scoreXOnes = [ 51, 108 ]

const paddleW = 1
const paddleH = 9

const ballW = 3
const ballH = 3

const digitW = 5
const digitH = 5

// subgrid units - positions and speeds in quarter pixels, so movement can be
// slower than a pixel a frame. A unit (DESIGN §39), so a subgrid value cannot
// reach anything that takes pixels except through `subgridToPx`.
unit grid = i16

const subgridScale = 4

// Subgrid too, and plain only because `player[].speed` is a u8 and a unit has
// one storage type - making it a `grid` would change the code, not just check it.
const paddleSpeedStep = 2
const paddleSpeedMax = 16

const grid serveSpeed = 3

const grid paddleYMax = ( playH - paddleH  - 2 ) * subgridScale
const grid ballXMax = ( playW - ballW - 2 ) * subgridScale
const grid ballYMax = ( playH - ballH - 2 ) * subgridScale
const grid paddleYHome = paddleYMax / 2

// centres the ball on the serving paddle: both are subgrid, so the gap either
// side is half the difference
const grid ballServeOffset = ( paddleH - ballH ) * subgridScale / 2

// the ball meets the paddle from its bottom edge just reaching the paddle top,
// to its top edge just leaving the paddle bottom
const grid hitLead = ballH * subgridScale - 1
const grid hitWindow = hitLead + paddleH * subgridScale

// word blitting

// halved for word, but scoreTop doubled for view doubling - cancels out
const scoreTopWord = scoreTop * screenW

const screenWord = ( screenW * screenH ) / 2

// six equal zones and a wider flat one in the middle, so the table is
// symmetric
const grid angleZone = 6
const grid angleZone1 = angleZone
const grid angleZone2 = angleZone * 2
const grid angleZone3 = angleZone * 3
const grid angleZone4 = hitWindow - angleZone * 3
const grid angleZone5 = hitWindow - angleZone * 2
const grid angleZone6 = hitWindow - angleZone

const grid ballSpeedStep = serveSpeed
const grid ballSpeedY1 = ballSpeedStep
const grid ballSpeedY2 = ballSpeedStep * 2
const grid ballSpeedY3 = ballSpeedStep * 3
const grid ballSpeedXMax = ballSpeedStep * 3
const volleyTarget = 3
const winScore = 11
