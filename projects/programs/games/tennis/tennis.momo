// tennis.momo - *loosely* based on the Fairchild Channel F pong clone "Tennis"

include "lib/std/key.momo"
include "lib/std/math.momo"
include "lib/std/rand.momo"
include "lib/std/time.momo"
include "t_cfg.momo"
include "t_kbd.momo"
include "t_pal.momo"
include "t_scr.momo"
include "t_spr.momo"

// -- state

// game state - otherwise, in play
bool isWinScreen
// back to DOS when false
bool isRunning = true

// paddles - playerCount, leftPlayer and rightPlayer are in t_cfg.momo
group player[playerCount] {
  grid y      
  grid oldY   
  u8 score
  u8 speed 
}

// per-player consts
const u8[] paddleX = [ playLeft, playRight ]
const u8[] paddleColor = [ red, blue ]
const u16[] winColor = [ redW, blueW ]
const grid[] serveX = [ 0, ballXMax ]
const grid[] serveSpeedX = [ serveSpeed, -serveSpeed ]

// The ball. One instance, so this is namespacing rather than
// structure-of-arrays - DESIGN 18 - and it is here for the reading: `oldX`
// beside `x` says what it is, where the old name needed a comment to.
group ball {
  grid x
  grid y
  grid oldX
  grid oldY
  grid speedX
  grid speedY
  u8  player
  u8  color
}

// Volleys in the current rally, not a property of the ball.
u8 volleyCount

// -- main

sub drawBackground( u16 color ) {
  // a word at a time, as everything that draws does - see `pxwords`
  for( u16 dy = 0; dy < scoreTopWord; dy++ ){
    pxwords[ dy ] = color
  }

  for( u16 dy = scoreTopWord; dy < screenWord; dy++ ){
    pxwords[ dy ] = blackW
  }
}

// draw once at start
sub drawPlayfield {
  drawLineHorizontal( playTop, playLeft, playRight, green )
  drawLineHorizontal( playBottom, playLeft, playRight, green )
  drawNet()
}

// The net: dashes down the centre column, each `netDash` rows long, one every
// `netGap` rows. Named, because `netAt` has to agree with `drawNet` exactly.
const netTop = playTop + 3
const netDash = 9
const netGap = 14
const netDashes = 5
const netBottom = netTop + ( netDashes - 1 ) * netGap + netDash

sub drawNet {
  for ( u16 k = 0; k < netDashes; k++ ) {
    fillColumn( centerX, netTop + k * netGap, netDash, greenW )
  }
}

// Whether row `y` of the centre column is on one of the net's dashes.
bool netAt( u16 y ) => y >= netTop && y < netBottom && ( y - netTop ) % netGap < netDash

// `n` rows of column `x` put back to what is under them. Only the ball ever
// crosses anything, and the only thing it crosses is the net - so clearing to
// the background is what keeps the net whole, where the old render redrew all
// five dashes whenever the ball came near.
sub clearColumn( u16 x, u16 y, u16 n ) {
  if ( x != centerX ) {
    fillColumn( x, y, n, lightGreenW )
    return
  }

  for ( u16 k = 0; k < n; k++ ) {
    fillColumn( x, y + k, 1, netAt( y + k ) ? greenW : lightGreenW )
  }
}

// subgrid to pixels
// playfield offset, eg playRight, playLeft, playTop etc
// object offset, eg ball.x, ball.y, player[ i ].y etc
// `>> 2` and not `/ 4`: obj is stored as i16, and a signed divide rounds toward
// zero where the shift floors, so these are different answers for a negative
// offset. Signed division deliberately does not strength-reduce - see strred.
// The `i16( ... )` is the one place a subgrid value becomes a pixel.
const subgridToPx( i16 play, grid obj ) = play + 1 + i16( obj >> 2 )

// Pixel positions, which are never negative - the subgrid is clamped at 0 and
// the playfield offset is added on top.
const paddleRow( grid y ) = u16( subgridToPx( playTop, y ) )
const ballColumn( grid x ) = u16( subgridToPx( playLeft, x ) )
const ballRow( grid y ) = u16( subgridToPx( playTop, y ) )

const u16[] paddleColorW = [ redW, blueW ]

// The colour the ball was last drawn in, because a return changes its colour
// without always moving it a whole pixel.
u8 ballDrawnColor

// Whole objects, for `start` - after it, only what moves is drawn.
sub drawPaddle( u8 pi ) => fillColumn( paddleX[ pi ], paddleRow( player[ pi ].y ), paddleH, paddleColorW[ pi ] )

sub drawBall {
  u16 x
  u16 y
  u16 c

  x = ballColumn( ball.x )
  y = ballRow( ball.y )
  c = pxDouble( ball.color )

  for ( u16 k = 0; k < ballW; k++ ) {
    fillColumn( x + k, y, ballH, c )
  }

  ballDrawnColor = ball.color
}

// **Only the rows a paddle entered are drawn and only the rows it left are
// cleared**, so it is never missing from the screen, even for the length of one
// store. That is what made the flicker: the old render cleared the whole paddle
// and drew it again, and on a machine that could not finish inside the vertical
// blank the beam caught it cleared. DESIGN §68 found the same in `momoed`.
//
// A move of `d` rows changes `d` rows at each end, or all of them once `d`
// reaches the paddle's height and the two positions stop overlapping.
sub shiftPaddle( u8 pi ) {
  u16 x
  u16 was
  u16 now
  u16 n

  was = paddleRow( player[ pi ].oldY )
  now = paddleRow( player[ pi ].y )
  if ( now == was ) return

  x = paddleX[ pi ]

  if ( now > was ) {
    n = now - was
    if ( n > paddleH ) n = paddleH
    fillColumn( x, now + paddleH - n, n, paddleColorW[ pi ] )
    fillColumn( x, was, n, lightGreenW )
  } else {
    n = was - now
    if ( n > paddleH ) n = paddleH
    fillColumn( x, now, n, paddleColorW[ pi ] )
    fillColumn( x, was + paddleH - n, n, lightGreenW )
  }
}

// The ball the same way, in two dimensions: the whole new square is drawn - nine
// pixels, and it may have changed colour - and then only the old pixels the new
// square does not cover are cleared. Drawn first, so there is no moment with no
// ball on the screen.
sub shiftBall {
  u16 wasX
  u16 wasY
  u16 nowX
  u16 nowY
  u16 x
  u16 n

  wasX = ballColumn( ball.oldX )
  wasY = ballRow( ball.oldY )
  nowX = ballColumn( ball.x )
  nowY = ballRow( ball.y )

  if ( nowX == wasX && nowY == wasY && ball.color == ballDrawnColor ) return

  drawBall()

  for ( u16 k = 0; k < ballW; k++ ) {
    x = wasX + k

    if ( x < nowX || x >= nowX + ballW ) {
      clearColumn( x, wasY, ballH )
    } else if ( wasY < nowY ) {
      n = nowY - wasY
      if ( n > ballH ) n = ballH
      clearColumn( x, wasY, n )
    } else if ( wasY > nowY ) {
      n = wasY - nowY
      if ( n > ballH ) n = ballH
      clearColumn( x, wasY + ballH - n, n )
    }
  }
}

sub drawSprite( u8 index, u8 dx, u8 dy ){
  u16 tile

  tile = index * spriteSize

  for( u8 j = 0; j < spriteH; j++ ){
    for( u8 i = 0; i < spriteW; i++ ){
      setPixel( i + dx, j + dy, textSprites[ tile ] )

      tile++
    }    
  }
}

// overdraws existing, no clear needed
sub drawScore( u8 pi ) {
  u8 digitTens
  u8 digitOnes

  if( player[ pi ].score < 10 ){
    digitTens = 0
    digitOnes = player[ pi ].score
  } else {
    digitTens = 1
    digitOnes = player[ pi ].score - 10
  }

  drawSprite( digitTens, scoreXTens[ pi ], scoreY )
  drawSprite( digitOnes, scoreXOnes[ pi ], scoreY )
}

// The held flags are indexed by player too, so this takes the index alone.
sub movePaddle( u8 pi ) {
  if ( held[ pi ].up || held[ pi ].down ) {
    if ( held[ pi ].up ) player[ pi ].y -= grid( player[ pi ].speed )
    if ( held[ pi ].down ) player[ pi ].y += grid( player[ pi ].speed )

    if ( player[ pi ].y < 0 ) player[ pi ].y = 0
    if ( player[ pi ].y > paddleYMax ) player[ pi ].y = paddleYMax

    if ( player[ pi ].speed < paddleSpeedMax ) {
      player[ pi ].speed += paddleSpeedStep
    }
  } else {
    player[ pi ].speed = 0
  }
}

// player movements, ESC to exit
sub input {
  pollKeyboard()

  if( wasEsc ){
    isRunning = false

    return
  } 

  if( isWinScreen ){
    if( anyLeftRight() ){
      start()
    }

    return
  }

  movePaddle( leftPlayer )
  movePaddle( rightPlayer )
}

sub setBallSpeedY( grid yOffset ) {
  if ( yOffset < angleZone1 ) ball.speedY = -ballSpeedY3
  else if ( yOffset < angleZone2 ) ball.speedY = -ballSpeedY2
  else if ( yOffset < angleZone3 ) ball.speedY = -ballSpeedY1
  else if ( yOffset < angleZone4 ) ball.speedY = 0
  else if ( yOffset < angleZone5 ) ball.speedY = ballSpeedY1
  else if ( yOffset < angleZone6 ) ball.speedY = ballSpeedY2
  else ball.speedY = ballSpeedY3
}

// pi scored, so pi serves - unless that was the winning point
sub scorePoint( u8 pi ) {
  player[ pi ].score++

  drawScore( pi )
  
  if ( player[ pi ].score == winScore ) {
    win( pi )
  } else {
    ball.player = pi

    serve()
  }
}

// ball at player pi's column - either bounce or miss (other player scores)
sub hitPaddle( u8 pi ) {
  grid yOffset

  yOffset = ball.y - player[ pi ].y + hitLead
  
  if ( yOffset < 0 || yOffset >= hitWindow ) {
    scorePoint( 1 - pi )

    return
  }

  ball.x = serveX[ pi ]
  setBallSpeedY( yOffset )

  // three returns before the rally speeds up, to a ceiling
  if ( grid( iabs( i16( ball.speedX ) ) ) < ballSpeedXMax ) {
    volleyCount++
  
    if ( volleyCount == volleyTarget ) {
      volleyCount = 0

      if ( ball.speedX > 0 ) ball.speedX += ballSpeedStep
      else ball.speedX -= ballSpeedStep
    }
  }
  
  ball.speedX = -ball.speedX
  ball.player = pi
  ball.color = paddleColor[ pi ]
}

// recalculate state
sub update {
  if( isWinScreen ) return
  
  ball.x += ball.speedX
  ball.y += ball.speedY

  if( ball.y < 0 ){
    ball.y = 0
    ball.speedY = -ball.speedY
  } else if( ball.y > ballYMax ){
    ball.y = ballYMax
    ball.speedY = -ball.speedY
  }
  
  // only the side the ball is travelling toward can be reached
  if( ball.speedX > 0 && ball.x >= ballXMax ){
    hitPaddle( rightPlayer )
  } else if ( ball.speedX < 0 && ball.x <= 0 ){
    hitPaddle( leftPlayer )
  }
}

sub render {
  if( isWinScreen ) return

  // Only what moved, and nothing erased that is about to be drawn - see
  // `shiftPaddle`. A frame's cost now follows the movement rather than being
  // the same every time, which the frame wait already makes harmless.
  shiftBall()
  shiftPaddle( leftPlayer )
  shiftPaddle( rightPlayer )

  player[ leftPlayer ].oldY = player[ leftPlayer ].y
  player[ rightPlayer ].oldY = player[ rightPlayer ].y

  ball.oldX = ball.x
  ball.oldY = ball.y
}

// with a high typematic rate, the keyboard buffer can get very full, especially
// with numlock fake codes and etc - using the retrace period means a good
// chance to drain it properly
sub waitRetrace {
  while ( inRetrace() ) pollKeyboard()
  while ( !inRetrace() ) pollKeyboard()
}

// mode 13 is 70Hz, so two retraces for 35Hz
sub waitFrame {
  waitRetrace()
  waitRetrace()
}

sub tick {
  input()
  update()
  waitFrame()
  render()
}

// show win screen, wait for input, then call start again
sub win( u8 pi ) {
  isWinScreen = true
  
  waitFrame()
  drawBackground( winColor[ pi ] )
  drawScore( leftPlayer )
  drawScore( rightPlayer )
}

sub serve(){
  ball.speedY = 0
  volleyCount = 0

  ball.x = serveX[ ball.player ]
  ball.y = player[ ball.player ].y + ballServeOffset
  ball.speedX = serveSpeedX[ ball.player ]
  ball.color = paddleColor[ ball.player ]
}

// first time or new game after a win
sub start {  
  seedRandom( ticks() )

  isWinScreen = false

  player[ leftPlayer ].speed = 0
  player[ leftPlayer ].score = 0
  player[ leftPlayer ].y = paddleYHome
  player[ leftPlayer ].oldY = paddleYHome

  player[ rightPlayer ].speed = 0
  player[ rightPlayer ].score = 0
  player[ rightPlayer ].y = paddleYHome
  player[ rightPlayer ].oldY = paddleYHome

  // an index into player, so 0 serves from the left
  ball.player = randomBelow( len( player ) )

  waitFrame()
  drawBackground( lightGreenW )
  drawPlayfield()
  drawScore( leftPlayer )
  drawScore( rightPlayer )

  serve()

  ball.oldX = ball.x
  ball.oldY = ball.y

  // Drawn whole once, because from here on a frame only draws what moved.
  drawPaddle( leftPlayer )
  drawPaddle( rightPlayer )
  drawBall()
}

// -- run

// Two pairs that must close, and the compiler emits both closes (§48): the mode
// is std/mode.momo's to put back, and the keyboard is t_kbd.momo's to unmask.
videoMode {
  setMode( modeGfx256 )
  initPal()

  keyboard {
    start()

    while( isRunning ) tick()
  }
}
