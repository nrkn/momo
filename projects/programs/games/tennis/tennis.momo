// tennis.momo - *loosely* based on the Fairchild Channel F pong clone "Tennis"

include "lib/std/key.momo"
include "lib/std/math.momo"
include "lib/std/rand.momo"
include "lib/std/time.momo"
include "t_cfg.momo"
include "t_kbd.momo"
include "t_pal.momo"
include "t_scr.momo"
include "t_spr.momo"

// -- state

// game state - otherwise, in play
bool isWinScreen
// back to DOS when false
bool isRunning = true

// paddles - playerCount, leftPlayer and rightPlayer are in t_cfg.momo
group player[playerCount] {
  i16 y      
  i16 oldY   
  u8 score
  u8 speed 
}

// per-player consts
const u8[] paddleX = [ playLeft, playRight ]
const u8[] paddleColor = [ red, blue ]
const u16[] winColor = [ redW, blueW ]
const i16[] serveX = [ 0, ballXMax ]
const i16[] serveSpeedX = [ serveSpeed, -serveSpeed ]

// The ball. One instance, so this is namespacing rather than
// structure-of-arrays - DESIGN 18 - and it is here for the reading: `oldX`
// beside `x` says what it is, where the old name needed a comment to.
group ball {
  i16 x
  i16 y
  i16 oldX
  i16 oldY
  i16 speedX
  i16 speedY
  u8  player
  u8  color
}

// Volleys in the current rally, not a property of the ball.
u8 volleyCount

// -- start

saveMode()
mode13()
initPal()
keyboardBegin()

// -- main

sub drawBackground( u16 color ) {
  u16 dy

  // demos the word blitting we will use extensively later
  for( dy = 0; dy < scoreTopWord; dy++ ){
    pxwords[ dy ] = color
  }

  for( dy = scoreTopWord; dy < screenWord; dy++ ){
    pxwords[ dy ] = blackW
  }
}

// draw once at start
sub drawPlayfield {
  drawLineHorizontal( playTop, playLeft, playRight, green )
  drawLineHorizontal( playBottom, playLeft, playRight, green )
  drawNet()
}

sub drawNet {
  u8 net
  u8 netY

  // we should precompute this, it doesn't change, but this is fine for now
  for( net = 0; net < 5; net++ ){
    netY = playTop + 3 + net * 14

    drawLineVertical( centerX, netY, netY + 8, green )
  }
}

// subgrid to pixels
// playfield offset, eg playRight, playLeft, playTop etc 
// object offset, eg ball.x, ball.y, player[ i ].y etc
// `>> 2` and not `/ 4`: obj is i16, and a signed divide rounds toward zero
// where the shift floors, so these are different answers for a negative offset.
// Signed division deliberately does not strength-reduce - see projects/strred.
const subgridToPx( i16 play, i16 obj ) = play + 1 + (obj >> 2)

// clear at old, draw at new
// note - ~~it flickers quite badly~~ fixed by vsync - on fast hardware at
// least
// but wait until optimised blitting lands and see if we can live with it
// otherwise, we might need better dirty tracking
// eg maybe a buffer of 27 elements to track 9x2 paddle pixels, 9 ball px, and a
// scalar for how many are currently dirty
// or just the movement offset for each so we know exactly how many px to redraw
// from one frame to another
// BUT wait and see how it plays out before prematurely adding this lol
// todo: neither draw/clearPaddles nor draw/clearBall need to call 
// drawLineVertical - they can be unrolled to just 9 direct 
// pixels[n] assignments - oh, but pixel doubling... can do 1 on x with a word
// but still have to double rows!

sub drawPaddle( u8 pi ) {
  i16 subPxY
  i16 subPxY2

  subPxY = subgridToPx( playTop, player[ pi ].y )
  subPxY2 = subPxY + paddleH - 1

  drawLineVertical( paddleX[ pi ], subPxY, subPxY2, paddleColor[ pi ] )
}

sub clearPaddle( u8 pi ) {
  i16 subPxY
  i16 subPxY2

  subPxY = subgridToPx( playTop, player[ pi ].oldY )
  subPxY2 = subPxY + paddleH - 1

  drawLineVertical( paddleX[ pi ], subPxY, subPxY2, lightGreen )
}

// clear at old, draw at new

sub drawBall {  
  i16 subPxX
  i16 subPxY
  i16 subPxY2

  subPxX = subgridToPx( playLeft, ball.x )
  subPxY = subgridToPx( playTop, ball.y )
  subPxY2 = subPxY + ballH - 1

  drawLineVertical( subPxX, subPxY, subPxY2, ball.color )
  drawLineVertical( subPxX + 1, subPxY, subPxY2, ball.color )
  drawLineVertical( subPxX + 2, subPxY, subPxY2, ball.color )
}

sub clearBall {
  i16 subPxX
  i16 subPxY
  i16 subPxY2

  subPxX = subgridToPx( playLeft, ball.oldX )
  subPxY = subgridToPx( playTop, ball.oldY )
  subPxY2 = subPxY + ballH - 1

  drawLineVertical( subPxX, subPxY, subPxY2, lightGreen )
  drawLineVertical( subPxX + 1, subPxY, subPxY2, lightGreen )
  drawLineVertical( subPxX + 2, subPxY, subPxY2, lightGreen )
}

sub drawSprite( u8 index, u8 dx, u8 dy ){
  u16 tile
  u8  i
  u8  j

  tile = index * spriteSize

  for( j = 0; j < spriteH; j++ ){
    for( i = 0; i < spriteW; i++ ){
      setPixel( i + dx, j + dy, textSprites[ tile ] )

      tile++
    }    
  }
}

// overdraws existing, no clear needed
sub drawScore( u8 pi ) {
  u8 digitTens
  u8 digitOnes

  if( player[ pi ].score < 10 ){
    digitTens = 0
    digitOnes = player[ pi ].score
  } else {
    digitTens = 1
    digitOnes = player[ pi ].score - 10
  }

  drawSprite( digitTens, scoreXTens[ pi ], scoreY )
  drawSprite( digitOnes, scoreXOnes[ pi ], scoreY )
}

// The held flags are indexed by player too, so this takes the index alone.
sub movePaddle( u8 pi ) {
  if ( held[ pi ].up || held[ pi ].down ) {
    if ( held[ pi ].up ) player[ pi ].y -= player[ pi ].speed
    if ( held[ pi ].down ) player[ pi ].y += player[ pi ].speed

    if ( player[ pi ].y < 0 ) player[ pi ].y = 0
    if ( player[ pi ].y > paddleYMax ) player[ pi ].y = paddleYMax

    if ( player[ pi ].speed < paddleSpeedMax ) {
      player[ pi ].speed += paddleSpeedStep
    }
  } else {
    player[ pi ].speed = 0
  }
}

// player movements, ESC to exit
sub input {
  pollKeyboard()

  if( wasEsc ){
    isRunning = false

    return
  } 

  if( isWinScreen ){
    if( anyLeftRight() ){
      start()
    }

    return
  }

  movePaddle( leftPlayer )
  movePaddle( rightPlayer )
}

sub setBallSpeedY( i16 yOffset ) {
  if ( yOffset < angleZone1 ) ball.speedY = -ballSpeedY3
  else if ( yOffset < angleZone2 ) ball.speedY = -ballSpeedY2
  else if ( yOffset < angleZone3 ) ball.speedY = -ballSpeedY1
  else if ( yOffset < angleZone4 ) ball.speedY = 0
  else if ( yOffset < angleZone5 ) ball.speedY = ballSpeedY1
  else if ( yOffset < angleZone6 ) ball.speedY = ballSpeedY2
  else ball.speedY = ballSpeedY3
}

// pi scored, so pi serves - unless that was the winning point
sub scorePoint( u8 pi ) {
  player[ pi ].score++

  drawScore( pi )
  
  if ( player[ pi ].score == winScore ) {
    win( pi )
  } else {
    ball.player = pi

    serve()
  }
}

// ball at player pi's column - either bounce or miss (other player scores)
sub hitPaddle( u8 pi ) {
  i16 yOffset

  yOffset = ball.y - player[ pi ].y + hitLead
  
  if ( yOffset < 0 || yOffset >= hitWindow ) {
    scorePoint( 1 - pi )

    return
  }

  ball.x = serveX[ pi ]
  setBallSpeedY( yOffset )

  // three returns before the rally speeds up, to a ceiling
  if ( iabs( ball.speedX ) < ballSpeedXMax ) {
    volleyCount++
  
    if ( volleyCount == volleyTarget ) {
      volleyCount = 0

      if ( ball.speedX > 0 ) ball.speedX += ballSpeedStep
      else ball.speedX -= ballSpeedStep
    }
  }
  
  ball.speedX = -ball.speedX
  ball.player = pi
  ball.color = paddleColor[ pi ]
}

// recalculate state
sub update {
  if( isWinScreen ) return
  
  ball.x += ball.speedX
  ball.y += ball.speedY

  if( ball.y < 0 ){
    ball.y = 0
    ball.speedY = -ball.speedY
  } else if( ball.y > ballYMax ){
    ball.y = ballYMax
    ball.speedY = -ball.speedY
  }
  
  // only the side the ball is travelling toward can be reached
  if( ball.speedX > 0 && ball.x >= ballXMax ){
    hitPaddle( rightPlayer )
  } else if ( ball.speedX < 0 && ball.x <= 0 ){
    hitPaddle( leftPlayer )
  }
}

sub render {
  if( isWinScreen ) return

  // testing if they moved or not is probably cheaper but this keeps tick time
  // consistent
  clearBall()
  clearPaddle( leftPlayer )
  clearPaddle( rightPlayer )

  if ( ball.oldX >= netBallXMin && ball.oldX <= netBallXMax ) drawNet()

  drawBall()
  drawPaddle( leftPlayer )
  drawPaddle( rightPlayer )

  player[ leftPlayer ].oldY = player[ leftPlayer ].y
  player[ rightPlayer ].oldY = player[ rightPlayer ].y

  ball.oldX = ball.x
  ball.oldY = ball.y
}

// with a high typematic rate, the keyboard buffer can get very full, especially
// with numlock fake codes and etc - using the retrace period means a good
// chance to drain it properly
sub waitRetrace {
  while ( inRetrace() ) pollKeyboard()
  while ( !inRetrace() ) pollKeyboard()
}

// mode 13 is 70Hz, so two retraces for 35Hz
sub waitFrame {
  waitRetrace()
  waitRetrace()
}

sub tick {
  input()
  update()
  waitFrame()
  render()
}

// show win screen, wait for input, then call start again
sub win( u8 pi ) {
  isWinScreen = true
  
  waitFrame()
  drawBackground( winColor[ pi ] )
  drawScore( leftPlayer )
  drawScore( rightPlayer )
}

sub serve(){
  ball.speedY = 0
  volleyCount = 0

  ball.x = serveX[ ball.player ]
  ball.y = player[ ball.player ].y + ballServeOffset
  ball.speedX = serveSpeedX[ ball.player ]
  ball.color = paddleColor[ ball.player ]
}

// first time or new game after a win
sub start {  
  seedRandom( ticks() )

  isWinScreen = false

  player[ leftPlayer ].speed = 0
  player[ leftPlayer ].score = 0
  player[ leftPlayer ].y = paddleYHome
  player[ leftPlayer ].oldY = paddleYHome

  player[ rightPlayer ].speed = 0
  player[ rightPlayer ].score = 0
  player[ rightPlayer ].y = paddleYHome
  player[ rightPlayer ].oldY = paddleYHome

  // an index into player, so 0 serves from the left
  ball.player = randomBelow( len( player ) )

  waitFrame()
  drawBackground( lightGreenW )
  drawPlayfield()
  drawScore( leftPlayer )
  drawScore( rightPlayer )

  serve()

  ball.oldX = ball.x
  ball.oldY = ball.y
}

start()

while( isRunning ) tick()

// -- end

keyboardEnd()
restoreMode()
