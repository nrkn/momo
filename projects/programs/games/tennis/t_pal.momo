/*
  doesn't really need optimising as it runs once on startup
*/

// The palette below is authored full-range, so it goes through `dac8` (§43) on
// the way to a DAC that wants six bits. The vector scenes carry six-bit values
// already and call `setDac` directly - the two conventions used to be two
// loaders that disagreed, and are now one interface and a named conversion.
local sub setPaletteColor( u8 index, u8 r, u8 g, u8 b ) {
  setDac( index, dac8( r ), dac8( g ), dac8( b ) )
}

local const palette = [
  224, 224, 244, // lightGrey
  145, 255, 166, // lightGreen
  206, 208, 255, // lightBlue
   16,  16,  16, // black
  255,  49,  83, // red
    2, 204,  93, // green
   75,  63, 243, // blue
  252, 252, 252  // white
]

local const palSize = len(palette) / 3

const lightGrey = 0
const lightGreen = 1
const lightBlue = 2
const black = 3
const red = 4
const green = 5
const blue = 6
const white = 7

// for copying two pixels at once of the same index
const pxDouble( u8 color ) = color | color << 8

const lightGreyW = pxDouble( lightGrey )
const lightGreenW = pxDouble( lightGreen )
const lightBlueW = pxDouble( lightBlue )
const blackW = pxDouble( black )
const redW = pxDouble( red )
const greenW = pxDouble( green )
const blueW = pxDouble( blue )
const whiteW = pxDouble( white )

local u8 i
local u8 pIndex

sub initPal {
  for( i = 0; i < palSize; i++ ){
    pIndex = i * 3

    setPaletteColor( 
      i, palette[ pIndex ], palette[ pIndex + 1 ], palette[ pIndex + 2 ] 
    )
  }
}