include "lib/std/mode.momo"

include "t_cfg.momo"

local const vgaStatus = 0x3da
local const vgaVRetrace = 1 << 3

// predicate rather than a wait, so the caller owns it
bool inRetrace() => ( in8( vgaStatus ) & vgaVRetrace ) != 0

// Mode 13h video memory: 320x200, one byte per pixel, at A000:0000.
//
// **A constant segment, deliberately, even though std/mode.momo knows it.**
// §16 loads ES per access, so a `u16` variable costs ten cycles more than an
// immediate every time - which `tigerpic` would pay 92,949 times - and §16 also
// refuses to hoist a runtime segment, so the constant is the only form §34 can
// ever improve. `screenSegment()` is for a program that does not know its mode
// at compile time, which is the properties query and is not built.
far u8[64000] pixels = 0xA000

// The same memory a word at a time, which is how everything below writes it.
//
// **A logical pixel is two screen pixels wide and two tall, so it is exactly one
// word on each of two screen rows.** Logical (x, y) is word `y * 320 + x`, the
// row under it is `rowWords` further on, and the next logical row is
// `viewRowWords` on from the first. Two stores a pixel rather than four, and ES
// is loaded per store (§16), so halving the stores halves that too.
view u16[32000] pxwords = pixels[0]

local const rowWords = screenW / 2
local const viewRowWords = screenW

local const wordAt( u16 x, u16 y ) = y * viewRowWords + x

sub setPixel( u16 x, u16 y, u8 color ) {
  u16 w
  u16 c

  w = wordAt( x, y )
  c = pxDouble( color )

  pxwords[ w ] = c
  pxwords[ w + rowWords ] = c
}

// `n` logical pixels down from (x, y), in a colour already doubled into a word.
// The row offset is worked out once and stepped, so a run costs one multiply
// however long it is - which is why a row table would buy almost nothing here.
sub fillColumn( u16 x, u16 y, u16 n, u16 c ) {
  u16 w

  w = wordAt( x, y )

  for ( u16 k = 0; k < n; k++ ) {
    pxwords[ w ] = c
    pxwords[ w + rowWords ] = c
    w += viewRowWords
  }
}

// `n` logical pixels across from (x, y).
sub fillRow( u16 x, u16 y, u16 n, u16 c ) {
  u16 w

  w = wordAt( x, y )

  for ( u16 k = 0; k < n; k++ ) {
    pxwords[ w + k ] = c
    pxwords[ w + k + rowWords ] = c
  }
}

sub drawLineHorizontal( u8 y, u8 x1, u8 x2, u8 color ) => fillRow( x1, y, x2 - x1 + 1, pxDouble( color ) )

sub drawLineVertical( u8 x, u8 y1, u8 y2, u8 color ) => fillColumn( x, y1, y2 - y1 + 1, pxDouble( color ) )
