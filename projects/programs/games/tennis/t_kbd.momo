include "t_cfg.momo"

local const picMask = 0x21
local const kbData = 0x60
local const kbStatus = 0x64
local const kbFull = 1
local const irqKbd = 1 << 1

// A set 1 make code, as the 8042 hands it over. The top bit is the break flag,
// which `pollKeyboard` masks off before `applyKey` sees the code - so a code
// written here with it set would name a key that never matches (§75).
unit scancode = u8 < 0x80

local const scancode scEsc = 0x01
local const scancode scW = 0x11
local const scancode scA = 0x1e
local const scancode scS = 0x1f
local const scancode scD = 0x20
local const scancode scUp = 0x48
local const scancode scLeft = 0x4b
local const scancode scRight = 0x4d
local const scancode scDown = 0x50

// Level state - true while the key is down. Indexed by player, so nothing
// downstream has to know that WASD is player 0 and the arrows are player 1.
group held[playerCount] {
  bool up
  bool down
  bool left
  bool right
}

bool isEsc
// sticky, or we can miss a fast tap
bool wasEsc

sub keyboardBegin {
  u8 code

  // stop bios seeing irq1
  out8( picMask, in8( picMask ) | irqKbd )

  // drop stale
  while ( in8( kbStatus ) & kbFull ) {
    code = in8( kbData )
  }
}

local bool anyKeyDown() => (
  isEsc ||
  held[ leftPlayer ].up   || held[ leftPlayer ].down  ||
  held[ leftPlayer ].left || held[ leftPlayer ].right ||
  held[ rightPlayer ].up   || held[ rightPlayer ].down ||
  held[ rightPlayer ].left || held[ rightPlayer ].right
)

// Either player asking to serve. Here rather than at the call site because this
// file owns what the flags mean.
bool anyLeftRight() => (
  held[ leftPlayer ].left  || held[ leftPlayer ].right ||
  held[ rightPlayer ].left || held[ rightPlayer ].right
)

sub keyboardEnd {
  u8 code

  // consume any keys before exiting so we don't eg write ESC back to DOS
  // prompt while quitting
  while ( anyKeyDown() ) {
    pollKeyboard()
  }

  while ( in8( kbStatus ) & kbFull ) {
    code = in8( kbData )
  }

  out8( picMask, in8( picMask ) & ~irqKbd )
}

// The pair as a bracket (§48), declared here because this file owns the two
// routines. A masked IRQ1 left behind is a dead keyboard at the DOS prompt, so
// this is a close that must not be skipped - which the compiler now emits.
//
//   keyboard {
//     ...
//   }
bracket keyboard = keyboardBegin / keyboardEnd

local sub applyKey( scancode key, bool pressed ) {
  if ( key == scW ) held[ leftPlayer ].up = pressed
  else if ( key == scS ) held[ leftPlayer ].down = pressed
  else if ( key == scA ) held[ leftPlayer ].left = pressed
  else if ( key == scD ) held[ leftPlayer ].right = pressed
  else if ( key == scUp ) held[ rightPlayer ].up = pressed
  else if ( key == scDown ) held[ rightPlayer ].down = pressed
  else if ( key == scLeft ) held[ rightPlayer ].left = pressed
  else if ( key == scRight ) held[ rightPlayer ].right = pressed
  else if ( key == scEsc ){
    isEsc = pressed

    if( pressed ) wasEsc = true
  }
}

local sub ioDelay => out8( 0x80, 0 )

sub pollKeyboard {
  u8   status
  u8   code
  bool down

  while ( true ) {
    status = in8( kbStatus )
    ioDelay()

    // byte is waiting
    if ( ( status & kbFull ) == 0 ) break

    code = in8( kbData )
    ioDelay()

    // this ignores: aux (mouse)/transmit timeout on at controllers
    down = code < 0x80

    applyKey( scancode( code & 0x7F ), down )
  }
}