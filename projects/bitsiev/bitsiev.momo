// bitsiev.momo - bit-packed Sieve of Eratosthenes, on the heap.
//
// One bit per candidate, so 1000 numbers cost 125 bytes instead of 1000.

include "lib/std/io.momo"

const limit = 1000
const bytes = 126               // limit / 8, rounded up

u16 i
u16 j
u16 count

bool isComposite(u16 n) {
  return (_heap[n >> 3] & (1 << (n & 7))) != 0
}

sub markComposite(u16 n) {
  _heap[n >> 3] |= u8(1 << (n & 7))
}

sub clearBits {
  for (i = 0; i < bytes; i++) {
    _heap[i] = 0
  }
}

sub runSieve {
  for (i = 2; i * i < limit; i++) {
    if (isComposite(i)) continue

    for (j = i * i; j < limit; j += i) {
      markComposite(j)
    }
  }
}

// ---- entry ----

clearBits()
runSieve()

count = 0
for (i = 2; i < limit; i++) {
  if (isComposite(i)) continue
  count++
}

putNumber(count)                // expect 168 primes below 1000
newline()
