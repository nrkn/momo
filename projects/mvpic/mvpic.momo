// mvpic.momo - GENERATED from scenes/demo.mv. Do not edit.
//
//   npm start mvpic
//
// The picture. Draws the scene into a mode 13h frame, waits for a key, and puts the
// display back.
//
// A demo rather than a test: it cannot have a `.expected` because tier 2 has no way
// to press a key. The geometry is not taken on trust for that - projects/mvdemo
// runs the same data through the same rasteriser and holds its numbers against the
// study. So this picture is made of numbers that have been checked, and only the
// drawing is new here.
//
// The rasteriser cannot tell this program from mvdemo: it asks for `plot` and
// `emitSpan` and nothing else, so one routine decides whether a pixel becomes a byte
// of video memory or a number, and nothing below it learns which. The setup differs -
// mode, palette, framebuffer - and none of that is visible to the library.

// The crossing budget, measured by the study at 120 for the worst single
// path in this scene and rounded up. Declared before the includes because an array
// dimension has to be known where the array is declared, so unlike `plot` and
// `emitSpan` it cannot bind late.
const maxCrossings = 256

include "std/io.momo"
include "std/key.momo"
include "std/math.momo"
include "momovec/types.momo"
include "momovec/edges.momo"
include "momovec/subdiv.momo"
include "momovec/path.momo"
include "momovec/fill.momo"

include "../mvdemo/d_data.momo"

// Mode 13h video memory: 320x200, one byte per pixel, at A000:0000. A `far` region,
// so ES is loaded per access and the tiny model stays intact everywhere else.
far u8[64000] pixels = 0xA000

local u8 savedMode

sub saveMode {
  _ah = 0x0F
  int 0x10
  savedMode = _al & 0x7F
}

sub restoreMode {
  _ah = 0x00
  _al = savedMode
  int 0x10
}

sub mode13 {
  _ax = 0x0013
  int 0x10
}

// The DAC, one entry at a time. The values are already six bits, divided by four by
// the generator.
sub loadPalette {
  u16 i

  for ( i = 0; i < paletteSize; i++ ) {
    _ax = 0x1010
    _bx = i
    _dh = palR[i]
    _ch = palG[i]
    _cl = palB[i]
    int 0x10
  }
}

// The colour the current path is painting in. A global because `plot` is called by
// the library, which has no opinion about colour.
u8 ink

// Unused here and set anyway, so the paint loop is the same text in both programs.
u16 currentPath

sub plot( i16 x, i16 y ) {
  if ( x < 0 ) return
  if ( y < 0 ) return
  if ( x > xMax ) return
  if ( y > yMax ) return

  pixels[ u16( y ) * screenW + u16( x ) ] = ink
}

// Spans arrive already clipped, so this needs no bounds test of its own - which is
// the whole value of clipping at the span rather than the pixel.
sub emitSpan( u16 y, i16 x0, i16 x1 ) {
  i16 x

  for ( x = x0; x <= x1; x++ ) {
    pixels[ y * screenW + u16( x ) ] = ink
  }
}

u16 p
u16 held

saveMode()
mode13()
loadPalette()

for ( p = 0; p < maxPaths; p++ ) {
  currentPath = p

  if ( pathHasFill[p] != 0 ) {
    ink = pathFill[p]
    fillPath( p, true )
  }

  if ( pathHasStroke[p] != 0 ) {
    ink = pathStroke[p]
    strokePath( p )
  }
}

// std/key has readKey, which blocks and returns what was pressed. Nothing here wants
// the value, and discarding it is what a `sub` cannot do.
held = readKey()

restoreMode()
