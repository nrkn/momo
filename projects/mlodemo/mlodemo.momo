// mlodemo.momo - momolo on a text mode screen.
//
// The point of the whole port, and the first thing here that is worth looking at
// rather than reading. It lays `shell` out with the ported engine and draws it
// at 80x25.
//
//   npm start mlodemo
//
// A demo rather than a test: it draws, waits for a key, and puts the display
// back, so it cannot have a .expected - tier 2 cannot run something that blocks.
// The geometry is not taken on trust for that reason. `projects/momolo` builds
// the same scenes from the same file and prints every resolved box as numbers,
// held against the clay-study's own engine; so this picture is made of a tree
// that has been checked element by element, and only the drawing is new here.
//
// What is on screen and what is not:
//
//   the frame, the panels, the borders, the alignment - all engine, all verified
//   the paragraphs      drawn as single lines, clipped at their box. Wrapping is
//                       the reflow seam and it is the last chunk; this is
//                       precisely the picture that shows what it buys.

include "std/key.momo"

include "../momolo/m_scene.momo"

u8 savedMode

// ---- entry ----

// Ask the BIOS what mode we are in so it can be put back on the way out. AH=0Fh
// reports the mode in AL; bit 7 is set when the last mode change suppressed the
// screen clear, so it is masked off.
_ah = 0x0F
int 0x10
savedMode = _al & 0x7F

setTextMode()
hideCursor()
useBrightBackgrounds()

paintBegin( 80 * u, 25 * lineHeight )
buildShell()
closeBox()
runPasses()
paintAll()

readKey()

// Put the display back the way it was found.
_ah = 0x00
_al = savedMode
int 0x10
showCursor()
