// momovec.momo - the cross-check harness for the vector rasteriser.
//
// Runs every scene through the rasteriser and prints the pixels as bare numbers,
// one per line:
//
//   x y
//
// momovec.expected holds the same numbers generated by the TypeScript study in
// ../20260826-vector-study, from the same scenes:
//
//   npm run reference -- --stage=pixels --scene=triangle
//
// concatenated in the order m_scene.momo lists them. Both files are generated by
// `npm run emit` on that side, and the expectation is written BEFORE this program
// is run - so a match is evidence rather than a tautology.
//
// Two independent implementations of one algorithm agreeing on every integer is
// the point of the exercise, and this project is the whole of that claim.
//
// Every stage the port has reached is printed, in order, and the expectation covers
// all of them - so an earlier chunk keeps its regression coverage as later ones
// land rather than being replaced by them. The stages have different shapes, which
// makes the boundary self-evident in a diff: `pixels` is two columns and `edges` is
// three.
//
//   pixels   x y          every scene, outlines, subpaths NOT closed
//   edges    y x dir      every scene, crossings as emitted, subpaths closed
//   sorted   y x dir      the same crossings, after the sort
//   spans    y x0 x1      the nonzero walk, raw
//   fill     x y          every pixel the tidied spans cover
//   both     interleaved  one walk per path: its pixels, then its spans

// The crossing budget, sized by the study against this dataset. Must precede the
// momovec includes: an array dimension is needed where the array is declared, so
// unlike `plot` and `emitSpan` this cannot bind late.
//
// 1,024 against a measured worst single path of 232 over the eight ladder rungs.
const maxCrossings = 1024

include "std/io.momo"
include "std/math.momo"
include "momovec/types.momo"
include "momovec/edges.momo"
include "momovec/path.momo"
include "momovec/fill.momo"
include "m_scene.momo"

// Every path of one scene, in order.
//
// A scene is this harness's idea, not the rasteriser's. It lived in
// lib/momovec/path.momo until projects/tiger needed the library without one and
// could not compile - the resolver wants every name to exist whether or not the
// code is reachable, so a library referring to `scenePathCount` is a library that
// only works for programs which happen to have scenes. The rasteriser knows about
// paths; what groups them is the caller's business.
sub strokeScene( u16 sceneIndex ) {
  u16 q

  for ( q = 0; q < scenePathCount[ sceneIndex ]; q++ ) {
    strokePath( sceneFirstPath[ sceneIndex ] + q )
  }
}

// The plot target. The library calls this by name and never sees what it does -
// the demo defines one that writes VRAM instead, from the same rasteriser.
//
// Printed as u16 so a negative coordinate comes out as its two's complement,
// which is what the study's reference emits for the same reason: exactness beats
// readability in a file that exists to be compared.
sub plot( i16 x, i16 y ) {
  putNumber( u16( x ) )
  space()
  putNumber( u16( y ) )
  newline()
}

u16 s
u16 p
u16 i

// ---- the pixels stage ----

for ( s = 0; s < len( sceneFirstPath ); s++ ) {
  strokeScene( s )
}

// ---- the edges stage ----
//
// Printed as emitted, before any sort. Comparing after the sort would let a wrong
// emission order hide behind a correct sort, and the sort is chunk 4.
//
// Direction is printed as u16, so -1 comes out as 65535 - which is what the study
// emits, for the same reason: exactness beats readability in a file that exists to
// be compared.

for ( s = 0; s < len( sceneFirstPath ); s++ ) {
  for ( p = 0; p < scenePathCount[ s ]; p++ ) {
    pathEdges( sceneFirstPath[ s ] + p )

    for ( i = 0; i < crossingCount; i++ ) {
      putNumber( cy[ i ] )
      space()
      putNumber( u16( cx[ i ] ) )
      space()
      putNumber( u16( cdir[ i ] ) )
      newline()
    }
  }
}

// ---- the sorted stage ----
//
// The same crossings again, after the counting sort and the insertion pass. Both
// forms are printed because they fail differently: `edges` catches a wrong
// emission, `sorted` catches a wrong ordering, and a sort that quietly dropped a
// crossing would pass one and fail the other.

for ( s = 0; s < len( sceneFirstPath ); s++ ) {
  for ( p = 0; p < scenePathCount[ s ]; p++ ) {
    pathEdgesSorted( sceneFirstPath[ s ] + p )

    for ( i = 0; i < crossingCount; i++ ) {
      putNumber( cy[ i ] )
      space()
      putNumber( u16( cx[ i ] ) )
      space()
      putNumber( u16( cdir[ i ] ) )
      newline()
    }
  }
}

// ---- the spans and fill stages ----
//
// `emitSpan` is the library's one hook for a span, and what it does with one is
// this program's business - the same arrangement as `plot`. A demo would fill;
// this prints, or fills, according to the mode.
//
// A mode global rather than two hooks, because the library must not know there are
// two stages.

const modeSpans = 0
const modeFill = 1

u8 spanMode

sub emitSpan( u16 y, i16 x0, i16 x1 ) {
  i16 x

  if ( spanMode == modeSpans ) {
    putNumber( y )
    space()
    putNumber( u16( x0 ) )
    space()
    putNumber( u16( x1 ) )
    newline()

    return
  }

  for ( x = x0; x <= x1; x++ ) {
    plot( x, i16( y ) )
  }
}

// Raw spans, straight from the walk.
spanMode = modeSpans

for ( s = 0; s < len( sceneFirstPath ); s++ ) {
  for ( p = 0; p < scenePathCount[ s ]; p++ ) {
    fillPath( sceneFirstPath[ s ] + p, false )
  }
}

// Every pixel the tidied spans cover. Tidied rather than raw, so the pixel set has
// no duplicates whichever form a caller walked - the study asserts the two agree on
// every pixel, which is what makes either contract usable.
spanMode = modeFill

for ( s = 0; s < len( sceneFirstPath ); s++ ) {
  for ( p = 0; p < scenePathCount[ s ]; p++ ) {
    fillPath( sceneFirstPath[ s ] + p, true )
  }
}

// ---- the combined stage ----
//
// One walk per path, emitting its boundary pixels and then its spans. The
// INTERLEAVING is the point: pixels come out during the walk and spans only after
// the sort, so this order is something two separate passes could not produce. It is
// the order itself that says one walk did both.
//
// Raw spans rather than tidied, matching the `spans` stage, so the only difference
// from those two stages is where the numbers came from.
spanMode = modeSpans

for ( s = 0; s < len( sceneFirstPath ); s++ ) {
  for ( p = 0; p < scenePathCount[ s ]; p++ ) {
    strokeAndFillPath( sceneFirstPath[ s ] + p, false )
  }
}

// A capacity problem must not look like a rasteriser bug, so it says so. The
// expectation never has this line, which makes an overflow a one-line diff.
if ( crossingsOverflowed ) {
  putStr( addr( overflowed ) )
  newline()
}

const u8[] overflowed = "CROSSING LIST OVERFLOWED$"
