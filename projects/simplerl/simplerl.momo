// simplerl.momo - the minimal version: an '@' moving around a hard-coded map.
//
// Deliberately left at this size. Anything further - mobs, items, generated
// levels - belongs in its own project rather than here, so this stays readable
// as the smallest thing that is recognisably a roguelike.
// ---
// Minimal roguelike skeleton - an '@' moving around a hard coded map

include "std/io.momo"
include "std/screen.momo"
include "std/key.momo"
include "std/rand.momo"
include "std/math.momo"

// const

const map = "########    ########"
            "##....########....##"
            "##................##"
            "####............####"
            "  ##............##  "
            "  ##............##  "
            "####............####"
            "##................##"
            "##....########....##"
            "########    ########"

const mapW = 20
const mapH = len( map ) / mapW

const tileAt( u8 x, u8 y ) = map[ y * mapW + x ]

const defAttr = color( lightGray, black )
const playerAttr = color( yellow, black )

const solidBlock = 219

// state

u8 playerX = 9
u8 playerY = 4

// start

sub cls => clearScreen( defAttr )

setTextMode()
hideCursor()

// tick

u8 y
u8 x
u8 oldPx
u8 oldPy
u8 ch
u16 lastKey

bool isMove( u8 key ) => lo( lastKey ) == 0 && hi( lastKey ) == key

sub draw {
  for( y = 0; y < mapH; y++ ){
    for( x = 0; x < mapW; x++ ){
      ch = tileAt( x, y )
      
      if( ch == '#') ch = solidBlock

      writeAt( x, y, ch, defAttr )
    }
  }
}

draw()
writeAt( playerX, playerY, '@', playerAttr )

while( true ){
  lastKey = readKey()

  if( lo( lastKey ) == keyEsc ) break  
  
  oldPx = playerX
  oldPy = playerY

  if( isMove( keyUp ) && playerY > 0 ){
    playerY--
  } else if( isMove( keyDown ) && playerY < mapH - 1 ){
    playerY++
  } else if( isMove( keyLeft ) && playerX > 0 ){
    playerX--
  } else if( isMove( keyRight ) && playerX < mapW - 1 ){
    playerX++
  }

  if( tileAt( playerX, playerY ) == '#'){
    playerX = oldPx
    playerY = oldPy
  } else {
    writeAt( oldPx, oldPy, tileAt( oldPx, oldPy ), defAttr )
    writeAt( playerX, playerY, '@', playerAttr )
  }
}

// end

moveTo( 0, 0 )
showCursor()
cls()
