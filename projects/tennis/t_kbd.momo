local const picMask = 0x21
local const kbData = 0x60
local const kbStatus = 0x64
local const kbFull = 1
local const kbAux = 1 << 5
local const irqKbd = 1 << 1

local const scEsc = 0x01
local const scW = 0x11
local const scA = 0x1e
local const scS = 0x1f
local const scD = 0x20
local const scUp = 0x48
local const scLeft = 0x4b
local const scRight = 0x4d
local const scDown = 0x50

bool isUp1
bool isDown1
bool isLeft1
bool isRight1
bool isUp2
bool isDown2
bool isLeft2
bool isRight2
bool isEsc
// sticky, or we can miss a fast tap
bool wasEsc

local u8 code

sub keyboardBegin {
  // stop bios seeing irq1
  out8( picMask, in8( picMask ) | irqKbd )       
  
  // drop stale
  while ( in8( kbStatus ) & kbFull ) { 
    code = in8( kbData ) 
  }   
}

local bool anyKeyDown() => (
  isEsc ||  
  isUp1 || isDown1 || isLeft1 || isRight1 ||
  isUp2 || isDown2 || isLeft2 || isRight2 
)

sub keyboardEnd {
  // consume any keys before exiting so we don't eg write ESC back to DOS
  // prompt while quitting
  while ( anyKeyDown() ) {
    pollKeyboard()
  }

  while ( in8( kbStatus ) & kbFull ) { 
    code = in8( kbData ) 
  }
  
  out8( picMask, in8( picMask ) & ~irqKbd )
}

local sub applyKey( u8 key, bool pressed ) {
  if ( key == scW ) isUp1 = pressed
  else if ( key == scS ) isDown1 = pressed
  else if ( key == scA ) isLeft1 = pressed
  else if ( key == scD ) isRight1 = pressed
  else if ( key == scUp ) isUp2 = pressed
  else if ( key == scDown ) isDown2 = pressed
  else if ( key == scLeft ) isLeft2 = pressed
  else if ( key == scRight ) isRight2 = pressed
  else if ( key == scEsc ){ 
    isEsc = pressed

    if( pressed ) wasEsc = true
  }
}

local u8 status
local bool down

sub pollKeyboard {
  while ( true ) {
    status = in8( kbStatus )
    
    // byte is waiting
    if ( ( status & kbFull ) == 0 ) break
    code = in8( kbData )

    // if bit 5, it's mouse, not kbd
    if ( ( status & kbAux ) == 0 ) {
      down = code < 0x80
      applyKey( code & 0x7F, down )
    }
  }
}