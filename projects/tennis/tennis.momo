// tennis.momo - *loosely* based on the Fairchild Channel F pong clone "Tennis"

include "std/key.momo"
include "std/math.momo"
include "std/rand.momo"
include "std/time.momo"
include "t_cfg.momo"
include "t_kbd.momo"
include "t_pal.momo"
include "t_scr.momo"
include "t_spr.momo"

// -- state

// game state - otherwise, in play
bool isWinScreen
// back to DOS when false
bool isRunning = true

// paddles - player 0 is on the left, player 1 on the right
const playerCount = 2

const leftPlayer = 0
const rightPlayer = 1

group player[playerCount] {
  i16 y      
  i16 oldY   
  u8 score
  u8 speed 
}

// per-player consts
const u8[] paddleX = [ playLeft, playRight ]
const u8[] paddleColor = [ red, blue ]
const u16[] winColor = [ redW, blueW ]
const i16[] serveX = [ 0, ballXMax ]
const i16[] serveSpeedX = [ serveSpeed, -serveSpeed ]

// ball
i16 ballX
i16 ballY
i16 oBallX // old ball x
i16 oBallY // old ball y

i16 ballSpeedX
i16 ballSpeedY

u8 ballPlayer
u8 ballColor 
u8 volleyCount

// -- start

saveMode()
mode13()
initPal()
keyboardBegin()

// -- main

u16 dy

sub drawBackground( u16 color ) {
  // demos the word blitting we will use extensively later
  for( dy = 0; dy < scoreTopWord; dy++ ){
    pxwords[ dy ] = color
  }
  
  for( dy = scoreTopWord; dy < screenWord; dy++ ){
    pxwords[ dy ] = blackW
  }
}

u8 net
u8 netY

// draw once at start
sub drawPlayfield {
  drawLineHorizontal( playTop, playLeft, playRight, green )
  drawLineHorizontal( playBottom, playLeft, playRight, green )
  drawNet()
}

sub drawNet {
  // we should precompute this, it doesn't change, but this is fine for now
  for( net = 0; net < 5; net++ ){
    netY = playTop + 3 + net * 14

    drawLineVertical( centerX, netY, netY + 8, green )
  }
}

// subgrid to pixels
// playfield offset, eg playRight, playLeft, playTop etc 
// object offset, eg ballX, ballY, player[ i ].y etc
const subgridToPx( i16 play, i16 obj ) = play + 1 + (obj >> 2)

i16 subPxX
i16 subPxY
i16 subPxY2

// clear at old, draw at new
// note - ~~it flickers quite badly~~ fixed by vsync - on fast hardware at 
// least
// but wait until optimised blitting lands and see if we can live with it
// otherwise, we might need better dirty tracking
// eg maybe a buffer of 27 elements to track 9x2 paddle pixels, 9 ball px, and a
// scalar for how many are currently dirty
// or just the movement offset for each so we know exactly how many px to redraw
// from one frame to another
// BUT wait and see how it plays out before prematurely adding this lol
// todo: neither draw/clearPaddles nor draw/clearBall need to call 
// drawLineVertical - they can be unrolled to just 9 direct 
// pixels[n] assignments - oh, but pixel doubling... can do 1 on x with a word
// but still have to double rows!

sub drawPaddle( u8 pi ) {
  subPxY = subgridToPx( playTop, player[ pi ].y )
  subPxY2 = subPxY + paddleH - 1

  drawLineVertical( paddleX[ pi ], subPxY, subPxY2, paddleColor[ pi ] )
}

sub clearPaddle( u8 pi ) {
  subPxY = subgridToPx( playTop, player[ pi ].oldY )
  subPxY2 = subPxY + paddleH - 1

  drawLineVertical( paddleX[ pi ], subPxY, subPxY2, lightGreen )
}

// clear at old, draw at new

sub drawBall {  
  subPxX = subgridToPx( playLeft, ballX )
  subPxY = subgridToPx( playTop, ballY )
  subPxY2 = subPxY + ballH - 1

  drawLineVertical( subPxX, subPxY, subPxY2, ballColor )
  drawLineVertical( subPxX + 1, subPxY, subPxY2, ballColor )
  drawLineVertical( subPxX + 2, subPxY, subPxY2, ballColor )
}

sub clearBall {
  subPxX = subgridToPx( playLeft, oBallX )
  subPxY = subgridToPx( playTop, oBallY )
  subPxY2 = subPxY + ballH - 1

  drawLineVertical( subPxX, subPxY, subPxY2, lightGreen )
  drawLineVertical( subPxX + 1, subPxY, subPxY2, lightGreen )
  drawLineVertical( subPxX + 2, subPxY, subPxY2, lightGreen )
}

u16 tile
u8 i
u8 j
sub drawSprite( u8 index, u8 dx, u8 dy ){
  tile = index * spriteSize
  
  for( j = 0; j < spriteH; j++ ){
    for( i = 0; i < spriteW; i++ ){
      setPixel( i + dx, j + dy, textSprites[ tile ] )

      tile++
    }    
  }
}

// overdraws existing, no clear needed
u8 digitTens
u8 digitOnes
sub drawScore( u8 pi ) {
  if( player[ pi ].score < 10 ){
    digitTens = 0
    digitOnes = player[ pi ].score
  } else {
    digitTens = 1
    digitOnes = player[ pi ].score - 10
  }

  drawSprite( digitTens, scoreXTens[ pi ], scoreY )
  drawSprite( digitOnes, scoreXOnes[ pi ], scoreY )
}

sub movePaddle( u8 pi, bool up, bool down ) {
  if ( up || down ) {
    if ( up ) player[ pi ].y -= player[ pi ].speed
    if ( down ) player[ pi ].y += player[ pi ].speed

    if ( player[ pi ].y < 0 ) player[ pi ].y = 0
    if ( player[ pi ].y > paddleYMax ) player[ pi ].y = paddleYMax

    if ( player[ pi ].speed < paddleSpeedMax ) {
      player[ pi ].speed += paddleSpeedStep
    }
  } else {
    player[ pi ].speed = 0
  }
}

// player movements, ESC to exit
sub input {
  pollKeyboard()

  if( wasEsc ){
    isRunning = false

    return
  } 

  if( isWinScreen ){
    if( isLeft1 || isLeft2 || isRight1 || isRight2 ){
      start()
    }

    return
  }


  movePaddle( 0, isUp1, isDown1 )
  movePaddle( 1, isUp2, isDown2 )
}

sub setBallSpeedY( i16 yOffset ) {
  if ( yOffset < angleZone1 ) ballSpeedY = -ballSpeedY3
  else if ( yOffset < angleZone2 ) ballSpeedY = -ballSpeedY2
  else if ( yOffset < angleZone3 ) ballSpeedY = -ballSpeedY1
  else if ( yOffset < angleZone4 ) ballSpeedY = 0
  else if ( yOffset < angleZone5 ) ballSpeedY = ballSpeedY1
  else if ( yOffset < angleZone6 ) ballSpeedY = ballSpeedY2
  else ballSpeedY = ballSpeedY3
}

// pi scored, so pi serves - unless that was the winning point
sub scorePoint( u8 pi ) {
  player[ pi ].score++

  drawScore( pi )
  
  if ( player[ pi ].score == winScore ) {
    win( pi )
  } else {
    ballPlayer = pi

    serve()
  }
}

// ball at player pi's column - either bounce or miss (other player scores)
sub hitPaddle( u8 pi ) {
  i16 yOffset

  yOffset = ballY - player[ pi ].y + hitLead
  
  if ( yOffset < 0 || yOffset >= hitWindow ) {
    scorePoint( 1 - pi )

    return
  }

  ballX = serveX[ pi ]
  setBallSpeedY( yOffset )

  // three returns before the rally speeds up, to a ceiling
  if ( iabs( ballSpeedX ) < ballSpeedXMax ) {
    volleyCount++
  
    if ( volleyCount == volleyTarget ) {
      volleyCount = 0

      if ( ballSpeedX > 0 ) ballSpeedX += ballSpeedStep
      else ballSpeedX -= ballSpeedStep
    }
  }
  
  ballSpeedX = -ballSpeedX
  ballPlayer = pi
  ballColor = paddleColor[ pi ]
}

// recalculate state
sub update {
  if( isWinScreen ) return
  
  ballX += ballSpeedX
  ballY += ballSpeedY

  if( ballY < 0 ){
    ballY = 0
    ballSpeedY = -ballSpeedY
  } else if( ballY > ballYMax ){
    ballY = ballYMax
    ballSpeedY = -ballSpeedY
  }
  
  // only the side the ball is travelling toward can be reached
  if( ballSpeedX > 0 && ballX >= ballXMax ){
    hitPaddle( rightPlayer )
  } else if ( ballSpeedX < 0 && ballX <= 0 ){
    hitPaddle( leftPlayer )
  }
}

sub render {
  if( isWinScreen ) return

  // testing if they moved or not is probably cheaper but this keeps tick time
  // consistent
  clearBall()
  clearPaddle( leftPlayer )
  clearPaddle( rightPlayer )

  if ( oBallX >= netBallXMin && oBallX <= netBallXMax ) drawNet()

  drawBall()
  drawPaddle( leftPlayer )
  drawPaddle( rightPlayer )

  player[ leftPlayer ].oldY = player[ leftPlayer ].y
  player[ rightPlayer ].oldY = player[ rightPlayer ].y

  oBallX = ballX
  oBallY = ballY
}

// timer based tick
sub tick {  
  input()
  update()
  waitFrame()
  render()
}

// show win screen, wait for input, then call start again
sub win( u8 pi ) {
  isWinScreen = true
  
  waitFrame()
  drawBackground( winColor[ pi ] )
  drawScore( leftPlayer )
  drawScore( rightPlayer )
}

sub serve(){
  ballSpeedY = 0
  volleyCount = 0

  ballX = serveX[ ballPlayer ]
  ballY = player[ ballPlayer ].y + ballServeOffset
  ballSpeedX = serveSpeedX[ ballPlayer ]
  ballColor = paddleColor[ ballPlayer ]
}

// first time or new game after a win
sub start {  
  seedRandom( ticks() )

  isWinScreen = false

  player[ leftPlayer ].speed = 0
  player[ leftPlayer ].score = 0
  player[ leftPlayer ].y = paddleYHome
  player[ leftPlayer ].oldY = paddleYHome

  player[ rightPlayer ].speed = 0
  player[ rightPlayer ].score = 0
  player[ rightPlayer ].y = paddleYHome
  player[ rightPlayer ].oldY = paddleYHome

  // an index into player, so 0 serves from the left
  ballPlayer = randomBelow( len( player ) )

  waitFrame()
  drawBackground( lightGreenW )
  drawPlayfield()
  drawScore( leftPlayer )
  drawScore( rightPlayer )

  serve()

  oBallX = ballX
  oBallY = ballY
}

start()

while( isRunning ) tick()

// -- end

keyboardEnd()
restoreMode()
