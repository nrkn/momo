// qsort.momo - quicksort with an explicit stack on the heap.
//
// Momo bans recursion, because locals are statically allocated. That costs
// nothing: a recursive algorithm just carries its own stack.
//
// Two views name the two regions rather than spelling the arithmetic at every
// access: the values, and the pending (lo, hi) ranges above them. That is what
// `view` is for (DESIGN 17), and it also gets the indices bounds-checked, which
// raw `_heapw` never is.
//
// The generator is std/rand rather than one written here. A local copy used to
// live in this file, and it was the power-of-two-modulus LCG that std/rand
// deliberately replaced - so the fixture was carrying the version the library
// rejected, and reading it would have taught the wrong thing.

include "lib/std/io.momo"
include "lib/std/rand.momo"

const count = 20                // values to sort

// Each pop pushes at most two ranges, and only one side of a partition can be
// large - so `count` pairs is a ceiling this cannot reach.
const maxRanges = count * 2     // in words

view u16[count]     values = _heap[0]
view u16[maxRanges] ranges = _heap[count * 2]

u16 sp                          // stack depth, in words
u16 lo
u16 hi
u16 i
u16 j
u16 pivot
u16 tmp
u16 pivotAt
u16 fromLo
u16 fromHi

sub pushRange {
  ranges[sp] = lo
  ranges[sp + 1] = hi
  sp += 2
}

sub popRange {
  sp -= 2
  lo = ranges[sp]
  hi = ranges[sp + 1]
}

sub fill {
  for (i = 0; i < count; i++) {
    values[i] = randomBelow(100)
  }
}

sub show {
  for (i = 0; i < count; i++) {
    putNumber(values[i])
    putChar(' ')
  }
  newline()
}

sub quicksort {
  sp = 0
  lo = 0
  hi = count - 1
  pushRange()

  while (sp > 0) {
    popRange()
    fromLo = lo
    fromHi = hi

    // Lomuto partition around the last element.
    pivot = values[fromHi]
    i = fromLo

    for (j = fromLo; j < fromHi; j++) {
      if (values[j] < pivot) {
        tmp = values[i]
        values[i] = values[j]
        values[j] = tmp
        i++
      }
    }

    tmp = values[i]
    values[i] = values[fromHi]
    values[fromHi] = tmp
    pivotAt = i

    // Guarded so an empty side never underflows: these are u16.
    if (pivotAt > fromLo) {
      lo = fromLo
      hi = pivotAt - 1
      pushRange()
    }

    if (pivotAt < fromHi) {
      lo = pivotAt + 1
      hi = fromHi
      pushRange()
    }
  }
}

// ---- entry ----

seedRandom(7)
fill()
show()
quicksort()
show()

// Verify: report the number of out-of-order pairs.
tmp = 0
for (i = 1; i < count; i++) {
  if (values[i - 1] > values[i]) tmp++
}
putNumber(tmp)
newline()
