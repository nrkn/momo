// Bresenham's line.
//
// The one primitive that needs no range audit to be trusted: dx, dy and err are
// all bounded by the coordinate range, so at 320x200 nothing here leaves the low
// hundreds. The study measured it anyway and the worst value over the four
// full-screen diagonals is 558, which is two orders of magnitude inside a signed
// word.
//
// Straight from Zingl, unchanged apart from the two things Momo requires: no
// `|0` coercions, because integers are the only thing there is, and `plot` rather
// than a callback parameter.

include "std/math.momo"

sub drawLine( i16 x0, i16 y0, i16 x1, i16 y1 ) {
  i16 dx
  i16 dy
  i16 sx
  i16 sy
  i16 err
  i16 e2

  dx = iabs( x1 - x0 )
  dy = -iabs( y1 - y0 )

  sx = x0 < x1 ? 1 : -1
  sy = y0 < y1 ? 1 : -1

  err = dx + dy

  for ( ;; ) {
    plot( x0, y0 )

    e2 = 2 * err

    // Both tests can fire in one iteration, which is the diagonal step, and both
    // can end the loop - which is why each carries its own break rather than the
    // loop having a condition.
    if ( e2 >= dy ) {
      if ( x0 == x1 ) break

      err += dy
      x0 += sx
    }

    if ( e2 <= dx ) {
      if ( y0 == y1 ) break

      err += dx
      y0 += sy
    }
  }
}
