// Walking a path's ops.
//
// One running index over the points, advanced by however many the op consumes -
// 1 for a move, 1 for a line, 2 for a quadratic. Nothing nests, so nothing needs
// a stack: a path is a run of ops and a run of points, and the two are walked
// together.
//
// `strokePath` does NOT close a subpath. A stroke draws what the path says and no
// more; the closing segment a fill needs is the fill's business, and it arrives
// with the fill.
//
// The arrays this reads - opKind, px, py, pathOpStart, pathOpCount,
// pathPointStart - are defined by the PROGRAM, not here. See types.momo.

include "momovec/quad.momo"

sub strokePath( u16 pathIndex ) {
  u16 k
  u16 at
  u16 op
  i16 curX
  i16 curY
  i16 toX
  i16 toY
  i16 ctlX
  i16 ctlY

  at = pathPointStart[ pathIndex ]

  // A path that does not begin with a move has no current point, and every path
  // the study emits begins with one. Starting at the origin rather than guarding
  // would draw a line from nowhere, so this stays as it is and the invariant lives
  // on the study side, where it is generated rather than hoped for.
  curX = 0
  curY = 0

  for ( k = 0; k < pathOpCount[ pathIndex ]; k++ ) {
    op = opKind[ pathOpStart[ pathIndex ] + k ]

    if ( op == opMove ) {
      curX = px[ at ]
      curY = py[ at ]
      at += 1
    } else if ( op == opLine ) {
      toX = px[ at ]
      toY = py[ at ]
      at += 1

      drawLine( curX, curY, toX, toY )

      curX = toX
      curY = toY
    } else {
      // A quadratic: control point then end point.
      ctlX = px[ at ]
      ctlY = py[ at ]
      toX = px[ at + 1 ]
      toY = py[ at + 1 ]
      at += 2

      // A control point that rounded onto an endpoint leaves no curvature, and
      // drawQuad would have to divide by it to find that out - so the caller
      // decides, exactly as the study's own walk does. This is not an
      // optimisation: `cur` would be zero and the routine would fall through to
      // its own drawLine anyway, but only after computing a page of products
      // from it.
      if ( ctlX == curX && ctlY == curY ) {
        drawLine( curX, curY, toX, toY )
      } else if ( ctlX == toX && ctlY == toY ) {
        drawLine( curX, curY, toX, toY )
      } else {
        drawQuad( curX, curY, ctlX, ctlY, toX, toY )
      }

      curX = toX
      curY = toY
    }
  }
}

// Every path of one scene, in order.
sub strokeScene( u16 sceneIndex ) {
  u16 p

  for ( p = 0; p < scenePathCount[ sceneIndex ]; p++ ) {
    strokePath( sceneFirstPath[ sceneIndex ] + p )
  }
}
