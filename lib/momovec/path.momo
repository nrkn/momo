// Walking a path's ops.
//
// One running index over the points, advanced by however many the op consumes -
// 1 for a move, 1 for a line, 2 for a quadratic. Nothing nests, so nothing needs
// a stack: a path is a run of ops and a run of points, and the two are walked
// together.
//
// **A fill closes every subpath and a stroke closes none.** The representation does
// not record which are closed, and does not need to: normalization turns SVG's `Z`
// into an explicit line back to the subpath start, so a closed subpath is one whose
// last point equals its first, and closing one that already is is a no-op. A stroke
// draws what the path says and no more.
//
// The arrays this reads - opKind, px, py, pathOpStart, pathOpCount,
// pathPointStart - are defined by the PROGRAM, not here. See types.momo.

include "momovec/subdiv.momo"

sub walkPath(
  u16 pathIndex, bool wantPixels, bool wantEdges, bool closeSubpaths
) {
  u16 k
  u16 at
  u16 op
  i16 curX
  i16 curY
  i16 toX
  i16 toY
  i16 ctlX
  i16 ctlY
  i16 startX
  i16 startY
  bool inSubpath

  at = pathPointStart[ pathIndex ]
  inSubpath = false
  startX = 0
  startY = 0

  // A path that does not begin with a move has no current point, and every path
  // the study emits begins with one. Starting at the origin rather than guarding
  // would draw a line from nowhere, so this stays as it is and the invariant lives
  // on the study side, where it is generated rather than hoped for.
  curX = 0
  curY = 0

  for ( k = 0; k < pathOpCount[ pathIndex ]; k++ ) {
    op = opKind[ pathOpStart[ pathIndex ] + k ]

    if ( op == opMove ) {
      // A move ends the previous subpath, so anything a fill needs closing gets
      // closed here rather than only at the end of the path.
      if ( closeSubpaths && inSubpath ) {
        if ( curX != startX || curY != startY ) {
          drawLine( curX, curY, startX, startY, wantPixels, wantEdges, 0 )
        }
      }

      curX = px[ at ]
      curY = py[ at ]
      at += 1

      startX = curX
      startY = curY
      inSubpath = true
    } else if ( op == opLine ) {
      toX = px[ at ]
      toY = py[ at ]
      at += 1

      drawLine( curX, curY, toX, toY, wantPixels, wantEdges, 0 )

      curX = toX
      curY = toY
    } else {
      // A quadratic: control point then end point.
      ctlX = px[ at ]
      ctlY = py[ at ]
      toX = px[ at + 1 ]
      toY = py[ at + 1 ]
      at += 2

      // `drawQuadAny` rather than `drawQuad`, so a caller can hand this an arbitrary
      // quadratic and not a pre-subdivided one. Anything already inside the audited
      // span and already monotonic passes straight through after two tests, so the
      // generated datasets pay almost nothing for it.
      //
      // The degenerate check that used to sit here - a control point rounded onto an
      // endpoint, which leaves no curvature for `drawQuad` to divide by - moved into
      // `drawQuadAny`, because subdivision can *create* that case and a guard only on
      // this path would have missed it.
      drawQuadAny( curX, curY, ctlX, ctlY, toX, toY, wantPixels, wantEdges )

      curX = toX
      curY = toY
    }
  }

  // The last subpath, which no move follows.
  if ( closeSubpaths && inSubpath ) {
    if ( curX != startX || curY != startY ) {
      drawLine( curX, curY, startX, startY, wantPixels, wantEdges, 0 )
    }
  }
}

// Pixels only, nothing closed - the `pixels` stage.
sub strokePath( u16 pathIndex ) {
  walkPath( pathIndex, true, false, false )
}

// Crossings only, every subpath closed - the `edges` stage. The list is cleared
// first, because winding belongs to one path.
sub pathEdges( u16 pathIndex ) {
  clearCrossings()
  walkPath( pathIndex, false, true, true )
}

// The same, sorted - the `sorted` stage.
sub pathEdgesSorted( u16 pathIndex ) {
  pathEdges( pathIndex )
  sortCrossings()
}

